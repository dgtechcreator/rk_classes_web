@model SchoolMS.Web.ViewModels.ExpenseListVM
@{
    ViewData["Title"] = "Expenses";
}

<div class="pg-hdr">
    <div class="pg-row">
        <div><h1>🧾 Expenses</h1><p>@Model.Total expense records</p></div>
        <a href="/Expenses/Create" class="btn btn-primary"><i class="fas fa-plus"></i> Record Expense</a>
    </div>
</div>

<form method="get" action="/Expenses/Index">
    <div class="filter-bar">
        <i class="fas fa-filter" style="color:var(--mu);font-size:13px;"></i>
        <input type="text" name="search" value="@Model.Search" class="fc" placeholder="Search title, vendor..." style="min-width:180px;" />
        <select name="category" class="fs">
            <option value="">All Categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryId" selected="@(Model.CategoryFilter == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
        <select name="month" class="fs">
            <option value="">All Months</option>
            @for (int m = 1; m <= 12; m++)
            {
                var mn = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
                <option value="@m" selected="@(Model.MonthFilter == m)">@mn</option>
            }
        </select>
        <select name="year" class="fs">
            <option value="">All Years</option>
            @foreach (var y in Model.Years)
            {
                var startYr = y.YearName?.Length >= 4 ? y.YearName[..4] : "";
                <option value="@startYr" selected="@(Model.YearFilter != null && Model.YearFilter.ToString() == startYr)">@y.YearName @(y.IsCurrent ? "(Current)" : "")</option>
            }
        </select>
        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Filter</button>
        <a href="/Expenses/Index" class="btn btn-outline btn-sm"><i class="fas fa-times"></i></a>
    </div>
</form>

@if (Model.Expenses.Any())
{
    var totalAmt = Model.Expenses.Sum(e => e.Amount);
    <div style="display:flex;gap:12px;margin-bottom:16px;">
        <div class="card" style="flex:1;padding:14px 18px;">
            <div style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Showing Total</div>
            <div style="font-size:22px;font-weight:800;color:var(--err);">₹@totalAmt.ToString("N0")</div>
        </div>
        <div class="card" style="flex:1;padding:14px 18px;">
            <div style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Records</div>
            <div style="font-size:22px;font-weight:800;color:var(--p);">@Model.Expenses.Count</div>
        </div>
        @{
            var byCat = Model.Expenses.GroupBy(e => e.CategoryName).OrderByDescending(g => g.Sum(e => e.Amount)).Take(3).ToList();
        }
        @if (byCat.Any())
        {
            <div class="card" style="flex:2;padding:14px 18px;">
                <div style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">Top Categories</div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                    @foreach (var g in byCat)
                    {
                        <span class="badge b-purple">@g.Key: ₹@g.Sum(e => e.Amount).ToString("N0")</span>
                    }
                </div>
            </div>
        }
    </div>
}

<div class="card">
    <div class="tbl-wrap">
        @if (!Model.Expenses.Any())
        {
            <div class="empty">
                <div class="empty-ico">🧾</div>
                <h3>No expense records found</h3>
                <p>Use filters or record a new expense.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Exp. No</th><th>Title</th><th>Category</th><th>Vendor</th><th>Amount</th><th>Mode</th><th>Bill No</th><th>Date</th><th>Entered By</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Expenses)
                    {
                        <tr>
                            <td style="vertical-align:middle;"><span class="mono text-p" style="font-size:12px;">@e.ExpenseNo</span></td>
                            <td style="vertical-align:middle;">
                                <div class="fw7">@e.Title</div>
                                @if (!string.IsNullOrEmpty(e.Description))
                                {
                                    <div style="font-size:11px;color:var(--mu);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:180px;">@e.Description</div>
                                }
                            </td>
                            <td style="vertical-align:middle;"><span class="badge b-purple">@(e.CategoryName ?? "—")</span></td>
                            <td style="font-size:12.5px;vertical-align:middle;">@(e.VendorName ?? "—")</td>
                            <td style="vertical-align:middle;"><div style="font-weight:800;color:var(--err);">₹@e.Amount.ToString("N0")</div></td>
                            <td style="vertical-align:middle;"><span class="badge b-cash">@e.PaymentMode</span></td>
                            <td style="font-size:12px;color:var(--mu);vertical-align:middle;">@(e.BillNo ?? "—")</td>
                            <td style="font-size:12px;color:var(--mu);white-space:nowrap;vertical-align:middle;">@e.ExpenseDate.ToString("dd MMM yyyy")</td>
                            <td style="font-size:12.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:150px;vertical-align:middle;" title="@(e.EnteredByName ?? "—")">@(e.EnteredByName ?? "—")</td>
                            <td style="vertical-align:middle;white-space:nowrap;">
                                <div style="display:flex;gap:8px;align-items:center;">
                                    <a href="/Expenses/Edit/@e.ExpenseId" class="btn btn-outline btn-sm btn-icon">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="/Expenses/Delete/@e.ExpenseId" style="display:flex;" onsubmit="return confirm('Are you sure you want to delete this expense?');">
                                        <button type="submit" class="btn btn-danger btn-sm btn-icon">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="pagi">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="/Expenses/Index?page=@i&search=@Model.Search&category=@Model.CategoryFilter&month=@Model.MonthFilter&year=@Model.YearFilter"
                   class="pg-btn @(i == Model.Page ? "active" : "")">@i</a>
            }
        </div>
    }
</div>