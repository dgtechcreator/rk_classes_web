@model SchoolMS.Web.ViewModels.LoginVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Sign In — RK Classes</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
*, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }

body {
  font-family:'Inter',sans-serif;
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#f0f2f5;
}

.card {
  width:100%;
  max-width:380px;
  margin:20px;
  background:#fff;
  border-radius:16px;
  box-shadow:0 4px 6px rgba(0,0,0,.05), 0 20px 50px rgba(0,0,0,.12);
  padding:40px 36px 36px;
  text-align:center;
}

/* logo */
.logo-img {
  width:90px;
  height:90px;
  border-radius:50%;
  object-fit:cover;
  margin:0 auto 16px;
  display:block;
  box-shadow:0 4px 16px rgba(0,0,0,.12);
}

.school-name {
  font-size:20px;
  font-weight:800;
  color:#1a2147;
  margin-bottom:2px;
}

.school-sub {
  font-size:12px;
  color:#9ca3af;
  font-weight:500;
  margin-bottom:28px;
}

/* divider */
.divider {
  height:1px;
  background:#f3f4f6;
  margin-bottom:24px;
}

/* error */
.err-box {
  background:#fff5f5;
  border:1px solid #fecaca;
  border-radius:8px;
  padding:10px 14px;
  font-size:13px;
  color:#dc2626;
  font-weight:500;
  display:flex;
  align-items:center;
  gap:8px;
  margin-bottom:16px;
  text-align:left;
  animation:shake .35s ease;
}
@@keyframes shake {
  0%,100%{transform:none;} 25%{transform:translateX(-4px);} 75%{transform:translateX(4px);}
}

/* fields */
.field { margin-bottom:14px; text-align:left; }

.field-lbl {
  font-size:12px;
  font-weight:600;
  color:#374151;
  margin-bottom:6px;
  display:block;
}

.inp-wrap { position:relative; }

.inp-ic {
  position:absolute;
  left:12px;
  top:50%;
  transform:translateY(-50%);
  color:#d1d5db;
  font-size:13px;
  pointer-events:none;
  transition:color .2s;
}

.inp {
  width:100%;
  height:44px;
  border-radius:8px;
  border:1.5px solid #e5e7eb;
  background:#fff;
  padding:0 40px 0 36px;
  font-size:13.5px;
  font-family:inherit;
  font-weight:500;
  color:#111827;
  outline:none;
  transition:border-color .2s, box-shadow .2s;
}
.inp::placeholder { color:#d1d5db; }
.inp:focus {
  border-color:#c0392b;
  box-shadow:0 0 0 3px rgba(192,57,43,.08);
}
.inp-wrap:focus-within .inp-ic { color:#c0392b; }

.eye-btn {
  position:absolute;
  right:12px;
  top:50%;
  transform:translateY(-50%);
  background:none;
  border:none;
  cursor:pointer;
  color:#d1d5db;
  font-size:13px;
  padding:4px;
  transition:color .2s;
}
.eye-btn:hover { color:#6b7280; }

/* button */
.login-btn {
  width:100%;
  height:44px;
  border:none;
  border-radius:8px;
  cursor:pointer;
  background:#1a2147;
  color:#fff;
  font-size:14px;
  font-weight:700;
  font-family:inherit;
  letter-spacing:.2px;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  margin-top:6px;
  transition:background .2s, transform .15s;
}
.login-btn:hover { background:#c0392b; transform:translateY(-1px); }
.login-btn:active { transform:scale(.98); }
.login-btn.loading .btn-txt, .login-btn.loading .btn-ic { display:none; }
.login-btn.loading .spinner { display:block; }
.login-btn .spinner { display:none; }

@@keyframes spin { to { transform:rotate(360deg); } }
.spinner {
  width:17px; height:17px;
  border:2px solid rgba(255,255,255,.3);
  border-top-color:#fff;
  border-radius:50%;
  animation:spin .6s linear infinite;
}

.footer {
  margin-top:24px;
  font-size:11.5px;
  color:#d1d5db;
  font-weight:500;
}
</style>
</head>
<body>

<div class="card">
  <img src="/images/rk-logo.png" alt="RK Classes" class="logo-img"/>
  <div class="school-name">RK Classes</div>
  <div class="school-sub">School Management System</div>
  <div class="divider"></div>

  @if (Model?.Error != null)
  {<div class="err-box"><i class="fas fa-exclamation-circle"></i> @Model.Error</div>}

  <form method="post" action="/Account/Login" id="loginForm">
    <div class="field">
      <label class="field-lbl">Username</label>
      <div class="inp-wrap">
        <i class="fas fa-user inp-ic"></i>
        <input class="inp" type="text" name="Username" value="@Model?.Username"
               placeholder="Enter username" autofocus required autocomplete="username"/>
      </div>
    </div>
    <div class="field">
      <label class="field-lbl">Password</label>
      <div class="inp-wrap">
        <i class="fas fa-lock inp-ic"></i>
        <input class="inp" type="password" name="Password" id="pwdField"
               placeholder="Enter password" required autocomplete="current-password"/>
        <button type="button" class="eye-btn" onclick="togglePwd()">
          <i class="fas fa-eye" id="eyeIcon"></i>
        </button>
      </div>
    </div>
    <button type="submit" class="login-btn" id="loginBtn">
      <i class="fas fa-sign-in-alt btn-ic"></i>
      <span class="btn-txt">Sign In</span>
      <div class="spinner"></div>
    </button>
  </form>

  <div class="footer">© 2025–26 RK Classes · All rights reserved</div>
</div>

<script>
function togglePwd() {
  var f = document.getElementById('pwdField');
  var i = document.getElementById('eyeIcon');
  f.type = f.type === 'password' ? 'text' : 'password';
  i.className = f.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
}
document.getElementById('loginForm').addEventListener('submit', function() {
  var btn = document.getElementById('loginBtn');
  btn.classList.add('loading');
  btn.disabled = true;
});
</script>
</body>
</html>
