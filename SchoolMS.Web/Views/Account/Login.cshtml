@model SchoolMS.Web.ViewModels.LoginVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Sign In — RK Classes</title>
<link rel="icon" type="image/png" href="/icons/favicon.png?v=3"/>
<link rel="shortcut icon" type="image/png" href="/icons/favicon.png?v=3"/>
<link rel="apple-touch-icon" href="/icons/icon-192.png?v=3"/>
<meta name="theme-color" content="#ffffff"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/login-new.css?v=5"/>
</head>
<body>

<!-- Top bar -->
<header class="topbar">
  <div class="topbar-in">
    <div class="brand">
      <img class="brand-logo" src="/images/login/logo.png" alt="RK Classes"/>
      <span class="brand-sep"></span>
      <div>
        <div class="brand-name">Ramjeet Kalavati Educational Institute</div>
        <div class="brand-tag">If you Believe,You will achieve</div>
      </div>
    </div>
    <div class="since"><i class="fa-regular fa-calendar-days"></i><span>Since 2002</span></div>
  </div>
</header>

<main class="page">

  <!-- decorative pieces around the card (desktop only) -->
  <img class="deco deco-bulb"   src="/images/login/idea-icon.png"       alt="" aria-hidden="true"/>
  <img class="deco deco-books"  src="/images/login/books.png"           alt="" aria-hidden="true"/>
  <img class="deco deco-plane"  src="/images/login/paper-plane.png"     alt="" aria-hidden="true"/>
  <img class="deco deco-school" src="/images/login/school-building.png" alt="" aria-hidden="true"/>
  <img class="deco deco-book"   src="/images/login/book-icon.png"       alt="" aria-hidden="true"/>

  <div class="shell">

    <!-- Left: welcome -->
    <section class="welcome">
      <div class="eyebrow">Ramjeet Kalavati<br/>Educational Institute</div>
      <img class="w-cap"  src="/images/login/graduation-cap.png" alt="" aria-hidden="true"/>
      <img class="w-dots" src="/images/login/dots-pattern.png"   alt="" aria-hidden="true"/>

      <div class="w-logo-wrap">
        <img class="w-logo" src="/images/login/logo.png" alt="RK Classes"/>
        <div class="est">EST. 2002</div>
      </div>

      <h2 class="w-title">Welcome to <br/><b>RK</b> Classes</h2>
      <p class="w-sub">Your learning journey, managed in one place.</p>

      <div class="features">
        <div class="feat"><img src="/images/login/icon-student.png" alt=""/><span>Student<br/>Management</span></div>
        <div class="feat"><img src="/images/login/icon-fees.png" alt=""/><span>Attendance<br/>&amp; Fees</span></div>
        <div class="feat"><img src="/images/login/icon-academic.png" alt=""/><span>Academic<br/>Updates</span></div>
      </div>
    </section>

    <!-- Right: sign in -->
    <section class="signin">
      <div class="s-inner">
        <h1 class="s-title">Sign in to your portal</h1>
        <p class="s-sub">Access your classes dashboard securely.</p>

        @if (Model?.Error != null)
        {<div class="err-box" role="alert"><i class="fas fa-exclamation-circle"></i><span>@Model.Error</span></div>}

        <form method="post" action="/Account/Login" id="loginForm">
          <div class="fld">
            <label for="userField">Username</label>
            <div class="fld-box">
              <i class="fa-regular fa-user fld-ico"></i>
              <input class="fld-in" type="text" name="Username" id="userField" value="@Model?.Username"
                     placeholder="Enter your username" autofocus required autocomplete="username"/>
            </div>
          </div>

          <div class="fld">
            <label for="pwdField">Password</label>
            <div class="fld-box">
              <i class="fa-solid fa-lock fld-ico"></i>
              <input class="fld-in" type="password" name="Password" id="pwdField"
                     placeholder="Enter your password" required autocomplete="current-password"/>
              <button type="button" class="eye" onclick="togglePwd()" aria-label="Show or hide password">
                <i class="fa-regular fa-eye" id="eyeIcon"></i>
              </button>
            </div>
          </div>

          <div class="row-opts">
            <label class="remember"><input type="checkbox" name="RememberMe"/> Remember me</label>
            <button type="button" class="forgot" onclick="document.getElementById('forgotNote').classList.toggle('show')">Forgot password?</button>
          </div>
          <div class="forgot-note" id="forgotNote">Please contact your administrator to reset your password.</div>

          <button type="submit" class="btn-main" id="loginBtn">
            <span class="btn-txt"><i class="fa-solid fa-right-to-bracket"></i>&nbsp;&nbsp;Sign In</span>
            <div class="spinner"></div>
          </button>
        </form>

        <div class="or">OR</div>

        <a href="/Parent/Login" class="btn-parent"><i class="fa-solid fa-user-group"></i> Parent / Guardian Login</a>

        <div class="secure">
          <p><img src="/images/login/security-icon.png" alt=""/> Secure access &bull; Built for better learning</p>
          <small>&copy; @DateTime.Now.Year RK Classes</small>
        </div>
      </div>
    </section>

  </div>
</main>

<script src="/js/login-fit.js?v=1"></script>
<script>
function togglePwd() {
  var f = document.getElementById('pwdField');
  var i = document.getElementById('eyeIcon');
  f.type = f.type === 'password' ? 'text' : 'password';
  i.className = f.type === 'password' ? 'fa-regular fa-eye' : 'fa-regular fa-eye-slash';
}
document.getElementById('loginForm').addEventListener('submit', function() {
  var btn = document.getElementById('loginBtn');
  btn.classList.add('loading');
  btn.disabled = true;
});
</script>
</body>
</html>
