@model SchoolMS.Domain.FeePayment
@{
    Layout = null;
    // Use stored DueDate from payment, or calculate from ViewBag if not stored
    var dueDate = Model.DueDate;
    if (!dueDate.HasValue)
    {
        dueDate = ViewBag.DueDate as DateTime?;
    }
    var remainingBalance = ViewBag.RemainingBalance as decimal? ?? 0;
}
@functions {
    static string AmountInWords(decimal number)
    {
        if (number == 0) return "Zero";
        string[] ones = { "", "One","Two","Three","Four","Five","Six","Seven","Eight","Nine",
            "Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen" };
        string[] tens = { "","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety" };
        long n = (long)number;
        string w = "";
        if (n >= 10000000) { w += AmountInWords(n / 10000000) + " Crore "; n %= 10000000; }
        if (n >= 100000)   { w += AmountInWords(n / 100000)   + " Lakh ";  n %= 100000; }
        if (n >= 1000)     { w += AmountInWords(n / 1000)     + " Thousand "; n %= 1000; }
        if (n >= 100)      { w += ones[n / 100] + " Hundred "; n %= 100; }
        if (n >= 20)       { w += tens[n / 10] + " "; n %= 10; }
        if (n > 0)         { w += ones[n] + " "; }
        return w.Trim();
    }
}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<title>Fee Receipt — @Model.ReceiptNo</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; background: #f0f0f0; padding: 20px; }

/* ── Buttons ── */
.no-print { max-width: 820px; margin: 0 auto 14px; }
.btn-group { display: flex; gap: 10px; margin-bottom: 10px; }
.btn-group button {
  flex: 1; padding: 11px; font-size: 14px; font-weight: 700;
  cursor: pointer; border-radius: 6px; border: none;
}
.btn-print     { background: #1a237e; color: #fff; }
.btn-landscape { background: #0d6832; color: #fff; }
.btn-close     { background: #fff; color: #1a237e; border: 2px solid #1a237e !important; }

/* ── Page box ── */
.page { background: #fff; max-width: 820px; margin: 0 auto; border: 2px solid #333; }

/* ── Top label ── */
.top-label { font-size: 18px; font-weight: 700; padding: 5px 12px; display: flex; justify-content: space-between; align-items: center; }

/* ── Institute name ── */
.institute-name {
  text-align: center; font-size: 22px; font-weight: 900;
  letter-spacing: 2.5px; text-transform: uppercase;
  padding: 10px 10px 9px; border-bottom: 2px solid #333;
}

/* ── Header row ── */
.header-row { display: flex; border-bottom: 1px solid #333; }

/* Left: logos + address */
.left-side { flex: 1.6; border-right: 1px solid #333; padding: 10px 14px; }
.logos-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.logo-circle { height: 160px; width: auto; flex-shrink: 0; }
.logo-rk {
  height: 130px; width: auto; object-fit: contain; object-position: left;
  filter: contrast(1.4) brightness(0.85);   /* darker for B&W print */
}
.addr-text { font-size: 12px; line-height: 1.75; color: #111; }

/* Right: student info */
.right-side { flex: 1; padding: 12px 16px 8px; font-size: 11.5px; line-height: 1.85; color: #111; }
.s-name { font-weight: 700; font-size: 13px; margin-bottom: 4px; text-transform: uppercase; color: #111; }
.right-side .lbl { font-weight: 700; }

/* ── Receipt table ── */
.rtable { width: 100%; border-collapse: collapse; }
.rtable td { border: 1px solid #333; padding: 7px 11px; font-size: 12px; vertical-align: middle; }
.rtable .hdr-cell { font-weight: 700; font-size: 13px; }

/* ── Terms ── */
.terms { border-top: 1px solid #333; padding: 8px 14px 14px; font-size: 11px; line-height: 1.85; }
.terms strong { font-size: 12px; }

/* ══════════════════════════════════════════════
   PRINT — A5 PORTRAIT  (default)
══════════════════════════════════════════════ */
@@media print {
  @@page { size: A5 portrait; margin: 6mm 8mm; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { background: #fff; padding: 0; margin: 0; }
  .no-print { display: none !important; }
  .page { border: 1px solid #000; max-width: 100%; width: 100%; box-shadow: none; page-break-inside: avoid; }
  .top-label        { font-size: 14px;  padding: 3px 8px; display: flex; justify-content: space-between; align-items: center; }
  .institute-name   { font-size: 14px;  padding: 5px 8px 4px; letter-spacing: 1.5px; }
  .left-side        { padding: 6px 10px; }
  .logos-row        { gap: 6px; margin-bottom: 4px; }
  .logo-circle      { height: 85px; }
  .logo-rk          { height: 85px; }
  .addr-text        { font-size: 8.5px; line-height: 1.55; }
  .right-side       { padding: 7px 10px 5px; font-size: 9px; line-height: 1.7; }
  .s-name           { font-size: 10px;  margin-bottom: 2px; }
  .rtable td        { padding: 4px 8px; font-size: 9px; }
  .rtable .hdr-cell { font-size: 10px; }
  .terms            { padding: 5px 10px 7px; font-size: 8.5px; line-height: 1.6; }
  .terms strong     { font-size: 9px; }
}

/* ══════════════════════════════════════════════
   PRINT — A5 LANDSCAPE  (orientation:landscape)
══════════════════════════════════════════════ */
@@media print and (orientation: landscape) {
  @@page { size: A5 landscape; margin: 5mm 8mm; }
  .logo-circle    { height: 48px; }
  .logo-rk        { height: 72px; }
  .addr-text      { font-size: 8px;  line-height: 1.45; }
  .right-side     { padding: 6px 10px 4px; font-size: 8.5px; line-height: 1.6; }
  .s-name         { font-size: 9.5px; }
  .rtable td      { padding: 3px 7px; font-size: 8.5px; }
  .terms          { padding: 4px 10px 6px; font-size: 8px; line-height: 1.5; }
}
</style>
</head>
<body>

<div class="no-print">
  <div class="btn-group">
    <button class="btn-print"     onclick="printPortrait()">🖨️ Print Receipt (Portrait)</button>
    <button class="btn-landscape" onclick="printLandscape()">🖨️ Print Landscape</button>
    <button class="btn-close"     onclick="history.back()">✕ Close</button>
  </div>
  @{
    string RcIntl(string? raw)
    {
      var d = new string((raw ?? "").Where(char.IsDigit).ToArray());
      if (d.Length < 10) return "";
      if (d.StartsWith("0")) d = d.Substring(1);
      return d.Length == 10 ? "91" + d : d;
    }
    var rcNums = new List<(string L, string N)>();
    foreach (var (l, raw) in new[] { ("Father", Model.FatherPhone), ("Student", Model.StudentPhone) })
    {
      var n = RcIntl(raw);
      if (n != "" && !rcNums.Any(x => x.N == n)) rcNums.Add((l, n));
    }
  }
  @if (rcNums.Any())
  {
    <div class="btn-group">
      @foreach (var c in rcNums)
      {
        <button style="background:#25d366;color:#fff;" onclick="rcWhatsapp('@c.N')">💬 WhatsApp @c.L</button>
      }
    </div>
    <div style="font-size:12px;color:#555;margin-bottom:8px;">To send the PDF: Print → "Save as PDF", then attach it in the WhatsApp chat.</div>
  }
</div>

@{
  var payYear   = Model.PaymentDate.Month >= 4
                    ? $"{Model.PaymentDate.Year}-{Model.PaymentDate.Year+1}"
                    : $"{Model.PaymentDate.Year-1}-{Model.PaymentDate.Year}";
  var amtWords  = AmountInWords(Model.NetAmount) + " Only/-";
  var isCheque  = Model.PaymentMode == "Cheque" || Model.PaymentMode == "Demand Draft";
  var isOnline  = Model.PaymentMode == "Online Transfer" || Model.PaymentMode == "UPI";
  var chequeNo  = isCheque ? (Model.TransactionRef ?? "") : "";
  var onlineRef = isOnline ? (Model.TransactionRef ?? "") : "";
}

<div class="page">

  <div class="top-label">
    <span>Kapil Sir's</span>
    <span>SINCE : 2002</span>
  </div>

  <div class="institute-name">Ramjeet Kalavati Educational Institute</div>

  <div class="header-row">

    <!-- LEFT: logos + address -->
    <div class="left-side">
      <div class="logos-row">
        <img class="logo-rk"     src="/images/rkBw.png" alt="RK Classes Since 2002"/>
        <img class="logo-circle" src="/images/rkname.png" alt="RK Name"/>
      </div>
      <div class="addr-text">
        Shop No. 2, Santosh Society, Krishna Nagar,<br/>
        Near Eden School, Kajupada Pipe Line,<br/>
        Sakinaka, Mumbai 400072.<br/>
        <b>E-Mail:</b> rkclasseskapilsir2002@gmail.com<br/>
        <b>Website:</b> www.myrkclasses.com<br/>
        <b>Mobile No:</b> 9870375795 / 8108499214
      </div>
    </div>

    <!-- RIGHT: student info -->
    <div class="right-side">
      <div class="s-name">@(Model.StudentName?.ToUpper() ?? "—")</div>
      <div><span class="lbl">Address:</span> @(Model.StudentAddress ?? "")</div>
      <div><span class="lbl">Contact No.:</span> @(Model.FatherPhone ?? Model.StudentPhone ?? "-")</div>
      <div><span class="lbl">E-Mail:</span> @(Model.StudentEmail ?? "-")</div>
    </div>

  </div>

  <!-- Receipt details table -->
  <table class="rtable">
    <tr>
      <td class="hdr-cell" style="width:40%;">Fees Receipt (@payYear)</td>
      <td style="width:32%;"><b>Receipt Date:</b> @Model.PaymentDate.ToString("dd-MM-yyyy")</td>
      <td style="width:28%;"><b>Receipt No.:</b> @Model.ReceiptNo</td>
    </tr>
    <tr>
      <td><b>Course:-</b> @(Model.ClassName ?? "—")</td>
      <td><b>Stream / Medium:-</b> @(Model.SectionName ?? "—")</td>
      <td><b>Batch:-</b> @(Model.BatchName ?? "—")</td>
    </tr>
    <tr>
      <td colspan="3"><b>Amount received:-</b> @Model.NetAmount.ToString("N0")/-</td>
    </tr>
    <tr>
      <td colspan="3"><b>Amount received (in words):-</b> @amtWords</td>
    </tr>
    <tr>
      <td><b>Payment Mode:-</b> @Model.PaymentMode</td>
      <td colspan="2"><b>Cheque No.:</b> @(string.IsNullOrWhiteSpace(chequeNo) ? "NA" : chequeNo)</td>
    </tr>
    <tr>
      <td><b>Cheque Dated:-</b> @(string.IsNullOrWhiteSpace(chequeNo) ? "NA" : "-")</td>
      <td colspan="2"><b>Bank Name:-</b> @(string.IsNullOrWhiteSpace(chequeNo) ? "NA" : "-")</td>
    </tr>
    <tr>
      <td><b>IFSC Code:-</b> @(string.IsNullOrWhiteSpace(chequeNo) ? "NA" : "-")</td>
      <td colspan="2"><b>Online Tranx. No.:-</b> @(string.IsNullOrWhiteSpace(onlineRef) ? "NA" : onlineRef)</td>
    </tr>
    <tr>
      <td><b>Due Date:-</b> @(dueDate.HasValue ? dueDate.Value.ToString("dd-MM-yyyy") : "Nil")</td>
      <td colspan="2"><b>Due fees:-</b> @(remainingBalance > 0 ? "₹" + remainingBalance.ToString("N0") : "Nil")</td>
    </tr>
  </table>

  <div class="terms">
    <strong>Term and Conditions:</strong><br/>
    1) This receipt of fees is an acknowledgement of the payment made to<br/>
    2) Present this receipt of fees whenever demanded.<br/>
    3) Fees once paid is neither refundable nor transferable under any circumstances<br/>
    4) This is a computer generated voucher, signature is not required
  </div>

</div>

<script>

function rcWhatsapp(number) {
  const vars = {
    student: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StudentName ?? "")),
    class: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.ClassName ?? "").Trim())),
    medium: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.SectionName ?? "").Trim())),
    receipt: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReceiptNo ?? "")),
    amount: '@Model.NetAmount.ToString("N0")',
    date: new Date().toLocaleDateString('en-GB').replace(/\//g, '-'), school: 'RK Classes'
  };
  fetch('/Masters/MessageTemplatesJson?category=Receipt').then(r => r.json()).catch(() => []).then(list => {
    const body = (list && list[0] && list[0].body) ||
      'Dear Parent, thank you. Please find attached the fee receipt {receipt} of Rs {amount} for {student} ({class}). - {school}';
    const msg = body.replace(/\{(\w+)\}/g, (m, k) => (vars[k.toLowerCase()] !== undefined ? vars[k.toLowerCase()] : m));
    window.open('https://wa.me/' + number + '?text=' + encodeURIComponent(msg), '_blank');
  });
}

function printPortrait() {
  var s = document.getElementById('ls-style');
  if (s) s.textContent = '';
  window.print();
}

function printLandscape() {
  var at = String.fromCharCode(64);
  var rule = at + 'media print{' + at + 'page{size:A5 landscape;margin:5mm 8mm;}}';
  var s = document.getElementById('ls-style');
  if (!s) { s = document.createElement('style'); s.id = 'ls-style'; document.head.appendChild(s); }
  s.textContent = rule;
  window.print();
  setTimeout(function(){ s.textContent = ''; }, 1500);
}


</script>
</body>
</html>
