  var msgDisplay = feeMsg.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');

  var modalDiv = document.createElement('div');
  modalDiv.style.cssText = 'background:#fff;padding:24px;border-radius:12px;box-shadow:0 10px 40px rgba(0,0,0,0.2);max-width:480px;width:90%;max-height:80vh;overflow-y:auto;';

  var msgDiv = document.createElement('div');
  msgDiv.style.cssText = 'font-size:12px;line-height:1.6;color:#333;margin-bottom:20px;white-space:pre-wrap;font-family:Arial,sans-serif;';
  msgDiv.innerHTML = msgDisplay;

  var buttonsDiv = document.createElement('div');
  buttonsDiv.style.cssText = 'display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;';

  var fatherBtn = document.createElement('button');
  fatherBtn.textContent = '👨 Father';
  fatherBtn.style.cssText = 'background:#25D366;color:#fff;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;font-size:14px;';
  fatherBtn.onclick = function() { sendToFeeParent(studentId, fatherPhone); };

  var motherBtn = document.createElement('button');
  motherBtn.textContent = '👩 Mother';
  motherBtn.style.cssText = 'background:#25D366;color:#fff;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;font-size:14px;';
  motherBtn.onclick = function() { sendToFeeParent(studentId, motherPhone); };

  buttonsDiv.appendChild(fatherBtn);
  buttonsDiv.appendChild(motherBtn);

  var closeBtn = document.createElement('button');
  closeBtn.textContent = 'Close';
  closeBtn.style.cssText = 'width:100%;background:#f0f0f0;color:#333;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;';
  closeBtn.onclick = function() { modal.remove(); };

  modalDiv.appendChild(msgDiv);
  modalDiv.appendChild(buttonsDiv);
  modalDiv.appendChild(closeBtn);
  modal.appendChild(modalDiv);
  document.body.appendChild(modal);
}

