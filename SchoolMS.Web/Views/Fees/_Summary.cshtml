@model SchoolMS.Web.ViewModels.FeesListVM
@{ ViewData["Title"] = "Fees Summary"; }

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
  <h1 style="font-size:22px;font-weight:800;">💰 Fees Summary</h1>
  <a href="/Fees/Index" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back to Fees</a>
</div>

<form method="get" action="/Fees/Summary">
<div class="filter-bar">
  <input type="text" name="search" value="@Model.Search" class="fc" placeholder="Search student, receipt no..." style="min-width:200px;"/>
  <select name="month" class="fs"><option value="">All Months</option>@foreach(var m in new[]{"April","May","June","July","August","September","October","November","December","January","February","March"}){<option value="@m" selected=@(Model.MonthFilter==m?"selected":"")>@m</option>}</select>
  <select name="feeType" class="fs"><option value="">All Fee Types</option>@foreach(var ft in Model.FeeTypes){<option value="@ft.FeeTypeId" selected=@(Model.FeeTypeFilter==ft.FeeTypeId?"selected":"")>@ft.TypeName</option>}</select>
  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i></button>
  <a href="/Fees/Summary" class="btn btn-outline btn-sm"><i class="fas fa-times"></i></a>
</div></form>

@if (Model.Payments.Any())
{
  var tot = Model.Payments.Sum(p => p.NetAmount);
  <div style="display:flex;gap:12px;margin-bottom:16px;">
    <div class="card" style="flex:1;padding:14px 18px;"><div style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Total Collected</div><div style="font-size:22px;font-weight:800;color:var(--ok);">₹@tot.ToString("N0")</div></div>
    <div class="card" style="flex:1;padding:14px 18px;"><div style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Transactions</div><div style="font-size:22px;font-weight:800;color:var(--p);">@Model.Payments.Count</div></div>
  </div>
}

<div class="card">
  <div class="tbl-wrap">
    @if (!Model.Payments.Any())
    { <div class="empty"><div class="empty-ico">💰</div><h3>No payment records found</h3></div> }
    else
    {
    <table>
      <thead><tr><th>Receipt No</th><th>Student</th><th>Std</th><th>Fee Type</th><th>Month</th><th>Amount</th><th>Mode</th><th>Date</th><th>Collected By</th><th></th></tr></thead>
      <tbody>
      @foreach(var p in Model.Payments)
      {
        <tr>
          <td><a href="/Fees/Receipt/@p.PaymentId" target="_blank" class="mono text-p" style="font-size:12px;text-decoration:underline;">@p.ReceiptNo</a></td>
          <td><div class="fw7">@p.StudentName</div><div style="font-size:11px;" class="text-mu">@p.AdmissionNo</div></td>
          <td style="font-size:13px;">@p.ClassName / @p.SectionName</td>
          <td><span class="badge b-purple">@p.FeeTypeName</span></td>
          <td class="text-mu" style="font-size:13px;">@(p.Month??"—")</td>
          <td><div style="font-weight:800;color:var(--ok);">₹@p.NetAmount.ToString("N0")</div>@if(p.Discount>0){<div style="font-size:11px;" class="text-mu">Disc: ₹@p.Discount</div>}</td>
          <td><span class="badge @(p.PaymentMode=="Cash"?"b-cash":"b-online")">@p.PaymentMode</span></td>
          <td style="font-size:12px;" class="text-mu">@p.PaymentDate.ToString("dd MMM yy")</td>
          <td style="font-size:12.5px;">@p.CollectorName</td>
          <td style="display:flex;gap:6px;align-items:center;">
            <a href="/Fees/Receipt/@p.PaymentId" target="_blank" class="btn btn-outline btn-sm"><i class="fas fa-print"></i> Receipt</a>
            <form method="post" action="/Fees/DeletePayment/@p.PaymentId" style="margin:0;"
                  onsubmit="return confirm('Delete receipt @p.ReceiptNo? It can be restored from Deleted Records.')">
              @Html.AntiForgeryToken()
              <button type="submit" class="btn btn-sm" style="background:#fee2e2;color:#b91c1c;border:1px solid #fca5a5;" title="Delete Receipt">
                <i class="fas fa-trash"></i>
              </button>
            </form>
          </td>
        </tr>
      }
      </tbody>
    </table>
    }
  </div>
  @if (Model.TotalPages > 1)
  { <div class="pagi">@for(int i=1;i<=Model.TotalPages;i++){<a href="/Fees/Summary?page=@i&search=@Model.Search&month=@Model.MonthFilter&feeType=@Model.FeeTypeFilter" class="pg-btn @(i==Model.Page?"active":"")">@i</a>}</div> }
</div>
