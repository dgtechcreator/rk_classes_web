@model List<SchoolMS.Domain.FeeStructure>
@{
    ViewData["Title"] = "Fee Structure Setup";
    var years    = ViewBag.Years    as List<SchoolMS.Domain.AcademicYear> ?? new();
    var classes  = ViewBag.Classes  as List<SchoolMS.Domain.Class>        ?? new();
    var sections = ViewBag.Sections as List<SchoolMS.Domain.Section>      ?? new();
    var summary  = ViewBag.Summary  as List<SchoolMS.Domain.FeeStructureSummary> ?? new();
}

<div class="pg-hdr">
  <div class="pg-row">
    <div>
      <h1>⚙️ Fee Structure Setup</h1>
      <p>Define fees by Academic Year, Class and Section — auto-applied to new students</p>
    </div>
    <div class="df g8">
      <a href="/FeeStructure/Create"  class="btn btn-primary"><i class="fas fa-plus"></i> Add Fee Head</a>
      <a href="/FeeStructure/FeesDue" class="btn btn-outline"><i class="fas fa-list-alt"></i> Fees Due</a>
    </div>
  </div>
</div>

@* ── Summary cards ─────────────────────────────────────────── *@
@if (summary.Any())
{
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-bottom:22px;">
    @foreach (var s in summary)
    {
      var pct = s.CollectedAmt + s.PendingAmt > 0
                ? (int)(s.CollectedAmt * 100 / (s.CollectedAmt + s.PendingAmt))
                : 0;
      <div class="card" style="padding:16px 18px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
          <div>
            <div style="font-size:14px;font-weight:800;color:var(--txt);">@s.ClassName — @s.SectionName</div>
            <div style="font-size:11px;color:var(--mu);">@s.YearName • @s.StudentCount students • @s.FeeHeads fee heads</div>
          </div>
          <div style="width:38px;height:38px;border-radius:10px;background:#f5f3ff;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;">🏫</div>
        </div>
        <div style="display:flex;gap:12px;margin-bottom:10px;">
          <div style="flex:1;background:#ecfdf5;border-radius:var(--rs);padding:8px 10px;">
            <div style="font-size:10px;font-weight:800;color:#065f46;text-transform:uppercase;letter-spacing:.4px;">Collected</div>
            <div style="font-size:16px;font-weight:800;color:#065f46;">₹@s.CollectedAmt.ToString("N0")</div>
          </div>
          <div style="flex:1;background:#fef2f2;border-radius:var(--rs);padding:8px 10px;">
            <div style="font-size:10px;font-weight:800;color:#991b1b;text-transform:uppercase;letter-spacing:.4px;">Pending</div>
            <div style="font-size:16px;font-weight:800;color:#991b1b;">₹@s.PendingAmt.ToString("N0")</div>
          </div>
        </div>
        <div style="height:6px;background:#f3f0ff;border-radius:3px;">
          <div style="height:6px;border-radius:3px;background:linear-gradient(90deg,var(--ok),#34d399);width:@pct%;transition:width .4s;"></div>
        </div>
        <div style="font-size:11px;color:var(--mu);margin-top:4px;text-align:right;">@pct% collected • Monthly: ₹@s.TotalMonthlyFee.ToString("N0")</div>
      </div>
    }
  </div>
}

@* ── Filter bar ────────────────────────────────────────────── *@
<form method="get" action="/FeeStructure/Index">
<div class="filter-bar">
  <i class="fas fa-filter" style="color:var(--mu);font-size:13px;"></i>
  <select name="yearId" class="fs">
    <option value="">All Years</option>
    @foreach(var y in years){<option value="@y.YearId" selected=@((int?)ViewBag.YearId==y.YearId?"selected":"")>@y.YearName @(y.IsCurrent?"✓ Current":"")</option>}
  </select>
  <select name="sectionId" class="fs">
    <option value="">All Medium/Stream</option>
    @foreach(var s in sections){<option value="@s.SectionId" selected=@((int?)(ViewBag.SectionId)==s.SectionId?"selected":"")>@s.SectionName</option>}
  </select>
  <select name="classId" class="fs">
    <option value="">All Std</option>
    @foreach(var c in classes){<option value="@c.ClassId" selected=@((int?)(ViewBag.ClassId)==c.ClassId?"selected":"")>@c.ClassName</option>}
  </select>
  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Filter</button>
  <a href="/FeeStructure/Index" class="btn btn-outline btn-sm"><i class="fas fa-times"></i> Clear</a>
</div>
</form>

@* ── Table ─────────────────────────────────────────────────── *@
<div class="card">
  @if (!Model.Any())
  {
    <div class="empty">
      <div class="empty-ico">⚙️</div>
      <h3>No fee structure defined yet</h3>
      <p>Click "Add Fee Head" to set up fees for a class and section.</p>
      <a href="/FeeStructure/Create" class="btn btn-primary" style="margin-top:16px;"><i class="fas fa-plus"></i> Add Fee Head</a>
    </div>
  }
  else
  {
    @* Group by Year → Class → Section *@
    var grouped = Model
        .GroupBy(x => new { x.YearName, x.ClassName, x.SectionName })
        .OrderBy(g => g.Key.YearName).ThenBy(g => g.Key.ClassName).ThenBy(g => g.Key.SectionName);

    @foreach (var grp in grouped)
    {
      var totalFee = grp.Sum(x => x.Amount);
      <div style="margin-bottom:22px;">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;background:#f5f3ff;border-radius:var(--rs);border:1.5px solid var(--bdr);margin-bottom:6px;">
          <div style="display:flex;align-items:center;gap:10px;">
            <span style="font-size:15px;">🏫</span>
            <span style="font-size:14px;font-weight:800;color:var(--txt);">@grp.Key.ClassName &nbsp;·&nbsp; @grp.Key.SectionName</span>
            <span class="badge b-purple" style="font-size:11px;">Medium/Stream</span>
            <span style="font-size:12px;color:var(--mu);">(@grp.Key.YearName)</span>
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <span style="font-size:13px;font-weight:800;color:var(--p);">Total: ₹@totalFee.ToString("N0") / month</span>
            <a href="/FeeStructure/Create" class="btn btn-outline btn-sm"><i class="fas fa-plus"></i> Add Head</a>
          </div>
        </div>

        <div class="tbl-wrap">
        <table>
          <thead>
            <tr><th>Fee Type</th><th>Amount (₹)</th><th>Due Day</th><th>Remarks</th><th>Added By</th><th></th></tr>
          </thead>
          <tbody>
          @foreach (var row in grp.OrderBy(x => x.FeeTypeName))
          {
            <tr>
              <td>
                <span class="badge b-purple">@row.FeeTypeName</span>
              </td>
              <td>
                <span style="font-size:15px;font-weight:800;color:var(--txt);">₹@row.Amount.ToString("N0")</span>
              </td>
              <td style="font-size:13px;">@row.DueDay<sup>th</sup> of month</td>
              <td style="font-size:12.5px;color:var(--mu);">@(row.Remarks ?? "—")</td>
              <td style="font-size:12.5px;color:var(--mu);">@(row.CreatedByName ?? "—")</td>
              <td>
                <div class="df g8">
                  <a href="/FeeStructure/Edit/@row.StructureId" class="btn btn-outline btn-sm btn-icon" title="Edit"><i class="fas fa-edit"></i></a>
                  <form method="post" action="/FeeStructure/Delete/@row.StructureId"
                        onsubmit="return confirm('Delete this fee head? Unpaid student fees will also be removed.')">
                    <button type="submit" class="btn btn-danger btn-sm btn-icon" title="Delete"><i class="fas fa-trash"></i></button>
                  </form>
                </div>
              </td>
            </tr>
          }
          </tbody>
        </table>
        </div>
      </div>
    }
  }
</div>

@* ── Generate Monthly Fees panel ───────────────────────────── *@
<div class="card" style="margin-top:6px;">
  <div class="card-hdr">
    <span class="card-ttl"><i class="fas fa-calendar-plus" style="color:var(--p);margin-right:6px;"></i>Generate Monthly Fees</span>
    <span style="font-size:12px;color:var(--mu);">Creates StudentFee records for all active students for the selected month</span>
  </div>
  <form method="post" action="/FeeStructure/GenerateMonthly" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
    <div class="fg" style="min-width:180px;">
      <label>Month *</label>
      <select name="month" class="fs" required>
        @foreach(var m in new[]{"April","May","June","July","August","September","October","November","December","January","February","March"})
        {<option value="@m">@m</option>}
      </select>
    </div>
    <div class="fg" style="min-width:180px;">
      <label>Academic Year *</label>
      <select name="yearId" class="fs" required>
        @foreach(var y in years){<option value="@y.YearId" selected=@(y.IsCurrent?"selected":"")>@y.YearName</option>}
      </select>
    </div>
    <button type="submit" class="btn btn-primary"
            onclick="return confirm('Generate monthly fees for selected month and year?')">
      <i class="fas fa-bolt"></i> Generate Fees
    </button>
  </form>
</div>
