@model List<SchoolMS.Domain.TestMark>
@{
    ViewData["Title"] = "Test Reports";
    var years     = ViewBag.Years    as List<SchoolMS.Domain.AcademicYear>  ?? new();
    var classes   = ViewBag.Classes  as List<SchoolMS.Domain.Class>         ?? new();
    var sections  = ViewBag.Sections as List<SchoolMS.Domain.Section>       ?? new();
    var batches   = ViewBag.Batches  as List<SchoolMS.Domain.Batch>         ?? new();
    var subjects  = ViewBag.Subjects as List<SchoolMS.Domain.Subject>       ?? new();
    var examList  = ViewBag.ExamList as List<SchoolMS.Domain.Exam>          ?? new();
    var students  = ViewBag.Students as List<SchoolMS.Domain.StudentMarkRow> ?? new();
    var allMarks  = ViewBag.AllMarks as List<SchoolMS.Domain.TestMark>      ?? new();

    int?   yearId    = ViewBag.YearId;
    int?   classId   = ViewBag.ClassId;
    int?   sectionId = ViewBag.SectionId;
    int?   batchId   = ViewBag.BatchId;
    int?   subjectId = ViewBag.SubjectId;
    int?   studentId = ViewBag.StudentId;
    string examName  = ViewBag.ExamName ?? "";
    string testDate  = ViewBag.TestDate ?? "";

    bool hasData       = Model.Any();
    bool isStudentView = studentId.HasValue && hasData;

    var subjectNames = hasData
        ? Model.Select(m => m.SubjectName ?? "").Distinct().OrderBy(s => s).ToList()
        : new List<string>();

    var byStudent = hasData
        ? Model.GroupBy(m => m.StudentId).OrderBy(g => g.First().RollNo).ToList()
        : new List<IGrouping<int, SchoolMS.Domain.TestMark>>();

    var first = Model.FirstOrDefault();
    string displayDate = "";
    if (!string.IsNullOrEmpty(testDate) && DateTime.TryParse(testDate, out var td))
        displayDate = td.ToString("dd MMM yyyy");

    string dlUrl = $"/Marks/DownloadReport?examName={Uri.EscapeDataString(examName)}&yearId={yearId}&sectionId={sectionId}&classId={classId}&batchId={batchId}&subjectId={subjectId}&testDate={testDate}";
}

<div class="pg-hdr">
  <div class="pg-row">
    <div>
      <h1>📊 Test Reports</h1>
      <p>View and download class-wise or student-wise test results</p>
    </div>
    <div class="df g8">
      @if (hasData)
      {
        <a href="@dlUrl" class="btn btn-success"><i class="fas fa-file-csv"></i> Download CSV</a>
        <button onclick="exportExcel()" class="btn btn-outline"><i class="fas fa-file-excel"></i> Excel</button>
      }
      <button onclick="window.print()" class="btn btn-outline"><i class="fas fa-print"></i> Print</button>
    </div>
  </div>
</div>

@* ── Filter Bar ──────────────────────────────────────────────── *@
<form method="get" action="/Marks/Report" id="rptForm">
<input type="hidden" name="examName" id="inp_examName" value="@examName"/>
<input type="hidden" name="testDate" id="inp_testDate" value="@testDate"/>
<div class="filter-bar" style="flex-wrap:wrap;gap:10px;">
  <i class="fas fa-filter" style="color:var(--mu);font-size:13px;flex-shrink:0;"></i>

  @* 1. Academic Year *@
  <select name="yearId" class="fs">
    <option value="">— Year —</option>
    @foreach (var y in years)
    {
      if (yearId == y.YearId) { <option value="@y.YearId" selected>@y.YearName @(y.IsCurrent?"✓":"")</option> }
      else                    { <option value="@y.YearId">@y.YearName @(y.IsCurrent?"✓":"")</option> }
    }
  </select>

  @* 2. Section / Medium *@
  <select name="sectionId" class="fs">
    <option value="">All Medium</option>
    @foreach (var s in sections)
    {
      if (sectionId == s.SectionId) { <option value="@s.SectionId" selected>@s.SectionName</option> }
      else                          { <option value="@s.SectionId">@s.SectionName</option> }
    }
  </select>

  @* 3. Class / Std *@
  <select name="classId" class="fs" id="sel_class" onchange="clearExam()">
    <option value="">— Std —</option>
    @foreach (var c in classes)
    {
      if (classId == c.ClassId) { <option value="@c.ClassId" selected>@c.ClassName</option> }
      else                      { <option value="@c.ClassId">@c.ClassName</option> }
    }
  </select>

  @* 4. Batch *@
  <select name="batchId" class="fs">
    <option value="">All Batches</option>
    @foreach (var b in batches)
    {
      if (batchId == b.BatchId) { <option value="@b.BatchId" selected>@b.BatchName</option> }
      else                      { <option value="@b.BatchId">@b.BatchName</option> }
    }
  </select>

  @* 5. Subject *@
  <select name="subjectId" class="fs">
    <option value="">All Subjects</option>
    @foreach (var sub in subjects)
    {
      if (subjectId == sub.SubjectId) { <option value="@sub.SubjectId" selected>@sub.SubjectName</option> }
      else                            { <option value="@sub.SubjectId">@sub.SubjectName</option> }
    }
  </select>

  @* 6. Student (optional – show individual result) *@
  <select name="studentId" class="fs" style="min-width:160px;">
    <option value="">All Students</option>
    @foreach (var s in students)
    {
      if (studentId == s.StudentId) { <option value="@s.StudentId" selected>@s.FullName (@(s.RollNo??""))</option> }
      else                          { <option value="@s.StudentId">@s.FullName (@(s.RollNo??""))</option> }
    }
  </select>

  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Search</button>
  <a href="/Marks/Report" class="btn btn-outline btn-sm"><i class="fas fa-times"></i></a>
</div>
</form>

@* ── Recent Tests pill strip ─────────────────────────────────── *@
@if (classId.HasValue && examList.Any())
{
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:12px;padding:10px 14px;background:var(--sur2);border-radius:var(--rs);border:1px solid var(--bdr);">
    <span style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;white-space:nowrap;">Recent Tests:</span>
    @foreach (var ex in examList.Take(12))
    {
      var isActive = examName == ex.ExamName;
      var exDate = ex.TestDate?.ToString("yyyy-MM-dd") ?? "";
      var href = $"/Marks/Report?yearId={yearId}&sectionId={sectionId}&classId={classId}&batchId={batchId}&subjectId={subjectId}&studentId={studentId}&examName={Uri.EscapeDataString(ex.ExamName)}&testDate={exDate}";
      <a href="@href" style="display:inline-flex;align-items:center;gap:4px;padding:4px 11px;border-radius:20px;font-size:12px;font-weight:700;text-decoration:none;transition:all .15s;
               background:@(isActive?"var(--p)":"var(--sur)");color:@(isActive?"#fff":"var(--txt)");border:1.5px solid @(isActive?"var(--p)":"var(--bdr)");">
        @ex.ExamName
        @if (ex.TestDate.HasValue){<span style="font-size:10px;opacity:.8;margin-left:2px;">@ex.TestDate.Value.ToString("dd MMM")</span>}
      </a>
    }
  </div>
}

@* ── Empty state ─────────────────────────────────────────────── *@
@if (!classId.HasValue)
{
  <div class="card"><div class="empty"><div class="empty-ico">📊</div>
    <h3>Select a Std to Load Report</h3>
    <p>Choose a Std and click Search. The most recent test will load automatically.</p>
  </div></div>
}
else if (!hasData && !string.IsNullOrWhiteSpace(examName))
{
  <div class="card"><div class="empty"><div class="empty-ico">📋</div>
    <h3>No Results Found</h3>
    <p>No marks recorded for <strong>@examName</strong> with the selected filters.</p>
  </div></div>
}
else if (!hasData)
{
  <div class="card"><div class="empty"><div class="empty-ico">📋</div>
    <h3>No Tests Found</h3>
    <p>No tests have been recorded for this class yet.</p>
  </div></div>
}
else
{
  @* ── Summary stats strip ─────────────────────────────────────── *@
  var allPcts = byStudent.Select(sg => {
      var t = sg.Sum(m => m.MarksObtained ?? 0);
      var mx = sg.Sum(m => m.MaxMarks);
      return mx > 0 ? (double)(t * 100 / mx) : 0;
  }).ToList();
  var avgPct    = allPcts.Any() ? allPcts.Average() : 0;
  var passCount = byStudent.Count(sg => sg.Any() && sg.All(m => m.MarksObtained.HasValue && m.Grade != "AB" && m.MaxMarks > 0 && (double)m.MarksObtained.Value * 100 / m.MaxMarks >= 35));
  <style>.rpt-kpi{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-bottom:16px;}
  @@media(max-width:768px){.rpt-kpi{grid-template-columns:repeat(3,1fr);gap:8px;}}
  @@media(max-width:480px){.rpt-kpi{grid-template-columns:repeat(2,1fr);}}
  .rpt-kpi .card{padding:10px 12px!important;}
  .rpt-kpi .kp-lbl{font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;white-space:nowrap;}
  .rpt-kpi .kp-val{font-size:20px;font-weight:800;}</style>
  <div class="rpt-kpi">
    <div class="card" style="border-top:3.5px solid var(--p);">
      <div class="kp-lbl">Students</div>
      <div class="kp-val" style="color:var(--txt);">@byStudent.Count</div>
    </div>
    <div class="card" style="border-top:3.5px solid var(--ok);">
      <div class="kp-lbl">Pass</div>
      <div class="kp-val" style="color:var(--ok);">@passCount</div>
    </div>
    <div class="card" style="border-top:3.5px solid var(--err);">
      <div class="kp-lbl">Fail / Absent</div>
      <div class="kp-val" style="color:var(--err);">@(byStudent.Count - passCount)</div>
    </div>
    <div class="card" style="border-top:3.5px solid var(--warn);">
      <div class="kp-lbl">Avg Score</div>
      <div class="kp-val" style="color:var(--warn);">@avgPct.ToString("0.1")%</div>
    </div>
    <div class="card" style="border-top:3.5px solid var(--inf);">
      <div class="kp-lbl">Pass Rate</div>
      <div class="kp-val" style="color:var(--inf);">@(byStudent.Count > 0 ? (passCount * 100 / byStudent.Count).ToString() : "0")%</div>
    </div>
  </div>

  @* ── Report header info ───────────────────────────────────────── *@
  <div class="card" style="padding:14px 18px;margin-bottom:14px;background:var(--sur2);">
    <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:center;">
      <div><span style="font-size:11px;font-weight:700;color:var(--mu);text-transform:uppercase;">Exam</span>
        <div style="font-size:15px;font-weight:800;color:var(--txt);">@examName</div></div>
      @if (!string.IsNullOrEmpty(displayDate))
      {<div><span style="font-size:11px;font-weight:700;color:var(--mu);text-transform:uppercase;">Date</span>
        <div style="font-size:15px;font-weight:800;color:var(--txt);">@displayDate</div></div>}
      @if (first != null)
      {<div><span style="font-size:11px;font-weight:700;color:var(--mu);text-transform:uppercase;">Std</span>
        <div style="font-size:15px;font-weight:800;color:var(--txt);">@first.ClassName @(first.SectionName != null ? "/ "+first.SectionName : "")</div></div>}
      @if (first?.YearName != null)
      {<div><span style="font-size:11px;font-weight:700;color:var(--mu);text-transform:uppercase;">Academic Year</span>
        <div style="font-size:15px;font-weight:800;color:var(--txt);">@first.YearName</div></div>}
      @{ var selSubName = subjectId.HasValue ? subjects.FirstOrDefault(s => s.SubjectId == subjectId)?.SubjectName : null; }
      @if (selSubName != null)
      {<div><span style="font-size:11px;font-weight:700;color:var(--mu);text-transform:uppercase;">Subject</span>
        <div style="font-size:15px;font-weight:800;color:var(--p);">@selSubName</div></div>}
    </div>
  </div>

  @if (isStudentView)
  {
    @* ── Individual Student View ──────────────────────────────────── *@
    var sg0   = byStudent.First();
    var sf0   = sg0.First();
    var tot0  = sg0.Sum(m => m.MarksObtained ?? 0);
    var max0  = sg0.Sum(m => m.MaxMarks);
    var pct0  = max0 > 0 ? (double)(tot0 * 100 / max0) : 0;
    var grd0  = pct0>=90?"A+":pct0>=80?"A":pct0>=70?"B+":pct0>=60?"B":pct0>=50?"C":pct0>=35?"D":"F";
    var pass0 = sg0.Any() && sg0.All(m => m.MarksObtained.HasValue && m.Grade != "AB" && m.MaxMarks > 0 && (double)m.MarksObtained.Value * 100 / m.MaxMarks >= 35);

    <div class="card" id="reportTable">
      <div class="card-hdr">
        <span class="card-ttl"><i class="fas fa-user" style="color:var(--p);margin-right:6px;"></i>@sf0.FullName</span>
        <div style="text-align:right;">
          <div style="font-size:22px;font-weight:800;color:var(--p);">@pct0.ToString("0.1")%</div>
          <div style="font-size:13px;font-weight:800;color:@(pass0?"var(--ok)":"var(--err)");">@grd0 — @(pass0?"PASS":"FAIL")</div>
        </div>
      </div>
      <div style="padding:10px 18px 8px;font-size:13px;color:var(--mu);">
        Adm: @sf0.AdmissionNo &nbsp;|&nbsp; Roll: @(sf0.RollNo??"—") &nbsp;|&nbsp; @sf0.ClassName
        @if (sf0.BatchName != null) { <text>&nbsp;|&nbsp; @sf0.BatchName</text> }
      </div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th><th>Subject</th><th style="text-align:center;">Marks</th>
              <th style="text-align:center;">Out of</th><th style="text-align:center;">%</th>
              <th style="text-align:center;">Grade</th><th style="text-align:center;">Result</th>
            </tr>
          </thead>
          <tbody>
          @{ int subi = 0; }
          @foreach (var mk in sg0.OrderBy(m => m.SubjectName))
          {
            subi++;
            var isAb = mk.Grade == "AB";
            var mp   = !isAb && mk.MaxMarks > 0 ? (double)(mk.MarksObtained ?? 0) * 100 / mk.MaxMarks : 0;
            var mg   = isAb ? "AB" : (mp>=90?"A+":mp>=80?"A":mp>=70?"B+":mp>=60?"B":mp>=50?"C":mp>=35?"D":"F");
            var mpass = !isAb && mk.MarksObtained.HasValue && mk.MaxMarks > 0 && (double)mk.MarksObtained.Value * 100 / mk.MaxMarks >= 35;
            var gc   = isAb ? "g-f" : (new[]{"A+","A"}.Contains(mg)?"g-ap":mg.StartsWith("B")?"g-b":mg=="C"?"g-c":mg=="D"?"g-d":"g-f");
            <tr>
              <td class="text-mu fw7">@subi</td>
              <td class="fw7">@mk.SubjectName</td>
              <td style="text-align:center;font-weight:800;@(isAb?"color:var(--err);":"")">@(isAb?"AB":mk.MarksObtained?.ToString("0")??"—")</td>
              <td style="text-align:center;">@mk.MaxMarks</td>
              <td style="text-align:center;font-weight:700;color:@(isAb?"var(--err)":mp>=50?"var(--ok)":"var(--err)")">@(isAb?"AB":mp.ToString("0")+"%")</td>
              <td style="text-align:center;"><span class="grade @gc">@mg</span></td>
              <td style="text-align:center;font-weight:800;color:@(mpass?"var(--ok)":"var(--err)")">@(isAb?"ABSENT":mpass?"PASS":"FAIL")</td>
            </tr>
          }
          <tr style="background:var(--sur2);font-weight:800;">
            <td colspan="2" style="color:var(--p);">TOTAL</td>
            <td style="text-align:center;">@tot0.ToString("0")</td>
            <td style="text-align:center;">@max0</td>
            <td style="text-align:center;color:@(pct0>=50?"var(--ok)":"var(--err)")">@pct0.ToString("0.1")%</td>
            <td style="text-align:center;"><span class="grade @(new[]{"A+","A"}.Contains(grd0)?"g-ap":grd0.StartsWith("B")?"g-b":grd0=="C"?"g-c":grd0=="D"?"g-d":"g-f")">@grd0</span></td>
            <td style="text-align:center;color:@(pass0?"var(--ok)":"var(--err)")">@(pass0?"PASS":"FAIL")</td>
          </tr>
          </tbody>
        </table>
      </div>
    </div>
  }
  else
  {
    @* ── Class-wise Summary Table ─────────────────────────────────── *@
    <div class="card" style="padding:0;" id="reportTable">
      <div class="card-hdr" style="padding:14px 18px;">
        <span class="card-ttl"><i class="fas fa-table" style="color:var(--p);margin-right:6px;"></i>Std Result — @examName</span>
        <span style="font-size:12px;color:var(--mu);">@byStudent.Count students · @subjectNames.Count subject(s)</span>
      </div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:40px;">#</th>
              <th style="width:70px;">Roll</th>
              <th>Student</th>
              @foreach (var sub in subjectNames)
              { <th style="text-align:center;min-width:70px;">@sub</th> }
              <th style="text-align:center;">Total</th>
              <th style="text-align:center;">Max</th>
              <th style="text-align:center;">%</th>
              <th style="text-align:center;">Grade</th>
              <th style="text-align:center;">Result</th>
            </tr>
          </thead>
          <tbody>
          @{ int rn = 0; }
          @foreach (var sg in byStudent)
          {
            rn++;
            var sf    = sg.First();
            var tot   = sg.Sum(m => m.MarksObtained ?? 0);
            var maxT  = sg.Sum(m => m.MaxMarks);
            var pct   = maxT > 0 ? (double)(tot * 100 / maxT) : 0;
            var grd   = pct>=90?"A+":pct>=80?"A":pct>=70?"B+":pct>=60?"B":pct>=50?"C":pct>=35?"D":"F";
            var pass  = sg.Any() && sg.All(m => m.MarksObtained.HasValue && m.Grade != "AB" && m.MaxMarks > 0 && (double)m.MarksObtained.Value*100/m.MaxMarks >= 35);
            var hasAb = sg.Any(m => m.Grade == "AB");
            var noMarks = sg.All(m => !m.MarksObtained.HasValue && m.Grade != "AB");
            var gc    = new[]{"A+","A"}.Contains(grd)?"g-ap":grd.StartsWith("B")?"g-b":grd=="C"?"g-c":grd=="D"?"g-d":"g-f";
            <tr>
              <td class="text-mu fw7">@rn</td>
              <td><span class="mono" style="font-size:12px;">@(sf.RollNo??"—")</span></td>
              <td>
                <div class="fw7">@sf.FullName</div>
                <div style="font-size:11px;" class="text-mu">@sf.AdmissionNo</div>
              </td>
              @foreach (var sub in subjectNames)
              {
                var mk   = sg.FirstOrDefault(m => m.SubjectName == sub);
                var isAb = mk?.Grade == "AB";
                <td style="text-align:center;font-weight:700;@(isAb?"color:var(--err);":"")">
                  @(isAb ? "AB" : mk?.MarksObtained?.ToString("0") ?? "—")
                </td>
              }
              <td style="text-align:center;font-weight:800;">@tot.ToString("0")</td>
              <td style="text-align:center;color:var(--mu);">@maxT</td>
              <td style="text-align:center;font-weight:800;color:@(pct>=50?"var(--ok)":"var(--err)")">@pct.ToString("0")%</td>
              <td style="text-align:center;"><span class="grade @gc">@grd</span></td>
              <td style="text-align:center;font-weight:800;color:@(noMarks?"var(--mu)":pass?"var(--ok)":"var(--err)")">@(noMarks?"—":hasAb?"ABSENT":pass?"PASS":"FAIL")</td>
            </tr>
          }
          </tbody>
          <tfoot>
            <tr style="background:var(--sur2);font-weight:800;border-top:2px solid var(--bdr);">
              <td colspan="3" style="padding:10px 12px;color:var(--p);">Std Average</td>
              @foreach (var sub in subjectNames)
              {
                var subAvg = Model.Where(m => m.SubjectName == sub && m.MarksObtained.HasValue && m.Grade != "AB").Select(m => (double)m.MarksObtained!.Value).ToList();
                <td style="text-align:center;color:var(--mu);">@(subAvg.Any() ? subAvg.Average().ToString("0.1") : "—")</td>
              }
              <td style="text-align:center;color:var(--p);">@avgPct.ToString("0.1")%</td>
              <td></td>
              <td style="text-align:center;color:var(--p);">@avgPct.ToString("0.1")%</td>
              <td></td>
              <td style="text-align:center;color:var(--ok);">@passCount/@byStudent.Count Pass</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  }
}

@* ── All Marks Entries Table (shows every TestMark row for the selected class) ── *@
@if (classId.HasValue && allMarks.Any())
{
  var byStudentAll = allMarks.GroupBy(m => m.StudentId).OrderBy(g => g.First().RollNo).ToList();
  <div class="card" style="padding:0;margin-top:22px;">
    <div class="card-hdr" style="padding:14px 18px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <span class="card-ttl">
        <i class="fas fa-list-alt" style="color:var(--p);margin-right:6px;"></i>
        All Marks Entries — @(allMarks.First().ClassName) @(allMarks.First().SectionName != null ? "/ "+allMarks.First().SectionName : "")
      </span>
      <span style="font-size:12px;color:var(--mu);">@byStudentAll.Count student(s) · @allMarks.Count entries total</span>
    </div>
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:36px;">#</th>
            <th style="width:55px;">Roll</th>
            <th>Student</th>
            <th style="text-align:center;width:62px;">Mark ID</th>
            <th>Subject</th>
            <th>Test / Exam</th>
            <th style="text-align:center;width:70px;">Date</th>
            <th style="text-align:center;width:64px;">Marks</th>
            <th style="text-align:center;width:50px;">Max</th>
            <th style="text-align:center;width:50px;">%</th>
            <th style="text-align:center;width:46px;">Grade</th>
            <th style="text-align:center;width:70px;">Result</th>
            <th style="width:120px;">Added By</th>
          </tr>
        </thead>
        <tbody>
        @{ int arow = 0; }
        @foreach (var sg in byStudentAll)
        {
          var sf = sg.First();
          bool firstRow = true;
          @foreach (var mk in sg.OrderBy(m => m.ExamName).ThenBy(m => m.SubjectName))
          {
            arow++;
            var isAb  = mk.Grade == "AB";
            var pctV  = !isAb && mk.MaxMarks > 0 ? (double)(mk.MarksObtained ?? 0) * 100 / mk.MaxMarks : 0;
            var grd   = isAb ? "AB" : (pctV>=90?"A+":pctV>=80?"A":pctV>=70?"B+":pctV>=60?"B":pctV>=50?"C":pctV>=35?"D":"F");
            var pass  = !isAb && mk.MarksObtained.HasValue && mk.MaxMarks > 0 && (double)mk.MarksObtained.Value*100/mk.MaxMarks >= 35;
            var gc    = isAb?"g-f":(new[]{"A+","A"}.Contains(grd)?"g-ap":grd.StartsWith("B")?"g-b":grd=="C"?"g-c":grd=="D"?"g-d":"g-f");
            <tr style="@(firstRow?"border-top:2px solid var(--bdr)":"")">
              <td class="text-mu fw7" style="font-size:11px;">@arow</td>
              <td><span class="mono" style="font-size:12px;">@(sf.RollNo??"—")</span></td>
              @if (firstRow)
              {
                <td rowspan="@sg.Count()" style="vertical-align:top;padding-top:10px;">
                  <div class="fw7">@sf.FullName</div>
                  <div style="font-size:11px;color:var(--mu);">@sf.AdmissionNo</div>
                  @if (sf.BatchName != null){<div style="font-size:11px;color:var(--mu);">@sf.BatchName</div>}
                </td>
              }
              <td style="text-align:center;">
                <span style="display:inline-block;padding:2px 7px;border-radius:4px;font-size:11px;font-weight:800;background:#f3f4f6;color:var(--mu);">#@mk.MarkId</span>
              </td>
              <td class="fw7" style="font-size:13px;">@mk.SubjectName
                @if (!string.IsNullOrWhiteSpace(mk.SubjectCode)){<span style="font-size:10px;color:var(--mu);margin-left:4px;">(@mk.SubjectCode)</span>}
              </td>
              <td style="font-size:13px;">@mk.ExamName
                <span style="font-size:10px;color:var(--mu);margin-left:4px;">[ID:@mk.ExamId]</span>
              </td>
              <td style="text-align:center;font-size:12px;color:var(--mu);">
                @(mk.TestDate.HasValue ? mk.TestDate.Value.ToString("dd MMM yy") : "—")
              </td>
              <td style="text-align:center;font-weight:800;@(isAb?"color:var(--err);":"")">
                @(isAb ? "AB" : mk.MarksObtained?.ToString("0") ?? "—")
              </td>
              <td style="text-align:center;color:var(--mu);">@mk.MaxMarks</td>
              <td style="text-align:center;font-weight:700;color:@(isAb?"var(--err)":pctV>=50?"var(--ok)":"var(--err)")">
                @(isAb ? "—" : pctV.ToString("0")+"%")
              </td>
              <td style="text-align:center;"><span class="grade @gc">@grd</span></td>
              <td style="text-align:center;font-weight:800;font-size:12px;color:@(isAb?"var(--err)":pass?"var(--ok)":"var(--err)")">
                @(isAb?"ABSENT":pass?"PASS":"FAIL")
              </td>
              <td style="font-size:12px;">@(mk.EnteredByName ?? "—")</td>
            </tr>
            firstRow = false;
          }
        }
        </tbody>
        <tfoot>
          <tr style="background:var(--sur2);font-weight:800;border-top:2px solid var(--bdr);">
            <td colspan="7" style="padding:10px 12px;color:var(--p);">Total Entries</td>
            <td colspan="5" style="padding:10px 12px;color:var(--mu);font-weight:600;">
              @allMarks.Count(m => m.MarksObtained.HasValue) marks entered &nbsp;·&nbsp;
              @allMarks.Count(m => m.Grade == "AB") absent &nbsp;·&nbsp;
              @allMarks.Count(m => m.MarksObtained.HasValue && m.MaxMarks > 0 && (double)m.MarksObtained.Value*100/m.MaxMarks >= 35) passed
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
}

<style>
.grade{display:inline-flex;width:28px;height:22px;align-items:center;justify-content:center;border-radius:5px;font-size:11px;font-weight:800;}
.g-ap,.g-a{background:#ecfdf5;color:#065f46;}
.g-b{background:#dbeafe;color:#1e40af;}
.g-c{background:#fffbeb;color:#92400e;}
.g-d{background:#ffedd5;color:#9a3412;}
.g-f{background:#fef2f2;color:#991b1b;}
@@media print {
  .topbar,.sidebar,.filter-bar,.pg-hdr .df,.pg-hdr button,.pg-hdr a { display:none!important; }
  .main { margin:0!important; padding:10px!important; }
  table { font-size:10px; }
}
</style>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
function clearExam() {
  document.getElementById('inp_examName').value = '';
  document.getElementById('inp_testDate').value = '';
}

function readTable() {
  var tbl = document.getElementById('reportTable');
  if (!tbl) return { head: [], rows: [] };
  var head = [], rows = [];
  tbl.querySelectorAll('thead tr th').forEach(th => head.push(th.innerText.trim()));
  tbl.querySelectorAll('tbody tr').forEach(tr => {
    var row = [];
    tr.querySelectorAll('td').forEach(td => row.push(td.innerText.trim().replace(/\n+/g,' ')));
    rows.push(row);
  });
  return { head, rows };
}

var EXAM_NAME  = '@Html.Raw(examName.Replace("'","\\'"))';
var CLASS_NAME = '@Html.Raw((first?.ClassName ?? "").Replace("'","\\'"))';

function exportExcel() {
  if (typeof XLSX === 'undefined') { alert('Excel library not loaded.'); return; }
  var d = readTable();
  if (!d.rows.length) { alert('No data to export.'); return; }
  var ws = XLSX.utils.aoa_to_sheet([d.head].concat(d.rows));
  var wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Test Report');
  XLSX.writeFile(wb, 'TestReport_' + EXAM_NAME + '_' + CLASS_NAME + '.xlsx');
}
</script>
}
