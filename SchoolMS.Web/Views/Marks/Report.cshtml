@{
    ViewData["Title"] = "Test Reports";
    int? yearId = ViewBag.YearId;
    var years = ViewBag.Years as List<SchoolMS.Domain.AcademicYear> ?? new();
}

<style>
    .subject-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        margin: 6px;
        background: var(--sur2);
        border: 1.5px solid var(--bdr);
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 14px;
        transition: all .2s;
    }
    .subject-pill:hover { border-color: var(--p); background: #f5f3ff; }
    .subject-pill.active { background: var(--p); color: #fff; border-color: var(--p); }

    .test-item {
        padding: 14px;
        margin-bottom: 8px;
        background: var(--sur2);
        border: 1px solid var(--bdr);
        border-radius: 6px;
        cursor: pointer;
        transition: all .2s;
    }
    .test-item:hover { border-color: var(--p); box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15); }

    .breadcrumb { margin-bottom: 20px; font-size: 13px; color: var(--mu); }
    .breadcrumb button { background: none; border: none; color: var(--p); cursor: pointer; font-weight: 600; }

    .marks-table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 600px; }
    .marks-table th { background: #f3f4f6; padding: 12px; text-align: left; font-weight: 700; border-bottom: 2px solid #e5e7eb; white-space: nowrap; }
    .marks-table td { padding: 10px 12px; border-bottom: 1px solid #e5e7eb; }
    .marks-table tr:hover { background: #f9fafb; }

    .top5-section { margin-top: 30px; padding-top: 20px; border-top: 2px solid #e5e7eb; }
    .top5-item { padding: 12px; margin-bottom: 8px; background: #fef3c7; border-left: 4px solid #f59e0b; border-radius: 4px; }
    .top5-rank { font-weight: 700; color: #f59e0b; font-size: 16px; }
</style>

<div class="pg-hdr">
    <div class="pg-row">
        <div>
            <h1>📊 Test Reports</h1>
            <p>Hierarchical view: Subject → Test → Marks & Top 5</p>
        </div>
        <div>
            <select id="yearSelect" class="fs" onchange="loadSubjects()">
                <option value="">— Select Year —</option>
                @foreach (var y in years)
                {
                    <option value="@y.YearId" selected="@(y.YearId == yearId)">@y.YearName @(y.IsCurrent?"✓":"")</option>
                }
            </select>
        </div>
    </div>
</div>

<!-- Level 1: Subjects -->
<div id="subjectsView">
    <div style="margin-bottom: 20px;">
        <h2 style="font-size: 18px; margin-bottom: 16px;">📚 Select a Subject</h2>
        <div id="subjectsList" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
    </div>
</div>

<!-- Level 2: Tests -->
<div id="testsView" style="display: none;">
    <div class="breadcrumb">
        <button onclick="goBack('subjects')">← Subjects</button> / <span id="selectedSubjectName"></span>
    </div>
    <div style="margin-bottom: 20px;">
        <h2 style="font-size: 18px; margin-bottom: 16px;">📅 Select a Test</h2>
        <div id="testsList"></div>
    </div>
</div>

<!-- Level 3: Marks & Top 5 -->
<div id="marksView" style="display: none;">
    <div class="breadcrumb">
        <button onclick="goBack('subjects')">← Subjects</button> /
        <button onclick="goBack('tests')" id="breadcrumbSubject"></button> /
        <span id="selectedTestInfo"></span>
    </div>

    <div class="card">
        <div class="card-hdr">
            <h3 style="margin: 0; font-size: 16px;">👥 Student Marks</h3>
        </div>
        <div style="overflow-x: auto;">
            <table class="marks-table">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Class</th>
                        <th>Batch</th>
                        <th style="text-align: center;">Obtained Marks</th>
                        <th style="text-align: center;">Total Marks</th>
                        <th style="text-align: center;">Grade</th>
                    </tr>
                </thead>
                <tbody id="marksTableBody"></tbody>
            </table>
        </div>
    </div>

    <div class="card top5-section">
        <div class="card-hdr">
            <h3 style="margin: 0; font-size: 16px;">🏆 Top 5 Students</h3>
        </div>
        <div id="top5List"></div>
    </div>
</div>

<script>
let currentYear = @yearId;
let currentSubjectId = null;
let currentSubjectName = "";
let currentExamName = "";
let currentClassId = null;

function loadSubjects() {
    currentYear = parseInt(document.getElementById('yearSelect').value) || @yearId;
    fetch(`/Marks/GetSubjectsWithTests?yearId=${currentYear}`)
        .then(r => r.json())
        .then(subjects => {
            const html = subjects.map(s =>
                `<button class="subject-pill" onclick="loadTests(${s.subjectId}, '${s.subjectName}')">${s.subjectName} (${s.testCount} tests)</button>`
            ).join('');
            document.getElementById('subjectsList').innerHTML = html || '<p style="color:#888;">No tests found for this year</p>';
            document.getElementById('testsView').style.display = 'none';
            document.getElementById('marksView').style.display = 'none';
            document.getElementById('subjectsView').style.display = 'block';
        })
        .catch(e => alert('Error: ' + e.message));
}

function loadTests(subjectId, subjectName) {
    currentSubjectId = subjectId;
    currentSubjectName = subjectName;
    fetch(`/Marks/GetTestsForSubject?subjectId=${subjectId}&yearId=${currentYear}`)
        .then(r => r.json())
        .then(tests => {
            const html = tests.map(t =>
                `<div class="test-item" onclick="loadMarks('${t.examName}', ${t.classId}, '${t.className}', '${t.testDate}')" style="cursor:pointer;">
                    <div style="font-weight:700;font-size:14px;">${t.examName}</div>
                    <div style="font-size:12px;color:#666;margin-top:4px;">${t.className} • ${t.testDate} • ${t.studentCount} students</div>
                </div>`
            ).join('');
            document.getElementById('testsList').innerHTML = html || '<p style="color:#888;">No tests found</p>';
            document.getElementById('selectedSubjectName').textContent = subjectName;
            document.getElementById('subjectsView').style.display = 'none';
            document.getElementById('testsView').style.display = 'block';
            document.getElementById('marksView').style.display = 'none';
        })
        .catch(e => alert('Error: ' + e.message));
}

function loadMarks(examName, classId, className, testDate) {
    currentExamName = examName;
    currentClassId = classId;
    fetch(`/Marks/GetTestMarksDetailed?examName=${encodeURIComponent(examName)}&classId=${classId}&subjectId=${currentSubjectId}&yearId=${currentYear}`)
        .then(r => r.json())
        .then(data => {
            const marks = data.marks || [];

            // Marks table
            const tableHtml = marks.map((m, i) =>
                `<tr>
                    <td>${m.fullName}</td>
                    <td>${m.className}</td>
                    <td>${m.batchName || '—'}</td>
                    <td style="text-align:center;font-weight:700;">${m.obtainedMarks || '—'}</td>
                    <td style="text-align:center;">${m.maxMarks}</td>
                    <td style="text-align:center;"><span class="grade" style="padding:4px 8px;border-radius:4px;font-weight:700;font-size:12px;">${m.grade}</span></td>
                </tr>`
            ).join('');
            document.getElementById('marksTableBody').innerHTML = tableHtml || '<tr><td colspan="6" style="text-align:center;color:#888;">No marks found</td></tr>';

            // Top 5
            const top5Html = marks.slice(0, 5).map((m, i) =>
                `<div class="top5-item">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <div>
                            <span class="top5-rank">#${i+1}</span> ${m.fullName}
                            <div style="font-size:12px;color:#666;margin-top:2px;">${m.className} • ${m.batchName}</div>
                        </div>
                        <div style="text-align:right;font-weight:700;">
                            ${m.obtainedMarks}/${m.maxMarks} <span style="font-size:12px;color:#666;">${m.grade}</span>
                        </div>
                    </div>
                </div>`
            ).join('');
            document.getElementById('top5List').innerHTML = top5Html || '<p style="color:#888;">No students found</p>';

            document.getElementById('selectedTestInfo').textContent = `${testDate}`;
            document.getElementById('breadcrumbSubject').textContent = currentSubjectName;
            document.getElementById('subjectsView').style.display = 'none';
            document.getElementById('testsView').style.display = 'none';
            document.getElementById('marksView').style.display = 'block';
        })
        .catch(e => alert('Error: ' + e.message));
}

function goBack(level) {
    if (level === 'subjects') {
        currentSubjectId = null;
        currentExamName = "";
        document.getElementById('subjectsView').style.display = 'block';
        document.getElementById('testsView').style.display = 'none';
        document.getElementById('marksView').style.display = 'none';
        loadSubjects();
    } else if (level === 'tests') {
        currentExamName = "";
        document.getElementById('testsView').style.display = 'block';
        document.getElementById('marksView').style.display = 'none';
    }
}

// Load subjects on page load
window.addEventListener('load', () => {
    const yearSelect = document.getElementById('yearSelect');
    if (yearSelect.value) {
        loadSubjects();
    }
});
</script>
