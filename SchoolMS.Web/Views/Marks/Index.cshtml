@model List<SchoolMS.Domain.StudentMarkRow>
@{
    ViewData["Title"] = "Test Marks Entry";
    var years    = ViewBag.Years    as List<SchoolMS.Domain.AcademicYear> ?? new();
    var classes  = ViewBag.Classes  as List<SchoolMS.Domain.Class>        ?? new();
    var sections = ViewBag.Sections as List<SchoolMS.Domain.Section>      ?? new();
    var batches  = ViewBag.Batches  as List<SchoolMS.Domain.Batch>        ?? new();
    var subjects = ViewBag.Subjects as List<SchoolMS.Domain.Subject>      ?? new();
    var examList = ViewBag.ExamList as List<SchoolMS.Domain.Exam>         ?? new();
    int? yearId    = ViewBag.YearId;
    int? classId   = ViewBag.ClassId;
    int? sectionId = ViewBag.SectionId;
    int? batchId   = ViewBag.BatchId;
    int? subjectId = ViewBag.SubjectId;
    string examName = ViewBag.ExamName ?? "";
    string testDate = ViewBag.TestDate ?? "";
    int maxMarks    = ViewBag.MaxMarks ?? 30;
    bool hasData    = Model != null && Model.Any();
    var cr = ViewBag.Cr as SchoolMS.Domain.CrScope;
    bool maxLocked = ViewBag.MaxLocked ?? false;
}

<div class="pg-hdr">
  <div class="pg-row">
    <div><h1>✏️ Test Marks Entry</h1><p>Add a new test, or pick a test below to enter / edit marks</p></div>
    @if (cr == null)
    {
      <div class="df g8"><button type="button" class="btn btn-primary" onclick="openNewTest()"><i class="fas fa-plus"></i> New Test</button></div>
    }
    @if (hasData && !string.IsNullOrWhiteSpace(examName) && cr == null)
    {
      <div class="df g8">
        <a href="/Marks/PrintResult?examName=@Uri.EscapeDataString(examName)&yearId=@yearId&classId=@classId&sectionId=@sectionId&batchId=@batchId&testDate=@Uri.EscapeDataString(testDate)"
           target="_blank" class="btn btn-outline"><i class="fas fa-print"></i> Print Result</a>
        <a href="/Marks/DownloadReport?examName=@Uri.EscapeDataString(examName)&yearId=@yearId&classId=@classId&sectionId=@sectionId&batchId=@batchId&testDate=@Uri.EscapeDataString(testDate)"
           class="btn btn-outline"><i class="fas fa-download"></i> Download CSV</a>
      </div>
    }
  </div>
</div>

@{
  var selectedDate = string.IsNullOrEmpty(testDate) ? DateTime.Today.ToString("yyyy-MM-dd") : testDate;
  var isToday = selectedDate == DateTime.Today.ToString("yyyy-MM-dd");
  var yesterdayStr = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
}

@* ── DATE SELECTOR ─────────────────────────────────────── *@
<div style="display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-bottom:16px;">
  <a href="?testDate=@DateTime.Today.ToString("yyyy-MM-dd")"
     style="display:inline-flex;align-items:center;justify-content:center;gap:6px;background:@(isToday ? "#1e40af" : "#e5e7eb");border:none;border-radius:20px;padding:8px 14px;font-size:12px;font-weight:700;color:@(isToday ? "#fff" : "#374151");text-decoration:none;transition:all .2s;cursor:pointer;"
     onmouseover="this.style.background='@(isToday ? "#1e3a8a" : "#d1d5db")';this.style.boxShadow='0 4px 12px rgba(30,64,175,.3)'"
     onmouseout="this.style.background='@(isToday ? "#1e40af" : "#e5e7eb")';this.style.boxShadow='none'">
    <i class="fas fa-calendar-day"></i> Today · @DateTime.Today.ToString("dd MMM")
  </a>
  <a href="?testDate=@yesterdayStr"
     style="display:inline-flex;align-items:center;justify-content:center;gap:6px;background:@(!isToday ? "#1e40af" : "#e5e7eb");border:none;border-radius:20px;padding:8px 14px;font-size:12px;font-weight:700;color:@(!isToday ? "#fff" : "#374151");text-decoration:none;transition:all .2s;cursor:pointer;"
     onmouseover="this.style.background='@(!isToday ? "#1e3a8a" : "#d1d5db")';this.style.boxShadow='0 4px 12px rgba(30,64,175,.3)'"
     onmouseout="this.style.background='@(!isToday ? "#1e40af" : "#e5e7eb")';this.style.boxShadow='none'">
    <i class="fas fa-calendar"></i> Yesterday · @DateTime.Today.AddDays(-1).ToString("dd MMM")
  </a>
</div>

@* ── ALL TESTS Grid ────────────────────────────────────────── *@
@if (examList.Any())
{
    <div style="margin-bottom:16px;">
        <div style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;
                    letter-spacing:.5px;margin-bottom:12px;">
            <i class="fas fa-file-alt" style="color:var(--p);margin-right:5px;"></i>
            All Tests — Click to Enter Marks
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">
            @foreach (var ex in examList.OrderByDescending(e => e.TestDate).ThenByDescending(e => e.ExamId))
            {
                var td = ex.TestDate?.ToString("yyyy-MM-dd") ?? "";
                var className = classes.FirstOrDefault(c => c.ClassId == ex.ClassId)?.ClassName ?? "Unknown";
                var displayDate = ex.TestDate?.ToString("dd MMM yyyy") ?? "N/A";

                <a href="/Marks/Index?yearId=@ex.AcademicYearId&classId=@ex.ClassId&sectionId=&batchId=&subjectId=&examName=@Uri.EscapeDataString(ex.ExamName)&testDate=@td&maxMarks=@(ex.MaxMarks ?? maxMarks)"
                   style="display:block;padding:14px;background:var(--sur2);border:1.5px solid var(--bdr);border-radius:8px;text-decoration:none;transition:all .2s;cursor:pointer;"
                   onmouseover="this.style.borderColor='var(--p)';this.style.boxShadow='0 4px 12px rgba(37,99,235,0.2)'"
                   onmouseout="this.style.borderColor='var(--bdr)';this.style.boxShadow='none'">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
                        <div style="font-weight:700;color:var(--txt);font-size:14px;">@ex.ExamName</div>
                        @if (ex.EntryCount > 0)
                        {
                            <span style="background:var(--p);color:#fff;padding:4px 8px;border-radius:99px;font-size:10px;font-weight:700;">@ex.EntryCount</span>
                        }
                    </div>
                    <div style="font-size:13px;color:var(--txt);font-weight:600;margin-bottom:4px;">@className</div>
                    <div style="font-size:11px;color:var(--mu);">
                        <i class="fas fa-calendar" style="margin-right:4px;"></i>@displayDate
                    </div>
                </a>
            }
        </div>
    </div>
}
@* ── Filter Bar ─────────────────────────────────────────────── *@
<form method="get" action="/Marks/Index" id="fltForm">
<div class="filter-bar" style="flex-wrap:wrap;gap:10px;">
  <i class="fas fa-filter" style="color:var(--mu);font-size:13px;flex-shrink:0;"></i>
  @if (cr != null)
  {
    <span style="background:#eef2ff;color:#3730a3;border-radius:20px;padding:7px 14px;font-size:13px;font-weight:800;"><i class="fas fa-user-shield"></i> Class Representative</span>
    <span style="font-size:14px;font-weight:700;">@cr.ClassName@(cr.SectionName != null ? " · " + cr.SectionName : "")@(cr.EffectiveBatchId != null ? " · " + cr.BatchName : "")</span>
    <span style="font-size:12px;color:var(--mu);">Tests of the last @SchoolMS.Domain.CrScope.MarksEditDays days.</span>
  }
  <div style="display:@(cr != null ? "none" : "contents");">
  <select name="yearId" class="fs" id="sel_year">
    <option value="">— Year —</option>
    @foreach (var y in years)
    {
      if (yearId == y.YearId) { <option value="@y.YearId" selected>@y.YearName @(y.IsCurrent ? "✓" : "")</option> }
      else                    { <option value="@y.YearId">@y.YearName @(y.IsCurrent ? "✓" : "")</option> }
    }
  </select>

  <select name="sectionId" class="fs" id="sel_section">
    <option value="">All Medium/Stream</option>
    @foreach (var s in sections)
    {
      if (sectionId == s.SectionId) { <option value="@s.SectionId" selected>@s.SectionName</option> }
      else                          { <option value="@s.SectionId">@s.SectionName</option> }
    }
  </select>

  <select name="classId" class="fs" id="sel_class" onchange="this.form.submit()">
    <option value="">All Std</option>
    @foreach (var c in classes)
    {
      if (classId == c.ClassId) { <option value="@c.ClassId" selected>@c.ClassName</option> }
      else                      { <option value="@c.ClassId">@c.ClassName</option> }
    }
  </select>

  <select name="batchId" class="fs" id="sel_batch">
    <option value="">All Batches</option>
    @foreach (var b in batches)
    {
      if (batchId == b.BatchId) { <option value="@b.BatchId" selected>@b.BatchName</option> }
      else                      { <option value="@b.BatchId">@b.BatchName</option> }
    }
  </select>

  </div>
  <select name="subjectId" class="fs" id="sel_subject">
    <option value="">All Subject</option>
    @foreach (var s in subjects)
    {
      if (subjectId == s.SubjectId) { <option value="@s.SubjectId" selected>@s.SubjectName</option> }
      else                          { <option value="@s.SubjectId">@s.SubjectName</option> }
    }
  </select>

  <input type="text" name="examName" id="inp_exam" value="@examName" class="fc"
         placeholder="Test name (e.g. Unit Test 1)" style="min-width:165px;"/>

  <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
    <label style="font-size:12px;font-weight:700;color:var(--mu);white-space:nowrap;">Date</label>
    <input type="date" name="testDate" id="inp_date" value="@testDate" class="fc" style="width:148px;"
           min="@(cr != null ? ((DateTime)ViewBag.CrEarliest).ToString("yyyy-MM-dd") : "")" max="@(cr != null ? DateTime.Today.ToString("yyyy-MM-dd") : "")"/>
  </div>

  <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
    <label style="font-size:12px;font-weight:700;color:var(--mu);white-space:nowrap;">Out of</label>
    <input type="number" name="maxMarks" id="inp_max" value="@maxMarks" class="fc"
           style="width:65px;@(maxLocked ? "background:#f3f4f6;" : "")" min="1" max="200" @(maxLocked ? "readonly title=\"This test already has marks, so its total cannot change\"" : "")/>
  </div>

  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Load</button>
  <a href="/Marks/Index" class="btn btn-outline btn-sm"><i class="fas fa-times"></i></a>
</div>
</form>

@* ── Subject Pills ─────────────────────────────────────────────── *@
@if (classId.HasValue && subjects.Any())
{
  <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;padding:12px;background:var(--sur2);border-radius:8px;border:1px solid var(--bdr);">
    <span style="font-size:11px;font-weight:800;color:var(--mu);text-transform:uppercase;white-space:nowrap;align-self:center;">Subjects:</span>
    @foreach (var sub in subjects)
    {
      var isActive = subjectId == sub.SubjectId && !string.IsNullOrWhiteSpace(examName);
      <a href="/Marks/Index?yearId=@yearId&sectionId=@sectionId&classId=@classId&batchId=@batchId&subjectId=@sub.SubjectId&examName=@Uri.EscapeDataString(examName??string.Empty)&testDate=@testDate&maxMarks=@maxMarks"
         style="display:inline-flex;align-items:center;gap:6px;background:@(isActive?"var(--p)":"var(--sur)");border:1.5px solid @(isActive?"var(--p)":"var(--bdr)");border-radius:20px;padding:8px 14px;font-size:12px;font-weight:700;color:@(isActive?"#fff":"var(--txt)");text-decoration:none;transition:all .2s;cursor:pointer;">
        @sub.SubjectName
      </a>
    }
  </div>
}

@* ── States ─────────────────────────────────────────────────── *@
@if (!examList.Any() && (subjectId == null || string.IsNullOrWhiteSpace(examName)))
{<div class="card"><div class="empty"><div class="empty-ico">📋</div><h3>No Tests Found</h3><p>No tests have been created for this academic year yet. Click <b>New Test</b> to add the first one.</p></div></div>}
else if (!subjects.Any())
{<div class="card"><div class="empty"><div class="empty-ico">📚</div><h3>No subjects found</h3><p>Add subjects in Academic Manager.</p></div></div>}
else if (subjectId == null || string.IsNullOrWhiteSpace(examName))
{<div class="card"><div class="empty"><div class="empty-ico">✏️</div><h3>Select Subject &amp; Test Name</h3><p>Pick a subject, enter the test name and date, then click Load.</p></div></div>}
else if (!hasData)
{<div class="card"><div class="empty"><div class="empty-ico">👥</div><h3>No students found</h3></div></div>}
else
{
  var entered   = Model!.Count(m => m.MarksObtained.HasValue);
  var absentCnt = Model!.Count(m => m.IsAbsent || m.Grade == "AB");
  var subName   = subjects.FirstOrDefault(s => s.SubjectId == subjectId)?.SubjectName ?? "";
  var yearName  = years.FirstOrDefault(y => y.YearId == yearId)?.YearName ?? "";

  @* Stats *@
  <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:16px;">
    <div class="card" style="padding:12px 16px;border-top:3.5px solid var(--p);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Students</div>
      <div style="font-size:22px;font-weight:800;color:var(--txt);">@Model!.Count</div>
    </div>
    <div class="card" style="padding:12px 16px;border-top:3.5px solid var(--ok);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Marks Entered</div>
      <div style="font-size:22px;font-weight:800;color:var(--ok);">@entered</div>
    </div>
    <div class="card" style="padding:12px 16px;border-top:3.5px solid var(--err);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Absent</div>
      <div style="font-size:22px;font-weight:800;color:var(--err);">@absentCnt</div>
    </div>
    <div class="card" style="padding:12px 16px;border-top:3.5px solid var(--warn);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Std Average</div>
      <div id="avgDisp" style="font-size:22px;font-weight:800;color:var(--warn);">
        @(entered > 0 ? Model!.Where(m=>m.MarksObtained.HasValue).Average(m=>(double)m.MarksObtained!.Value).ToString("0.1") : "—")
      </div>
    </div>
    <div class="card" style="padding:12px 16px;border-top:3.5px solid var(--ind);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;letter-spacing:.5px;">Pass Rate</div>
      <div id="passRate" style="font-size:22px;font-weight:800;color:var(--ind);">
        @{ var tot2 = entered + absentCnt; var pass2 = Model!.Count(m=>m.MarksObtained.HasValue && m.MarksObtained.Value*100/maxMarks>=35); }
        @(tot2 > 0 ? $"{pass2*100/tot2}%" : "—")
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-hdr">
      <div>
        <span class="card-ttl"><i class="fas fa-marker" style="color:var(--p);margin-right:6px;"></i>
          @examName — @subName — Out of @maxMarks
        </span>
        @if (!string.IsNullOrWhiteSpace(testDate))
        {<div style="font-size:12px;color:var(--mu);margin-top:2px;"><i class="fas fa-calendar" style="margin-right:4px;"></i>Test Date: @(DateTime.TryParse(testDate,out var td)?td.ToString("dd MMM yyyy"):testDate) &nbsp;|&nbsp; @yearName</div>}
      </div>
      <div class="df g8">
        <button class="btn btn-outline btn-sm" onclick="clearAll()"><i class="fas fa-eraser"></i> Clear</button>
      </div>
    </div>

    <div class="tbl-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:44px;">#</th>
          <th style="width:80px;">Roll No</th>
          <th>Student Name</th>
          <th>Std / Medium/Stream</th>
          <th>Batch</th>
          <th style="min-width:220px;">Marks Obtained (out of @maxMarks)</th>
          <th style="width:60px;">Grade</th>
          <th style="width:65px;">%</th>
        </tr>
      </thead>
      <tbody>
      @{ int idx = 0; }
      @foreach (var s in Model!.OrderBy(x=>x.RollNo).ThenBy(x=>x.FullName))
      {
        idx++;
        var isAb  = s.IsAbsent || s.Grade == "AB";
        var pctV  = (!isAb && s.MarksObtained.HasValue) ? (double)s.MarksObtained.Value*100/maxMarks : 0;
        var barW  = (!isAb && s.MarksObtained.HasValue) ? (int)pctV : 0;
        var gc    = s.Grade switch {"A+"=>"g-ap","A"=>"g-a","B+"=>"g-a","B"=>"g-b","C"=>"g-c","D"=>"g-d","F"=>"g-f","AB"=>"g-f",_=>""};
        <tr id="row-@s.StudentId" style="@(isAb?"background:#fff8f8;":"")">
          <td class="text-mu fw7" style="text-align:center;">@idx</td>
          <td><span class="mono" style="font-size:12px;">@(s.RollNo??"—")</span></td>
          <td>
            <div class="fw7">@s.FullName</div>
            <div style="font-size:11px;" class="text-mu">@s.AdmissionNo</div>
          </td>
          <td style="font-size:13px;">@s.ClassName / @s.SectionName</td>
          <td><span class="badge b-purple" style="font-size:11px;">@s.BatchName</span></td>
          <td>
            <div style="display:flex;align-items:center;gap:8px;">
              <input type="number" class="fc mk-inp"
                     style="width:75px;padding:7px 10px;text-align:center;font-weight:700;@(isAb?"opacity:.3;pointer-events:none;background:#fef2f2;":"")"
                     data-sid="@s.StudentId"
                     value="@((!isAb && s.MarksObtained.HasValue)?s.MarksObtained.Value.ToString("0.##"):"")"
                     min="0" max="@maxMarks" step="any" placeholder="—"
                     oninput="onMark(this,@maxMarks)"
                     @(isAb?"disabled":"")/>
              <div style="flex:1;height:6px;background:#f3f0ff;border-radius:3px;min-width:40px;">
                <div class="mk-bar" style="height:6px;border-radius:3px;background:linear-gradient(90deg,var(--p),var(--pk));width:@barW%;transition:width .2s;"></div>
              </div>
              <button type="button" class="ab-btn @(isAb?"ab-active":"")"
                      data-sid="@s.StudentId" onclick="toggleAbsent(this,@s.StudentId,@maxMarks)"
                      title="@(isAb?"Mark Present":"Mark Absent")"
                      style="flex-shrink:0;padding:5px 10px;border-radius:var(--rx);border:1.5px solid @(isAb?"#fca5a5":"var(--bdr)");background:@(isAb?"#fef2f2":"var(--sur2)");color:@(isAb?"#991b1b":"var(--mu)");font-size:11px;font-weight:800;cursor:pointer;font-family:inherit;white-space:nowrap;transition:all .15s;">
                @(isAb ? "AB ✕" : "AB")
              </button>
            </div>
          </td>
          <td><span class="grade @gc mk-grade" id="gr-@s.StudentId">@(isAb?"AB":s.Grade??"—")</span></td>
          <td><span class="mk-pct" id="pct-@s.StudentId"
                style="font-size:12.5px;font-weight:800;color:@(isAb?"var(--err)":s.MarksObtained.HasValue?(pctV>=50?"var(--ok)":"var(--err)"):"var(--mu2)");">
                @(isAb?"AB":s.MarksObtained.HasValue?$"{(int)pctV}%":"—")</span></td>
        </tr>
      }
      </tbody>
    </table>
    </div>

    <div style="padding:14px 16px;border-top:1px solid var(--bdr);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
      <span id="savedMsg" style="font-size:13px;"></span>
      <button class="btn btn-primary" onclick="saveMarks(this)"><i class="fas fa-save"></i> Save All Marks</button>
    </div>
  </div>
}

@* ── NEW TEST (modal) ───────────────────────────────────────── *@
@if (cr == null)
{
<style>
.nt-bg { position:fixed; inset:0; background:rgba(0,0,0,.5); display:none; align-items:center; justify-content:center; z-index:10000; padding:12px; }
.nt-bg.open { display:flex; }
.nt-box { background:var(--sur,#fff); border-radius:14px; width:100%; max-width:560px; max-height:92vh; overflow:auto; box-shadow:0 20px 60px rgba(0,0,0,.3); }
.nt-hdr { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--bdr); }
.nt-hdr h3 { margin:0; font-size:16px; font-weight:800; }
.nt-body { padding:18px 20px; display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.nt-body .full { grid-column:1 / -1; }
.nt-body label { display:block; font-size:11.5px; font-weight:800; color:var(--mu); text-transform:uppercase; letter-spacing:.4px; margin-bottom:5px; }
.nt-body .fc, .nt-body .fs { width:100%; }
.nt-chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
.nt-chip { border:1.5px solid var(--bdr); background:var(--sur2); border-radius:99px; padding:4px 11px; font-size:12px; font-weight:700; cursor:pointer; }
.nt-chip:hover { border-color:var(--p); color:var(--p); }
.nt-foot { padding:14px 20px; border-top:1px solid var(--bdr); display:flex; justify-content:flex-end; gap:10px; }
.nt-err { color:#b91c1c; font-size:12.5px; font-weight:700; padding:0 20px 12px; display:none; }
@@media (max-width:560px) { .nt-body { grid-template-columns:1fr; } }
</style>
<div class="nt-bg" id="ntBg" onclick="if(event.target===this)closeNewTest()">
  <div class="nt-box">
    <div class="nt-hdr"><h3><i class="fas fa-plus-circle" style="color:var(--p);margin-right:7px;"></i>Add New Test</h3>
      <button type="button" class="btn btn-outline btn-sm" onclick="closeNewTest()"><i class="fas fa-times"></i></button></div>
    <div class="nt-body">
      <div class="full">
        <label>Test name *</label>
        <input type="text" id="nt_name" class="fc" maxlength="100" placeholder="e.g. Unit Test 1, Weekly Test, Monthly Test"/>
      </div>
      <div>
        <label>Std *</label>
        <select id="nt_class" class="fs">
          <option value="">— Select —</option>
          @foreach (var c in classes) { <option value="@c.ClassId" selected="@(classId == c.ClassId)">@c.ClassName</option> }
        </select>
      </div>
      <div>
        <label>Subject *</label>
        <select id="nt_subject" class="fs">
          <option value="">— Select —</option>
          @foreach (var sb in subjects) { <option value="@sb.SubjectId" selected="@(subjectId == sb.SubjectId)">@sb.SubjectName</option> }
        </select>
      </div>
      <div>
        <label>Medium / Stream <span style="font-weight:600;text-transform:none;">(optional)</span></label>
        <select id="nt_section" class="fs">
          <option value="">All</option>
          @foreach (var sc in sections) { <option value="@sc.SectionId" selected="@(sectionId == sc.SectionId)">@sc.SectionName</option> }
        </select>
      </div>
      <div>
        <label>Batch <span style="font-weight:600;text-transform:none;">(optional)</span></label>
        <select id="nt_batch" class="fs">
          <option value="">All</option>
          @foreach (var b in batches) { <option value="@b.BatchId" selected="@(batchId == b.BatchId)">@b.BatchName</option> }
        </select>
      </div>
      <div>
        <label>Test date *</label>
        <input type="date" id="nt_date" class="fc" value="@DateTime.Today.ToString("yyyy-MM-dd")"/>
      </div>
      <div>
        <label>Total marks (out of) *</label>
        <input type="number" id="nt_max" class="fc" min="1" max="200" step="1" value="30"/>
        <div class="nt-chips">
          @foreach (var m in new[] { 10, 20, 25, 30, 40, 50, 100 }) { <span class="nt-chip" onclick="document.getElementById('nt_max').value=@m">@m</span> }
        </div>
      </div>
      <div class="full" style="font-size:12px;color:var(--mu);">
        Next you enter each student's <b>marks obtained</b> (or mark Absent) and press <b>Save All Marks</b>. Other subjects of the same test
        can be added afterwards from the subject buttons.
      </div>
    </div>
    <div class="nt-err" id="nt_err"></div>
    <div class="nt-foot">
      <button type="button" class="btn btn-outline" onclick="closeNewTest()">Cancel</button>
      <button type="button" class="btn btn-primary" onclick="startNewTest()"><i class="fas fa-arrow-right"></i> Start Entering Marks</button>
    </div>
  </div>
</div>
}

@section Scripts {
<script>
// ── New Test ──────────────────────────────────────────────────
const NT_EXAMS = @Json.Serialize(examList.Select(e => new { name = e.ExamName, classId = e.ClassId, year = e.AcademicYearId, max = e.MaxMarks, date = e.TestDate.HasValue ? e.TestDate.Value.ToString("yyyy-MM-dd") : "" }));
const NT_YEAR = @(yearId ?? 0);
function openNewTest() { const b = document.getElementById('ntBg'); if (b) { b.classList.add('open'); setTimeout(() => document.getElementById('nt_name').focus(), 50); } }
function closeNewTest() { const b = document.getElementById('ntBg'); if (b) b.classList.remove('open'); }
function ntError(t) { const e = document.getElementById('nt_err'); e.textContent = t; e.style.display = t ? 'block' : 'none'; }
function startNewTest() {
  const v = id => document.getElementById(id).value.trim();
  const name = v('nt_name'), cls = v('nt_class'), sub = v('nt_subject'), date = v('nt_date'), max = parseInt(v('nt_max'), 10);
  if (!name) return ntError('Please enter the test name.');
  if (!cls) return ntError('Please select the Std.');
  if (!sub) return ntError('Please select the subject.');
  if (!date) return ntError('Please select the test date.');
  if (!(max >= 1 && max <= 200)) return ntError('Total marks must be between 1 and 200.');
  ntError('');
  // A test is identified by its name + Std: re-using a name opens that test (and keeps its original total) instead of making a copy.
  const same = NT_EXAMS.find(e => e.name.toLowerCase() === name.toLowerCase() && String(e.classId) === cls);
  let useMax = max, useDate = date, useName = name;
  if (same) {
    if (!confirm('A test named "' + same.name + '" already exists for this Std' + (same.max ? ' (out of ' + same.max + ')' : '') + '. Open it and add or edit the marks for this subject?')) return;
    useName = same.name; if (same.max) useMax = same.max; if (same.date) useDate = same.date;
  }
  const q = new URLSearchParams({ yearId: NT_YEAR || '', classId: cls, sectionId: v('nt_section'), batchId: v('nt_batch'), subjectId: sub, examName: useName, testDate: useDate, maxMarks: useMax });
  window.location.href = '/Marks/Index?' + q.toString();
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeNewTest(); });
</script>

<style>
.mk-inp.mk-bad { border-color:#dc2626!important; background:#fef2f2!important; color:#991b1b; }
.ab-btn.ab-active { background:#fef2f2!important; color:#991b1b!important; border-color:#fca5a5!important; }
.ab-btn:hover:not(.ab-active) { background:#fef2f2!important; color:#991b1b!important; border-color:#fca5a5!important; }
</style>
<script>
const MAX_MARKS = @maxMarks;
const absentSet = new Set();

@if (hasData)
{
  @foreach(var s in Model!.Where(x => x.IsAbsent || x.Grade == "AB"))
  {<text>absentSet.add(@s.StudentId);</text>}
}

function calcGrade(p){if(p>=90)return'A+';if(p>=80)return'A';if(p>=70)return'B+';if(p>=60)return'B';if(p>=50)return'C';if(p>=35)return'D';return'F';}
function grCls(g){return{'A+':'g-ap','A':'g-a','B+':'g-a','B':'g-b','C':'g-c','D':'g-d','F':'g-f'}[g]||'';}

function toggleAbsent(btn, sid, max) {
  const isNow = !absentSet.has(sid);
  const inp  = document.querySelector(`.mk-inp[data-sid="${sid}"]`);
  const row  = document.getElementById('row-' + sid);
  const grEl = document.getElementById('gr-'  + sid);
  const pEl  = document.getElementById('pct-' + sid);
  const bar  = inp?.parentElement?.querySelector('.mk-bar');
  if (isNow) {
    absentSet.add(sid);
    if (inp) { inp.disabled=true; inp.style.cssText+='opacity:.3;pointer-events:none;background:#fef2f2;'; }
    if (bar) bar.style.width='0%';
    if (grEl){ grEl.textContent='AB'; grEl.className='grade g-f'; }
    if (pEl) { pEl.textContent='AB'; pEl.style.color='var(--err)'; }
    btn.textContent='AB ✕'; btn.classList.add('ab-active'); btn.title='Mark Present';
    if (row) row.style.background='#fff8f8';
  } else {
    absentSet.delete(sid);
    if (inp) { inp.disabled=false; inp.style.opacity='1'; inp.style.pointerEvents=''; inp.style.background=''; }
    const v = inp ? parseFloat(inp.value) : NaN;
    if (!isNaN(v)) setRow(inp, v, max);
    else { if(grEl){grEl.textContent='—';grEl.className='grade';} if(pEl){pEl.textContent='—';pEl.style.color='var(--mu2)';} }
    btn.textContent='AB'; btn.classList.remove('ab-active'); btn.title='Mark Absent';
    if (row) row.style.background='';
  }
  updateStats();
}

function onMark(inp, max) {
  if (absentSet.has(parseInt(inp.dataset.sid))) return;
  let v = parseFloat(inp.value);
  if (isNaN(v)) { setRow(inp,null,max); return; }
  // Never silently change what was typed (40 out of 25 must not become full marks): flag it and block Save until fixed.
  const bad = v > max || v < 0;
  inp.classList.toggle('mk-bad', bad);
  inp.title = bad ? 'Marks must be between 0 and ' + max : '';
  if (bad) { setRow(inp, null, max); return; }
  setRow(inp, v, max);
}
function setRow(inp, val, max) {
  const sid = inp.dataset.sid;
  const pct = val!==null ? val*100/max : null;
  const g   = pct!==null ? calcGrade(pct) : '—';
  const bar = inp.parentElement?.querySelector('.mk-bar');
  if (bar)  bar.style.width=(pct??0)+'%';
  const grEl=document.getElementById('gr-'+sid);
  if (grEl){ grEl.textContent=g; grEl.className='grade '+(pct!==null?grCls(g):''); }
  const pEl=document.getElementById('pct-'+sid);
  if (pEl) { pEl.textContent=pct!==null?Math.round(pct)+'%':'—'; pEl.style.color=pct===null?'var(--mu2)':pct>=50?'var(--ok)':'var(--err)'; }
  updateStats();
}
function updateStats() {
  const vals=[...document.querySelectorAll('.mk-inp')].filter(i=>!absentSet.has(parseInt(i.dataset.sid))).map(i=>parseFloat(i.value)).filter(v=>!isNaN(v));
  const total=vals.length+absentSet.size;
  document.getElementById('avgDisp').textContent=vals.length?(vals.reduce((a,b)=>a+b,0)/vals.length).toFixed(1):'—';
  document.getElementById('passRate').textContent=total?Math.round(vals.filter(v=>v*100/MAX_MARKS>=35).length*100/total)+'%':'—';
}
function clearAll(){if(!confirm('Clear all on-screen values?'))return;document.querySelectorAll('.mk-inp').forEach(i=>{if(!absentSet.has(parseInt(i.dataset.sid))){i.value='';setRow(i,null,MAX_MARKS);}});}

async function saveMarks(btn) {
  const badInp = document.querySelector('.mk-inp.mk-bad');
  if (badInp) { alert('Marks cannot be more than ' + MAX_MARKS + ' (or less than 0). Please correct the highlighted entry.'); badInp.focus(); return; }
  const entries=[];
  // Add absent students first
  absentSet.forEach(sid=>entries.push({studentId:sid,subjectId:@(subjectId??0),marks:0,isAbsent:true}));
  // Add ALL students who have a value in the marks input (including pre-filled existing marks)
  document.querySelectorAll('.mk-inp').forEach(i=>{
    const sid=parseInt(i.dataset.sid);
    if(absentSet.has(sid))return;
    const v=i.value.trim();
    if(v===''||isNaN(parseFloat(v)))return;
    entries.push({studentId:sid,subjectId:@(subjectId??0),marks:parseFloat(v),isAbsent:false});
  });
  if(!entries.length){alert('No marks or absent entries to save.\nEnter marks for at least one student first.');return;}

  btn.disabled=true; btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Saving...';
  const msg=document.getElementById('savedMsg');
  try {
    const res=await fetch('/Marks/Save',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        examName:@Json.Serialize(examName),
        classId:@(classId??0),
        yearId:@(yearId??0),
        maxMarks:MAX_MARKS,
        testDate:@Json.Serialize(string.IsNullOrWhiteSpace(testDate) ? null : testDate),
        entries
      })
    });
    if(!res.ok)throw new Error('HTTP '+res.status);
    const d=await res.json();
    const ac=entries.filter(e=>e.isAbsent).length, mk=entries.filter(e=>!e.isAbsent).length;
    msg.textContent=d.success?'✅ Saved: '+mk+' marks, '+ac+' absent':'❌ '+d.message;
    msg.style.color=d.success?'var(--ok)':'var(--err)';
    setTimeout(()=>msg.textContent='',8000);
  } catch(err) {
    msg.textContent='❌ Save failed: '+err.message;
    msg.style.color='var(--err)';
  } finally {
    btn.disabled=false;
    btn.innerHTML='<i class="fas fa-save"></i> Save All Marks';
  }
}
updateStats();
</script>
}
