@using SchoolMS.Web.Filters
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@ViewData["Title"] — RK Classes</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="~/css/app.css"/>
</head>
<body>

<aside class="sidebar">
  <div class="sb-brand">
    <img src="/images/rk-logo.png" alt="RK Classes"
         style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid var(--bdr2);flex-shrink:0;"/>
    <div>
      <div class="sb-appname">RK Classes</div>
      <div class="sb-apptag">School Management</div>
    </div>
  </div>

  <div class="nav-grp">
    <div class="nav-lbl">Overview</div>
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Dashboard"?"active":"")" href="/Dashboard/Index">
      <span class="nav-ic"><i class="fas fa-th-large"></i></span> Dashboard
    </a>
  </div>

  <div class="nav-grp">
    <div class="nav-lbl">Masters</div>
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Masters"?"active":"")" href="/Masters/Index">
      <span class="nav-ic"><i class="fas fa-database"></i></span> Masters Setup
    </a>
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Users"?"active":"")" href="/Users/Index">
      <span class="nav-ic"><i class="fas fa-users-cog"></i></span> Users &amp; Permissions
    </a>
  </div>

  <div class="nav-grp">
    <div class="nav-lbl">Faculty</div>
    @if(Context.Session.HasPerm("faculty_view")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Faculty" && ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")" href="/Faculty/Index">
      <span class="nav-ic"><i class="fas fa-chalkboard-teacher"></i></span> All Faculty
    </a>}
    @if(Context.Session.HasEditPerm("faculty_edit")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Faculty" && ViewContext.RouteData.Values["action"]?.ToString()=="Create"?"active":"")" href="/Faculty/Create">
      <span class="nav-ic"><i class="fas fa-user-plus"></i></span> Add Faculty
    </a>}
  </div>

  <div class="nav-grp">
    <div class="nav-lbl">Students</div>
    @if(Context.Session.HasPerm("student_view")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Student"?"active":"")" href="/Student/Index">
      <span class="nav-ic"><i class="fas fa-user-graduate"></i></span> All Students
    </a>}
    @if(Context.Session.HasEditPerm("student_edit")){
    <a class="nav-item" href="/Student/Create">
      <span class="nav-ic"><i class="fas fa-user-plus"></i></span> New Registration
    </a>}
  </div>

  <div class="nav-grp">
    <div class="nav-lbl">Academics</div>
    @if(Context.Session.HasPerm("attendance_entry")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Attendance" && ViewContext.RouteData.Values["action"]?.ToString()!="Report" && ViewContext.RouteData.Values["action"]?.ToString()!="DateGrid"?"active":"")" href="/Attendance/Index">
      <span class="nav-ic"><i class="fas fa-calendar-check"></i></span> Attendance
    </a>}
    @if(Context.Session.HasPerm("attendance_report")){
    <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString()=="Report"?"active":"")" href="/Attendance/Report">
      <span class="nav-ic"><i class="fas fa-chart-bar"></i></span> Att. Report
    </a>}
    @if(Context.Session.HasPerm("attendance_grid")){
    <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString()=="DateGrid"?"active":"")" href="/Attendance/DateGrid">
      <span class="nav-ic"><i class="fas fa-calendar-alt"></i></span> Date-wise Grid
    </a>}
    @if(Context.Session.HasPerm("marks_entry")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Marks" && ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")" href="/Marks/Index">
      <span class="nav-ic"><i class="fas fa-marker"></i></span> Test Marks Entry
    </a>}
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Marks" && ViewContext.RouteData.Values["action"]?.ToString()=="Report"?"active":"")" href="/Marks/Report">
      <span class="nav-ic"><i class="fas fa-chart-line"></i></span> Test Reports
    </a>
  </div>

  <div class="nav-grp">
    <div class="nav-lbl">Finance</div>
    @if(Context.Session.HasPerm("fee_structure")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="FeeStructure" && ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")" href="/FeeStructure/Index">
      <span class="nav-ic"><i class="fas fa-cog"></i></span> Fee Setup
    </a>}
    @if(Context.Session.HasPerm("fees_due")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="FeeStructure" && ViewContext.RouteData.Values["action"]?.ToString()=="FeesDue"?"active":"")" href="/FeeStructure/FeesDue">
      <span class="nav-ic"><i class="fas fa-list-alt"></i></span> Fees Due
    </a>}
    @if(Context.Session.HasPerm("fee_collection")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Fees" && ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")" href="/Fees/Index">
      <span class="nav-ic"><i class="fas fa-rupee-sign"></i></span> Fee Payments
    </a>}
    @if(Context.Session.HasPerm("fee_collect")){
    <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString()=="Collect"?"active":"")" href="/Fees/Collect">
      <span class="nav-ic"><i class="fas fa-plus-circle"></i></span> Collect Fee
    </a>}
    @if(Context.Session.HasPerm("expenses_view")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Expenses" && ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")" href="/Expenses/Index">
      <span class="nav-ic"><i class="fas fa-receipt"></i></span> Expenses
    </a>}
    @if(Context.Session.HasEditPerm("expenses_edit")){
    <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Expenses" && ViewContext.RouteData.Values["action"]?.ToString()=="Create"?"active":"")" href="/Expenses/Create">
      <span class="nav-ic"><i class="fas fa-plus-circle"></i></span> Add Expense
    </a>}
  </div>

  <div class="sb-foot">
    <div class="user-tile">
      <div class="u-av">@(Context.Session.GetString("FullName")?[0].ToString().ToUpper() ?? "A")</div>
      <div style="flex:1;min-width:0;">
        <div class="u-name">@Context.Session.GetString("FullName")</div>
        <div class="u-role">@Context.Session.GetString("RoleName")</div>
      </div>
      <a href="/Account/Logout" style="color:var(--mu);font-size:14px;" title="Logout">
        <i class="fas fa-sign-out-alt"></i>
      </a>
    </div>
  </div>
</aside>

<header class="topbar">
  <span class="tb-title">@ViewData["Title"]</span>
  <div class="tb-space"></div>
  <div class="tb-search">
    <i class="fas fa-search" style="font-size:12px;color:var(--mu2);"></i>
    <input type="text" placeholder="Quick search..."/>
  </div>
  <div class="tb-icon"><i class="fas fa-bell"></i><span class="nb-dot"></span></div>
  <div class="tb-icon"><i class="fas fa-cog"></i></div>
</header>

<span id="_ts" style="display:none">@TempData["Success"]</span>
<span id="_te" style="display:none">@TempData["Error"]</span>

<main class="main">
  @RenderBody()
</main>

<script src="~/js/app.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
