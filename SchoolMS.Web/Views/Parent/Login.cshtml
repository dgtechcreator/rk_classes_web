@model SchoolMS.Web.ViewModels.ParentLoginVM
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en" class="pg-parent">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Parent Login — RK Classes</title>
<link rel="icon" type="image/png" href="/icons/favicon.png?v=3"/>
<link rel="apple-touch-icon" href="/images/rk-circle-logo.png?v=4"/>
<meta name="theme-color" content="#ffffff"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<link rel="stylesheet" href="/css/login-new.css?v=5"/>
</head>
<body>

<!-- Top bar -->
<header class="topbar">
  <div class="topbar-in">
    <div class="brand">
      <img class="brand-logo" src="/images/login/logo.png" alt="RK Classes"/>
      <span class="brand-sep"></span>
      <div>
        <div class="brand-name">Ramjeet Kalavati Educational Institute</div>
        <div class="brand-tag">Education Today <i>|</i> A Brighter Tomorrow</div>
      </div>
    </div>
    <div class="since"><i class="fa-regular fa-calendar-days"></i><span>Since 2002</span></div>
  </div>
</header>

<main class="page">

  <img class="deco deco-bulb"   src="/images/login/idea-icon.png"       alt="" aria-hidden="true"/>
  <img class="deco deco-books"  src="/images/login/books.png"           alt="" aria-hidden="true"/>
  <img class="deco deco-plane"  src="/images/login/paper-plane.png"     alt="" aria-hidden="true"/>
  <img class="deco deco-school" src="/images/login/school-building.png" alt="" aria-hidden="true"/>
  <img class="deco deco-book"   src="/images/login/book-icon.png"       alt="" aria-hidden="true"/>

  <div class="shell">

    <!-- Left: welcome -->
    <section class="welcome">
      <div class="eyebrow">Parent / Guardian<br/>Portal</div>
      <img class="w-cap"  src="/images/login/graduation-cap.png" alt="" aria-hidden="true"/>
      <img class="w-dots" src="/images/login/dots-pattern.png"   alt="" aria-hidden="true"/>

      <div class="w-logo-wrap">
        <img class="w-logo" src="/images/login/logo.png" alt="RK Classes"/>
        <div class="est">EST. 2002</div>
      </div>

      <h2 class="w-title">Welcome to <br/><b>RK</b> Classes</h2>
      <p class="w-sub">Stay connected with your child's progress.</p>

      <div class="features">
        <div class="feat"><img src="/images/login/icon-student.png" alt=""/><span>Student<br/>Management</span></div>
        <div class="feat"><img src="/images/login/icon-fees.png" alt=""/><span>Attendance<br/>&amp; Fees</span></div>
        <div class="feat"><img src="/images/login/icon-academic.png" alt=""/><span>Academic<br/>Updates</span></div>
      </div>
    </section>

    <!-- Right: parent sign in / register -->
    <section class="signin">
      <div class="s-inner">
        <h1 class="s-title">Parent / Guardian Login</h1>
        <p class="s-sub">Track attendance, fees and results securely.</p>

        <div class="tabs" role="tablist">
          <button type="button" role="tab" class="tab @(Model.ShowRegister ? "" : "active")" id="tabLogin" onclick="switchTab('login')">
            <i class="fa-solid fa-right-to-bracket"></i> Login
          </button>
          <button type="button" role="tab" class="tab @(Model.ShowRegister ? "active" : "")" id="tabReg" onclick="switchTab('register')">
            <i class="fa-solid fa-user-plus"></i> Register
          </button>
        </div>

<div class="secs">
        <!-- LOGIN -->
        <div class="sec @(Model.ShowRegister ? "" : "active")" id="secLogin">
          @if (Model.Error != null)
          {<div class="err-box" role="alert"><i class="fas fa-exclamation-circle"></i><span>@Model.Error</span></div>}

          <form method="post" action="/Parent/Login" onsubmit="spin(this)">
            <div class="fld">
              <label for="lphone">Phone number</label>
              <div class="fld-box">
                <i class="fa-solid fa-phone fld-ico"></i>
                <input class="fld-in" type="tel" name="Phone" id="lphone" value="@Model.Phone"
                       placeholder="Father, mother or student phone number" required autocomplete="tel"/>
              </div>
            </div>
            <div class="fld">
              <label for="lpwd">Password</label>
              <div class="fld-box">
                <i class="fa-solid fa-lock fld-ico"></i>
                <input class="fld-in" type="password" name="Password" id="lpwd"
                       placeholder="Enter your password" required autocomplete="current-password"/>
                <button type="button" class="eye" onclick="toggleEye('lpwd','leye')" aria-label="Show or hide password">
                  <i class="fa-regular fa-eye" id="leye"></i>
                </button>
              </div>
            </div>
            <button type="submit" class="btn-main">
              <span class="btn-txt"><i class="fa-solid fa-right-to-bracket"></i>&nbsp;&nbsp;Login</span>
              <div class="spinner"></div>
            </button>
          </form>
          <div class="switch">New here? <a onclick="switchTab('register')">Register Now</a></div>
        </div>

        <!-- REGISTER -->
        <div class="sec @(Model.ShowRegister ? "active" : "")" id="secRegister">
          @if (Model.RegError != null)
          {<div class="err-box" role="alert"><i class="fas fa-exclamation-circle"></i><span>@Model.RegError</span></div>}

          <form method="post" action="/Parent/Register" onsubmit="spin(this)">
            <div class="fld">
              <label for="rphone">Phone number</label>
              <div class="fld-box">
                <i class="fa-solid fa-phone fld-ico"></i>
                <input class="fld-in" type="tel" name="RegPhone" id="rphone" value="@Model.RegPhone"
                       placeholder="Father, mother or student phone number" required autocomplete="tel"/>
              </div>
            </div>
            <div class="fld">
              <label for="rname">Your name <span style="font-weight:400;color:var(--muted)">(optional)</span></label>
              <div class="fld-box">
                <i class="fa-regular fa-user fld-ico"></i>
                <input class="fld-in" type="text" name="RegFullName" id="rname" value="@Model.RegFullName"
                       placeholder="Your name" autocomplete="name"/>
              </div>
            </div>
            <div class="fld">
              <label for="rpwd">Password</label>
              <div class="fld-box">
                <i class="fa-solid fa-lock fld-ico"></i>
                <input class="fld-in" type="password" name="RegPassword" id="rpwd"
                       placeholder="Set a password" required autocomplete="new-password"/>
                <button type="button" class="eye" onclick="toggleEye('rpwd','reye')" aria-label="Show or hide password">
                  <i class="fa-regular fa-eye" id="reye"></i>
                </button>
              </div>
            </div>
            <div class="fld">
              <label for="rpwd2">Confirm password</label>
              <div class="fld-box">
                <i class="fa-solid fa-lock fld-ico"></i>
                <input class="fld-in" type="password" name="RegPassword2" id="rpwd2"
                       placeholder="Confirm password" required autocomplete="new-password"/>
              </div>
            </div>
            <button type="submit" class="btn-main">
              <span class="btn-txt"><i class="fa-solid fa-user-plus"></i>&nbsp;&nbsp;Register</span>
              <div class="spinner"></div>
            </button>
          </form>
          <div class="switch">Already have an account? <a onclick="switchTab('login')">Login Now</a></div>
        </div>
        </div><!-- /secs -->

        <div class="p-links">
          <a class="back-staff" href="/Account/Login"><i class="fa-solid fa-arrow-left"></i> Staff Login</a>
        </div>

        <div class="contact">
          <span><i class="fas fa-phone"></i><strong>Phone</strong> 9870375795 / 8108499214</span>
          <span><i class="fas fa-envelope"></i><strong>Email</strong> rkclasseskapilsir2002@gmail.com</span>
        </div>

        <div class="secure">
          <small>&copy; @DateTime.Now.Year RK Classes</small>
        </div>
      </div>
    </section>

  </div>
</main>

<script src="/js/login-fit.js?v=1"></script>
<script>
function switchTab(t) {
  document.getElementById('secLogin').classList.toggle('active', t==='login');
  document.getElementById('secRegister').classList.toggle('active', t==='register');
  document.getElementById('tabLogin').classList.toggle('active', t==='login');
  document.getElementById('tabReg').classList.toggle('active', t==='register');
}
function toggleEye(fid, iid) {
  var f=document.getElementById(fid), i=document.getElementById(iid);
  f.type = f.type==='password'?'text':'password';
  i.className = f.type==='password'?'fa-regular fa-eye':'fa-regular fa-eye-slash';
}
function spin(form) {
  var btn = form.querySelector('.btn-main');
  if(btn){ btn.classList.add('loading'); setTimeout(function(){ btn.disabled=true; },0); }
}
</script>
</body>
</html>
