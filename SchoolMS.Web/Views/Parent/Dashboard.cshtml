@model SchoolMS.Web.ViewModels.ParentDashboardVM
@{
  Layout = "_ParentLayout";
  var sel = Model.SelectedChild;
  var activeTab = Model.ActiveTab ?? "attendance";
  ViewData["Title"] = sel != null ? sel.FullName : "Dashboard";
  ViewBag.SelectedStudentId = sel?.StudentId;
  ViewBag.ActiveTab = activeTab;
  ViewBag.SidebarChildren = Model.Children;

  // Pre-compute marks grouping to avoid nested @{} inside @if blocks
  var byExam = Model.Marks
      .GroupBy(m => new { m.ExamId, m.ExamName, Date = m.TestDate })
      .OrderByDescending(g => g.Key.Date)
      .ToList();

  // Pre-compute fees alert variables
  var showWarning = sel != null && Model.Balance > 0;
  var showSuccess = sel != null && !showWarning && Model.TotalPaid > 0;

  // Pre-compute class fees summary
  var classFeesSummary = (ViewBag.ClassFeesSummary ?? new List<dynamic>()) as List<dynamic> ?? new();
}

<style>
/* ── No children ── */
.no-child {
  background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
  padding: 60px 20px; text-align: center; color: #aaa;
}
.no-child i { font-size: 48px; display: block; margin-bottom: 14px; color: #ddd; }

/* ── Student info card ── */
.stu-card {
  background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
  margin-bottom: 20px; overflow: hidden;
}
.stu-card-head {
  background: linear-gradient(135deg, #1e3a5f 0%, #2d5a8e 100%);
  padding: 18px 22px; display: flex; align-items: center; gap: 16px; color: #fff;
}
.stu-av-lg {
  width: 58px; height: 58px; border-radius: 50%; flex-shrink: 0;
  object-fit: cover; border: 3px solid rgba(255,255,255,.4);
  background: rgba(255,255,255,.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; font-weight: 800; color: #fff;
}
.stu-av-lg img { width: 58px; height: 58px; border-radius: 50%; object-fit: cover; }
.stu-head-info h2 { font-size: 18px; font-weight: 800; margin-bottom: 3px; }
.stu-head-info p  { font-size: 12px; opacity: .8; margin-bottom: 2px; }
.stu-meta-row {
  display: grid; grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid #f0f0f0;
}
.stu-meta-item { padding: 11px 18px; border-right: 1px solid #f0f0f0; }
.stu-meta-item:last-child { border-right: none; }
.stu-meta-item .lbl { font-size: 10.5px; color: #999; margin-bottom: 3px; }
.stu-meta-item .val { font-size: 13.5px; font-weight: 700; color: #111; }

/* ── KPI strips ── */
.kpi-row {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 14px; margin-bottom: 20px;
}
.kpi-card {
  background: #fff; border: 1px solid #e5e7eb; border-radius: 10px;
  padding: 16px 14px; text-align: center;
}
.kpi-card .kv { font-size: 26px; font-weight: 800; color: #111; line-height: 1; }
.kpi-card .kl { font-size: 11px; color: #888; margin-top: 5px; }
.kpi-card.green .kv { color: #15803d; }
.kpi-card.red   .kv { color: #dc2626; }
.kpi-card.amber .kv { color: #b45309; }

/* ── Fee KPIs ── */
.fee-kpi-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin-bottom: 20px; }
.fee-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:18px 14px; text-align:center; }
.fee-kpi .kv { font-size:24px; font-weight:800; }
.fee-kpi .kl { font-size:11px; color:#888; margin-top:5px; }

/* ── Alert box ── */
.alert-warn {
  background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px;
  padding: 11px 16px; font-size: 13px; color: #92400e; font-weight: 600;
  margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
}
.alert-ok {
  background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;
  padding: 11px 16px; font-size: 13px; color: #15803d; font-weight: 600;
  margin-bottom: 16px; display: flex; align-items: center; gap: 8px;
}

/* ── Table ── */
.pp-table-wrap { background:#fff; border:1px solid #e5e7eb; border-radius:10px; overflow-x:auto; margin-bottom:16px; }
.pp-table { width:100%; border-collapse:collapse; font-size:13px; min-width:600px; }
.pp-table thead tr { background:#f8f9fa; }
.pp-table thead th { padding:10px 14px; text-align:left; font-weight:700; color:#333; border-bottom:2px solid #e5e7eb; white-space:nowrap; }
.pp-table tbody td { padding:9px 14px; border-bottom:1px solid #f0f0f0; color:#333; }
.pp-table tbody tr:last-child td { border-bottom:none; }
.pp-table tfoot td { padding:9px 14px; font-weight:700; background:#f8f9fa; border-top:2px solid #e5e7eb; }
.pp-empty { text-align:center; padding:36px; color:#bbb; font-size:13px; }
.pp-empty i { font-size:32px; display:block; margin-bottom:10px; }

/* ── Badges ── */
.badge { border-radius:5px; padding:2px 9px; font-size:11px; font-weight:700; }
.badge-present { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
.badge-absent  { background:#fff5f5; color:#dc2626; border:1px solid #fecaca; }
.badge-late    { background:#fffbeb; color:#b45309; border:1px solid #fde68a; }
.badge-pass    { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
.badge-fail    { background:#fff5f5; color:#dc2626; border:1px solid #fecaca; }

/* ── Marks exam group ── */
.exam-group { margin-bottom:20px; }
.exam-title {
  background:#f8f9fa; border:1px solid #e5e7eb; border-bottom:none;
  border-radius:8px 8px 0 0; padding:10px 16px;
  display:flex; align-items:center; justify-content:space-between;
}
.exam-title .en { font-size:14px; font-weight:800; color:#1e3a5f; }
.exam-title .ed { font-size:11px; color:#888; margin-top:2px; }
.exam-title .ep { font-size:13px; font-weight:800; }

/* ── Section title ── */
.sec-title { font-size:15px; font-weight:800; color:#111; margin-bottom:14px; display:flex; align-items:center; gap:8px; }
.sec-title i { color:#cc0000; }

@@media (max-width:700px) {
  .kpi-row { grid-template-columns: repeat(2,1fr); }
  .fee-kpi-row { grid-template-columns: repeat(3,1fr); }
  .stu-meta-row { grid-template-columns: 1fr 1fr; }
}
@@media (max-width:480px) {
  .kpi-row { grid-template-columns: repeat(2,1fr); gap:10px; }
  .fee-kpi-row { grid-template-columns: repeat(3,1fr); gap:8px; }
  .stu-card-head { padding:14px 14px; }
  .stu-head-info h2 { font-size:16px; }
}

/* Marks hierarchy styles */
.marks-subject-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  margin: 6px;
  background: #f3f4f6;
  border: 1.5px solid #e5e7eb;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
  font-size: 13px;
  transition: all .2s;
}
.marks-subject-pill:hover { border-color: #2563eb; background: #f5f3ff; }
.marks-subject-pill.active { background: #2563eb; color: #fff; border-color: #2563eb; }

.marks-breadcrumb { margin-bottom: 16px; font-size: 13px; color: #666; }
.marks-breadcrumb button { background: none; border: none; color: #2563eb; cursor: pointer; font-weight: 600; }

.marks-top5-item { padding: 12px; margin-bottom: 8px; background: #fef3c7; border-left: 4px solid #f59e0b; border-radius: 4px; }
.marks-top5-rank { font-weight: 700; color: #f59e0b; font-size: 16px; }
</style>

@if (!Model.Children.Any())
{
  <div class="no-child">
    <i class="fas fa-child"></i>
    <div style="font-size:16px;font-weight:700;margin-bottom:6px;">No students found</div>
    <div style="font-size:13px;">Your phone number does not match any student record.<br/>Contact the school to update parent contact details.</div>
  </div>
}
else if (sel == null)
{
  <div class="no-child">
    <i class="fas fa-arrow-left"></i>
    <div style="font-size:15px;font-weight:700;">Select a child from the sidebar</div>
  </div>
}
else
{
  @* ── Student info card ── *@
  <div class="stu-card">
    <div class="stu-card-head">
      @if (!string.IsNullOrEmpty(sel.ProfilePicPath))
      {<div class="stu-av-lg"><img src="@sel.ProfilePicPath" alt="@sel.FullName"/></div>}
      else
      {<div class="stu-av-lg">@(sel.FullName?.Length > 0 ? sel.FullName[0].ToString().ToUpper() : "?")</div>}
      <div class="stu-head-info">
        <h2>@sel.FullName.ToUpper()</h2>
        <p>@(sel.ClassName ?? "—") &nbsp;·&nbsp; @(sel.SectionName ?? "—") @if(!string.IsNullOrEmpty(sel.BatchName)){<text>&nbsp;·&nbsp; @sel.BatchName</text>}</p>
        <p>Adm: @sel.AdmissionNo &nbsp;|&nbsp; Year: @(sel.YearName ?? "—")</p>
      </div>
    </div>
    <div class="stu-meta-row">
      <div class="stu-meta-item"><div class="lbl">Father</div><div class="val">@(sel.FatherName ?? "—")</div></div>
      <div class="stu-meta-item"><div class="lbl">Mother</div><div class="val">@(sel.MotherName ?? "—")</div></div>
      <div class="stu-meta-item"><div class="lbl">Roll No</div><div class="val">@(sel.RollNo ?? "—")</div></div>
    </div>
  </div>

  @* ══════════════════════ ATTENDANCE ══════════════════════ *@
  @if (activeTab == "attendance")
  {
    <div class="sec-title"><i class="fas fa-calendar-check"></i> Attendance Summary</div>

    @if (Model.Attendance != null)
    {
      var att = Model.Attendance;
      <div class="kpi-row">
        <div class="kpi-card green">
          <div class="kv">@att.AttendancePct.ToString("0.0")%</div>
          <div class="kl">Attendance %</div>
        </div>
        <div class="kpi-card green">
          <div class="kv">@att.PresentDays</div>
          <div class="kl">Present Days</div>
        </div>
        <div class="kpi-card red">
          <div class="kv">@att.AbsentDays</div>
          <div class="kl">Absent Days</div>
        </div>
        <div class="kpi-card amber">
          <div class="kv">@att.LateDays</div>
          <div class="kl">Late Days</div>
        </div>
      </div>
    }

    @if (Model.AttDetail.Any())
    {
      <div class="sec-title" style="margin-top:4px;"><i class="fas fa-list"></i> Attendance Detail</div>
      <div class="pp-table-wrap">
        <table class="pp-table">
          <thead><tr>
            <th>Date</th><th>Status</th><th>Subject</th><th>Teacher</th>
          </tr></thead>
          <tbody>
            @foreach (var d in Model.AttDetail.OrderByDescending(x => x.AttendanceDate))
            {
              <tr>
                <td>@d.AttendanceDate.ToString("dd MMM yyyy")</td>
                <td>
                  @if(d.Status=="Present"){<span class="badge badge-present">Present</span>}
                  else if(d.Status=="Absent"){<span class="badge badge-absent">Absent</span>}
                  else{<span class="badge badge-late">@d.Status</span>}
                </td>
                <td>@(d.Subject ?? "—")</td>
                <td>@(d.SirName ?? "—")</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
    else if (Model.Attendance == null || Model.Attendance.TotalDays == 0)
    {
      <div class="pp-table-wrap"><div class="pp-empty"><i class="fas fa-calendar-times"></i>No attendance records yet</div></div>
    }
  }

  @* ══════════════════════ MARKS ══════════════════════ *@
  @if (activeTab == "marks")
  {
    <div class="sec-title"><i class="fas fa-chart-bar"></i> Test Marks</div>

    @if (!byExam.Any())
    {
      <div class="pp-table-wrap"><div class="pp-empty"><i class="fas fa-chart-bar"></i>No marks records yet</div></div>
    }
    else
    {
      <!-- Level 1: Subject Selection -->
      <div id="marksSubjectsView">
        <h3 style="font-size:14px;margin-bottom:12px;">📚 Select a Subject</h3>
        <div id="marksSubjectsList" style="display:flex;flex-wrap:wrap;"></div>
      </div>

      <!-- Level 2: Subject Marks & Top 5 -->
      <div id="marksDetailsView" style="display:none;">
        <div class="marks-breadcrumb">
          <button onclick="goBackMarks()">← Subjects</button> / <span id="selectedMarksSubject"></span>
        </div>

        <div class="pp-table-wrap">
          <table class="pp-table">
            <thead><tr>
              <th>Exam</th><th style="text-align:right">Marks</th><th style="text-align:right">Out of</th><th style="text-align:right">%</th><th>Grade</th><th>Result</th>
            </tr></thead>
            <tbody id="marksDetailsBody"></tbody>
          </table>
        </div>

        <div style="margin-top:20px;padding-top:20px;border-top:2px solid #e5e7eb;">
          <h3 style="font-size:14px;margin-bottom:12px;">🏆 Top 5 Students in this Subject</h3>
          <div id="marksTop5List"></div>
        </div>
      </div>
    }
  }

  <script>
  let marksData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.Marks.GroupBy(m => m.SubjectName)
      .Select(g => new {
        subjectName = g.Key,
        marks = g.GroupBy(x => new { x.ExamName, x.TestDate })
          .Select(eg => new {
            examName = eg.Key.ExamName,
            testDate = eg.Key.TestDate,
            items = eg.ToList()
          }).ToList()
      }).ToList()
  ));

  const studentId = @(Model.SelectedChild?.StudentId ?? 0);

  function loadMarksSubjects() {
    const html = marksData.map(s =>
      `<button class="marks-subject-pill" onclick="loadMarksForSubject('${s.subjectName}')">${s.subjectName}</button>`
    ).join('');
    document.getElementById('marksSubjectsList').innerHTML = html || '<p style="color:#888;">No subjects found</p>';
  }

  function loadMarksForSubject(subjectName) {
    const subj = marksData.find(m => m.subjectName === subjectName);
    if (!subj) return;

    // Show marks table for current student
    const tableHtml = subj.marks.map(exam =>
      `<tr>
        <td style="font-weight:600;">${exam.examName}</td>
        <td style="text-align:right;font-weight:700;">${exam.items[0].MarksObtained ?? '—'}</td>
        <td style="text-align:right;">${exam.items[0].MaxMarks}</td>
        <td style="text-align:right;">${exam.items[0].MarksObtained && exam.items[0].MaxMarks > 0 ? ((exam.items[0].MarksObtained * 100 / exam.items[0].MaxMarks).toFixed(1)) + '%' : '—'}</td>
        <td><strong>${exam.items[0].Grade ?? '—'}</strong></td>
        <td><span class="badge ${exam.items[0].Grade === 'AB' ? 'badge-late' : exam.items[0].MarksObtained >= (exam.items[0].MaxMarks * 0.35) ? 'badge-pass' : 'badge-fail'}">${exam.items[0].Grade === 'AB' ? 'Absent' : exam.items[0].MarksObtained >= (exam.items[0].MaxMarks * 0.35) ? 'Pass' : 'Fail'}</span></td>
      </tr>`
    ).join('');
    document.getElementById('marksDetailsBody').innerHTML = tableHtml;

    // Fetch top 5 students from API
    fetch(`/Parent/GetTop5ForSubject?studentId=${studentId}&subjectName=${encodeURIComponent(subjectName)}`)
      .then(r => r.json())
      .then(data => {
        if (!data.top5 || data.top5.length === 0) {
          document.getElementById('marksTop5List').innerHTML = '<p style="color:#888;">No data available</p>';
          return;
        }
        const top5Html = data.top5.map((s, i) => {
          const grade = s.grade || '—';
          return `<div class="marks-top5-item">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;">
              <div>
                <div style="font-weight:700;font-size:14px;"><span class="marks-top5-rank">#${i+1}</span> ${s.fullName || '—'}</div>
                <div style="font-size:12px;color:#666;margin-top:4px;">${s.className || ''}</div>
              </div>
              <div style="text-align:right;font-weight:700;font-size:15px;">
                ${s.marksObtained || '—'}/${s.maxMarks || '—'} <span style="font-size:12px;color:#666;">${grade}</span>
              </div>
            </div>
          </div>`;
        }).join('');
        document.getElementById('marksTop5List').innerHTML = top5Html;
      })
      .catch(e => {
        console.error('Error:', e);
        document.getElementById('marksTop5List').innerHTML = '<p style="color:#888;">Error loading data</p>';
      });

    document.getElementById('marksSubjectsView').style.display = 'none';
    document.getElementById('marksDetailsView').style.display = 'block';
    document.getElementById('selectedMarksSubject').textContent = subjectName;
  }

  function goBackMarks() {
    document.getElementById('marksSubjectsView').style.display = 'block';
    document.getElementById('marksDetailsView').style.display = 'none';
  }

  loadMarksSubjects();
  </script>

  @* ══════════════════════ FEES ══════════════════════ *@
  @if (activeTab == "fees")
  {
    <div class="sec-title"><i class="fas fa-rupee-sign"></i> Fee Details</div>
    <div class="fee-kpi-row">
      <div class="fee-kpi">
        <div class="kv" style="color:#1e3a5f;">₹@Model.ActualFee.ToString("N0")</div>
        <div class="kl">Total Fee</div>
      </div>
      <div class="fee-kpi">
        <div class="kv" style="color:#15803d;">₹@Model.TotalPaid.ToString("N0")</div>
        <div class="kl">Paid</div>
      </div>
      <div class="fee-kpi">
        <div class="kv" style="color:#dc2626;">₹@(Math.Max(0,Model.Balance).ToString("N0"))</div>
        <div class="kl">Balance Due</div>
      </div>
    </div>

    @if (showWarning)
    {
      <div class="alert-warn"><i class="fas fa-exclamation-triangle"></i> Balance of ₹@Model.Balance.ToString("N0") is due. Please contact the school.</div>
    }
    else if (showSuccess)
    {
      <div class="alert-ok"><i class="fas fa-check-circle"></i> All fees paid. No balance due.</div>
    }

    @if (classFeesSummary.Any())
    {
        <div style="margin-top:24px;">
            <div class="sec-title"><i class="fas fa-users"></i> Class Fees Summary (All Students)</div>
            <div class="pp-table-wrap">
                <table class="pp-table">
                    <thead><tr>
                        <th>Student Name</th>
                        <th>Admission No</th>
                        <th style="text-align:right;">Total Fees Owed</th>
                        <th style="text-align:right;">Collected</th>
                        <th style="text-align:right;">Discount</th>
                        <th style="text-align:right;">Balance</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var student in classFeesSummary)
                        {
                            <tr>
                                <td style="font-weight:600;">@student.StudentName</td>
                                <td style="color:#666;font-size:12px;">@student.AdmissionNo</td>
                                <td style="text-align:right;font-weight:600;color:#1e3a5f;">₹@student.TotalFeesOwed.ToString("N0")</td>
                                <td style="text-align:right;font-weight:600;color:#15803d;">₹@student.TotalCollected.ToString("N0")</td>
                                <td style="text-align:right;font-weight:600;color:#f59e0b;">₹@student.TotalDiscount.ToString("N0")</td>
                                <td style="text-align:right;font-weight:600;color:@(student.Balance > 0 ? "#dc2626" : "#15803d");">₹@student.Balance.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr style="background:#f3f4f6;font-weight:700;border-top:2px solid #e5e7eb;">
                        <td colspan="2">Total</td>
                        <td style="text-align:right;">₹@classFeesSummary.Sum(s => (decimal)s.TotalFeesOwed).ToString("N0")</td>
                        <td style="text-align:right;">₹@classFeesSummary.Sum(s => (decimal)s.TotalCollected).ToString("N0")</td>
                        <td style="text-align:right;">₹@classFeesSummary.Sum(s => (decimal)s.TotalDiscount).ToString("N0")</td>
                        <td style="text-align:right;">₹@classFeesSummary.Sum(s => (decimal)s.Balance).ToString("N0")</td>
                    </tr></tfoot>
                </table>
            </div>
        </div>
    }

    @if (Model.FeeHistory.Any())
    {
      <div class="pp-table-wrap">
        <table class="pp-table">
          <thead><tr>
            <th>Receipt No</th><th>Date</th><th style="text-align:right">Amount Paid</th><th>Mode</th><th>Remarks</th><th style="width:100px;text-align:center">Action</th>
          </tr></thead>
          <tbody>
            @foreach (var f in Model.FeeHistory.OrderByDescending(x => x.PaymentDate))
            {
              <tr>
                <td style="font-weight:700;color:#2563eb;">@f.ReceiptNo</td>
                <td>@f.PaymentDate.ToString("dd/MM/yyyy")</td>
                <td style="text-align:right;font-weight:700;color:#15803d;">₹@f.NetAmount.ToString("N0")</td>
                <td>@f.PaymentMode</td>
                <td style="color:#666;font-size:12px;">@(f.Remarks ?? "—")</td>
                <td style="text-align:center;">
                  <a href="/Fees/Receipt/@f.PaymentId" target="_blank" style="display:inline-flex;align-items:center;gap:6px;background:#f3f0ff;color:#2563eb;border:none;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:600;text-decoration:none;cursor:pointer;white-space:nowrap;"><i class="fas fa-print"></i> Receipt</a>
                </td>
              </tr>
            }
          </tbody>
          <tfoot><tr>
            <td colspan="2">Total Paid</td>
            <td style="text-align:right;color:#15803d;font-size:15px;">₹@Model.TotalPaid.ToString("N0")</td>
            <td colspan="2"></td>
          </tr></tfoot>
        </table>
      </div>
    }
    else
    {<div class="pp-table-wrap"><div class="pp-empty"><i class="fas fa-receipt"></i>No payment records yet</div></div>}
  }
}
