@{
    ViewData["Title"] = "Attendance Batches";
    var classes = ViewBag.Classes as List<SchoolMS.Domain.Class> ?? new();
    var sections = ViewBag.Sections as List<SchoolMS.Domain.Section> ?? new();
    var batches = ViewBag.Batches as List<SchoolMS.Domain.Batch> ?? new();
}

<style>
    .batch-filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .batch-form { max-width: 500px; margin-bottom: 24px; }
    .students-grid { display: grid; gap: 12px; max-height: 500px; overflow-y: auto; }
    .student-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; }
    .student-item input[type="checkbox"] { width: 20px; height: 20px; cursor: pointer; }
    .student-info { flex: 1; }
    .student-info .name { font-weight: 700; font-size: 14px; }
    .student-info .details { font-size: 12px; color: #666; margin-top: 2px; }
    .batch-actions { display: flex; gap: 12px; margin-top: 20px; }
    @media (max-width: 768px) {
        .batch-filters { grid-template-columns: 1fr; }
        .students-grid { max-height: 300px; }
    }
</style>

<div class="pg-hdr">
    <div class="pg-row">
        <div>
            <h1>📋 Create Attendance Batches</h1>
            <p>Select students and create attendance batches for quick marking</p>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{<div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>}

<div class="card batch-form">
    <div class="card-hdr">
        <span class="card-ttl"><i class="fas fa-plus-circle" style="color:var(--p);margin-right:6px;"></i>New Attendance Batch</span>
    </div>

    <div style="margin-bottom: 16px;">
        <label style="font-weight: 700; margin-bottom: 8px; display: block;">Batch Name *</label>
        <input type="text" id="batchName" placeholder="e.g., 9TH ENGLISH MORNING" class="fc" style="width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 6px;"/>
    </div>

    <div class="batch-filters">
        <div>
            <label style="font-weight: 700; margin-bottom: 6px; display: block; font-size: 13px;">Class / Standard *</label>
            <select id="classId" class="fs" onchange="loadStudents()">
                <option value="">— Select Class —</option>
                @foreach (var c in classes)
                {
                    <option value="@c.ClassId">@c.ClassName</option>
                }
            </select>
        </div>
        <div>
            <label style="font-weight: 700; margin-bottom: 6px; display: block; font-size: 13px;">Medium</label>
            <select id="sectionId" class="fs" onchange="loadStudents()">
                <option value="">— Select Medium —</option>
                @foreach (var s in sections)
                {
                    <option value="@s.SectionId">@s.SectionName</option>
                }
            </select>
        </div>
        <div>
            <label style="font-weight: 700; margin-bottom: 6px; display: block; font-size: 13px;">Batch</label>
            <select id="batchId" class="fs" onchange="loadStudents()">
                <option value="">— Select Batch —</option>
                @foreach (var b in batches)
                {
                    <option value="@b.BatchId">@b.BatchName</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-hdr">
        <span class="card-ttl"><i class="fas fa-users" style="color:var(--p);margin-right:6px;"></i>Select Students</span>
        <div style="display: flex; gap: 12px; align-items: center;">
            <label style="display: flex; align-items: center; gap: 8px; margin: 0; cursor: pointer;">
                <input type="checkbox" id="selectAllChk" onchange="toggleSelectAll()" style="width: 20px; height: 20px;"/>
                <span style="font-weight: 700; font-size: 13px;">Select All</span>
            </label>
            <span id="studentCount" style="font-size: 13px; color: #666;">0 students</span>
        </div>
    </div>

    <div id="studentsList" class="students-grid">
        <div style="padding: 20px; text-align: center; color: #999;">
            Select class and filters above to view students
        </div>
    </div>

    <div class="batch-actions">
        <button class="btn btn-primary" onclick="createBatch()">
            <i class="fas fa-save"></i> Create Batch
        </button>
        <button class="btn btn-outline" onclick="resetForm()">
            <i class="fas fa-redo"></i> Reset
        </button>
    </div>
</div>

<script>
let selectedStudents = [];

async function loadStudents() {
    const classId = document.getElementById('classId').value;
    const sectionId = document.getElementById('sectionId').value;
    const batchId = document.getElementById('batchId').value;

    if (!classId) {
        document.getElementById('studentsList').innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">Please select a class</div>';
        return;
    }

    try {
        const response = await fetch(`/Masters/GetStudentsForBatch?classId=${classId}&sectionId=${sectionId || ''}&batchId=${batchId || ''}`);
        const students = await response.json();

        if (!students || students.length === 0) {
            document.getElementById('studentsList').innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">No students found</div>';
            return;
        }

        const html = students.map(s => `
            <div class="student-item">
                <input type="checkbox" class="student-checkbox" value="${s.studentId}" onchange="updateCount()"/>
                <div class="student-info">
                    <div class="name">${s.fullName}</div>
                    <div class="details">${s.admissionNo} • ${s.className}${s.sectionName ? ' • ' + s.sectionName : ''}${s.batchName ? ' • ' + s.batchName : ''}</div>
                </div>
            </div>
        `).join('');

        document.getElementById('studentsList').innerHTML = html;
        document.getElementById('selectAllChk').checked = false;
        updateCount();
    } catch (error) {
        document.getElementById('studentsList').innerHTML = `<div style="padding: 20px; color: #d32f2f;">${error.message}</div>`;
    }
}

function toggleSelectAll() {
    const isChecked = document.getElementById('selectAllChk').checked;
    document.querySelectorAll('.student-checkbox').forEach(chk => chk.checked = isChecked);
    updateCount();
}

function updateCount() {
    const selected = document.querySelectorAll('.student-checkbox:checked').length;
    const total = document.querySelectorAll('.student-checkbox').length;
    document.getElementById('studentCount').textContent = `${selected} of ${total} selected`;
}

async function createBatch() {
    const batchName = document.getElementById('batchName').value.trim();
    const selectedIds = Array.from(document.querySelectorAll('.student-checkbox:checked')).map(chk => parseInt(chk.value));

    if (!batchName) {
        alert('Please enter batch name');
        return;
    }

    if (selectedIds.length === 0) {
        alert('Please select at least one student');
        return;
    }

    try {
        const response = await fetch('/Masters/CreateAttendanceBatch', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                batchName: batchName,
                studentIds: selectedIds
            })
        });

        const result = await response.json();
        if (result.success) {
            alert(result.message);
            resetForm();
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

function resetForm() {
    document.getElementById('batchName').value = '';
    document.getElementById('classId').value = '';
    document.getElementById('sectionId').value = '';
    document.getElementById('batchId').value = '';
    document.getElementById('selectAllChk').checked = false;
    document.getElementById('studentsList').innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">Select class and filters above to view students</div>';
    document.getElementById('studentCount').textContent = '0 students';
}
</script>
