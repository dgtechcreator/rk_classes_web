@using SchoolMS.Domain;
@{
    ViewData["Title"] = "Attendance Batches";
    var classes = ViewBag.Classes as List<Class> ?? new();
    var sections = ViewBag.Sections as List<Section> ?? new();
    var batches = ViewBag.Batches as List<Batch> ?? new();
    var attendanceBatches = ViewBag.AttendanceBatches as List<AttendanceBatch> ?? new();
}

<style>
    .batch-filters { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .batch-form { width: 100%; margin-bottom: 24px; }
    .students-grid { display: grid; gap: 12px; }
    .student-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; }
    .student-item input[type="checkbox"] { width: 20px; height: 20px; cursor: pointer; }
    .student-info { flex: 1; }
    .student-info .name { font-weight: 700; font-size: 14px; }
    .student-info .details { font-size: 12px; color: #666; margin-top: 2px; }
    .batch-actions { display: flex; gap: 12px; margin-top: 20px; }

    .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; margin-top: 40px; }
    .summary-card { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border-radius: 8px; padding: 20px; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .summary-card.card2 { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
    .summary-card.card3 { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
    .summary-value { font-size: 28px; font-weight: 800; margin-bottom: 6px; }
    .summary-label { font-size: 12px; opacity: 0.9; text-transform: uppercase; letter-spacing: 1px; }

    .batches-table { width: 100%; border-collapse: collapse; background: #fff; }
    .batches-table thead { background: #f3f4f6; }
    .batches-table th { padding: 12px 16px; text-align: left; font-weight: 700; color: #374151; font-size: 13px; text-transform: uppercase; border-bottom: 2px solid #e5e7eb; }
    .batches-table td { padding: 14px 16px; border-bottom: 1px solid #e5e7eb; color: #374151; }
    .batches-table tbody tr:hover { background-color: #f9fafb; }
    .batch-name-cell { font-weight: 600; color: #1f2937; }
    .batch-actions-cell { display: flex; gap: 8px; }
    .btn-icon { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; transition: all 0.2s; }
    .btn-edit { background: #dbeafe; color: #1e40af; }
    .btn-edit:hover { background: #bfdbfe; transform: translateY(-2px); box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
    .btn-delete { background: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background: #fecaca; transform: translateY(-2px); box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
    .no-batches { text-align: center; padding: 30px; color: #9ca3af; background: #f9fafb; border-radius: 8px; }
    .date-small { font-size: 12px; color: #9ca3af; margin-top: 2px; }
    .student-count-badge { background: #eff6ff; color: #1e40af; padding: 4px 10px; border-radius: 4px; font-weight: 600; font-size: 12px; display: inline-block; }

    @@media (max-width: 768px) {
        .batch-filters { grid-template-columns: 1fr; }
        .batches-table { font-size: 12px; }
        .batches-table th, .batches-table td { padding: 8px; }
    }
</style>

<div class="pg-hdr">
    <div class="pg-row">
        <div>
            <h1>📋 Create Attendance Batches</h1>
            <p>Select students and create attendance batches for quick marking</p>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{<div class="alert alert-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>}
@if (TempData["Error"] != null)
{<div class="alert alert-danger"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>}

<div class="card batch-form">
    <div class="card-hdr">
        <span class="card-ttl"><i class="fas fa-plus-circle" style="color:var(--p);margin-right:6px;"></i>New Attendance Batch</span>
    </div>

    <div style="margin-bottom: 20px;">
        <label style="font-weight: 700; margin-bottom: 10px; display: block; font-size: 14px;">Batch Name * <span style="color: #999; font-weight: 400; font-size: 12px;">(Required - e.g., 9TH ENGLISH MORNING)</span></label>
        <input type="text" id="batchName" placeholder="e.g., 9TH ENGLISH MORNING" class="fc" style="width: 100%; padding: 12px 14px; border: 2px solid #e5e7eb; border-radius: 8px; font-size: 15px; font-weight: 500;"/>
    </div>

    <div class="batch-filters">
        <div>
            <label style="font-weight: 700; margin-bottom: 6px; display: block; font-size: 13px;">Class / Standard *</label>
            <select id="classId" class="fs" onchange="loadStudents()">
                <option value="">— Select Class —</option>
                @foreach (var c in classes)
                {
                    <option value="@c.ClassId">@c.ClassName</option>
                }
            </select>
        </div>
        <div>
            <label style="font-weight: 700; margin-bottom: 6px; display: block; font-size: 13px;">Medium</label>
            <select id="sectionId" class="fs" onchange="loadStudents()">
                <option value="">— Select Medium —</option>
                @foreach (var s in sections)
                {
                    <option value="@s.SectionId">@s.SectionName</option>
                }
            </select>
        </div>
        <div>
            <label style="font-weight: 700; margin-bottom: 6px; display: block; font-size: 13px;">Batch</label>
            <select id="batchId" class="fs" onchange="loadStudents()">
                <option value="">— Select Batch —</option>
                @foreach (var b in batches)
                {
                    <option value="@b.BatchId">@b.BatchName</option>
                }
            </select>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-hdr">
        <span class="card-ttl"><i class="fas fa-users" style="color:var(--p);margin-right:6px;"></i>Select Students</span>
        <div style="display: flex; gap: 12px; align-items: center;">
            <label style="display: flex; align-items: center; gap: 8px; margin: 0; cursor: pointer;">
                <input type="checkbox" id="selectAllChk" onchange="toggleSelectAll()" style="width: 20px; height: 20px;"/>
                <span style="font-weight: 700; font-size: 13px;">Select All</span>
            </label>
            <span id="studentCount" style="font-size: 13px; color: #666;">0 students</span>
        </div>
    </div>

    <div id="studentsList" class="students-grid">
        <div style="padding: 20px; text-align: center; color: #999;">
            Select class and filters above to view students
        </div>
    </div>

    <div class="batch-actions">
        <button class="btn btn-primary" onclick="createBatch()" style="padding: 12px 24px; font-size: 14px; font-weight: 700;">
            <i class="fas fa-save"></i> Create Batch
        </button>
        <button class="btn btn-outline" onclick="resetForm()" style="padding: 12px 24px; font-size: 14px;">
            <i class="fas fa-redo"></i> Reset
        </button>
    </div>
</div>

<!-- Summary Section -->
<div class="summary-grid">
    <div class="summary-card">
        <div class="summary-value">@attendanceBatches.Count</div>
        <div class="summary-label">Total Batches</div>
    </div>
    <div class="summary-card card2">
        <div class="summary-value">@attendanceBatches.Sum(b => b.StudentCount)</div>
        <div class="summary-label">Total Students</div>
    </div>
    <div class="summary-card card3">
        <div class="summary-value">@(attendanceBatches.Count > 0 ? (attendanceBatches.Sum(b => b.StudentCount) / attendanceBatches.Count).ToString("F0") : "0")</div>
        <div class="summary-label">Avg Students/Batch</div>
    </div>
</div>

<!-- Existing Batches Section -->
<div class="card">
    <div class="card-hdr">
        <span class="card-ttl"><i class="fas fa-list" style="color:var(--p);margin-right:6px;"></i>Existing Attendance Batches</span>
    </div>

    @if (attendanceBatches.Any())
    {
        <div style="overflow-x: auto;">
            <table class="batches-table">
                <thead>
                    <tr>
                        <th style="width: 35%;">Batch Name</th>
                        <th style="width: 15%;">Students</th>
                        <th style="width: 30%;">Created</th>
                        <th style="width: 20%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var batch in attendanceBatches.OrderByDescending(b => b.CreatedAt))
                    {
                        <tr>
                            <td><span class="batch-name-cell">@batch.BatchName</span></td>
                            <td><span class="student-count-badge">@batch.StudentCount</span></td>
                            <td>
                                <div>@batch.CreatedAt.ToString("dd MMM yyyy")</div>
                                <div class="date-small">@batch.CreatedAt.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="batch-actions-cell">
                                    <a href="/Masters/EditAttendanceBatch?batchId=@batch.BatchId" class="btn-icon btn-edit" title="Edit batch">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form method="post" action="/Masters/DeleteAttendanceBatch" style="display:inline;">
                                        <input type="hidden" name="batchId" value="@batch.BatchId"/>
                                        <button type="submit" class="btn-icon btn-delete" onclick="return confirm('Delete this batch? This cannot be undone.')" title="Delete batch">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="no-batches">
            <i class="fas fa-inbox" style="font-size: 48px; margin-bottom: 12px; display: block;"></i>
            <p style="font-size: 15px; font-weight: 600;">No batches created yet</p>
            <p style="font-size: 13px; margin-top: 6px; color: #9ca3af;">Create a batch above to get started</p>
        </div>
    }
</div>

<script>
let selectedStudents = [];

async function loadStudents() {
    const classId = document.getElementById('classId').value;
    const sectionId = document.getElementById('sectionId').value;
    const batchId = document.getElementById('batchId').value;

    if (!classId) {
        document.getElementById('studentsList').innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">Please select a class</div>';
        return;
    }

    try {
        const response = await fetch(`/Masters/GetStudentsForBatch?classId=${classId}&sectionId=${sectionId || ''}&batchId=${batchId || ''}`);
        const students = await response.json();

        if (!students || students.length === 0) {
            document.getElementById('studentsList').innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">No students found</div>';
            return;
        }

        const html = students.map(s => `
            <div class="student-item">
                <input type="checkbox" class="student-checkbox" value="${s.studentId}" onchange="updateCount()"/>
                <div class="student-info">
                    <div class="name">${s.fullName}</div>
                    <div class="details">${s.admissionNo} • ${s.className}${s.sectionName ? ' • ' + s.sectionName : ''}${s.batchName ? ' • ' + s.batchName : ''}</div>
                </div>
            </div>
        `).join('');

        document.getElementById('studentsList').innerHTML = html;
        document.getElementById('selectAllChk').checked = false;
        updateCount();
    } catch (error) {
        document.getElementById('studentsList').innerHTML = `<div style="padding: 20px; color: #d32f2f;">${error.message}</div>`;
    }
}

function toggleSelectAll() {
    const isChecked = document.getElementById('selectAllChk').checked;
    document.querySelectorAll('.student-checkbox').forEach(chk => chk.checked = isChecked);
    updateCount();
}

function updateCount() {
    const selected = document.querySelectorAll('.student-checkbox:checked').length;
    const total = document.querySelectorAll('.student-checkbox').length;
    document.getElementById('studentCount').textContent = `${selected} of ${total} selected`;
}

async function createBatch() {
    const batchName = document.getElementById('batchName').value.trim();
    const selectedIds = Array.from(document.querySelectorAll('.student-checkbox:checked')).map(chk => parseInt(chk.value));

    if (!batchName) {
        alert('Please enter batch name');
        return;
    }

    if (selectedIds.length === 0) {
        alert('Please select at least one student');
        return;
    }

    try {
        const response = await fetch('/Masters/CreateAttendanceBatch', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                batchName: batchName,
                studentIds: selectedIds
            })
        });

        const result = await response.json();
        if (result.success) {
            alert(result.message);
            resetForm();
        } else {
            alert('Error: ' + result.message);
        }
    } catch (error) {
        alert('Error: ' + error.message);
    }
}

function resetForm() {
    document.getElementById('batchName').value = '';
    document.getElementById('classId').value = '';
    document.getElementById('sectionId').value = '';
    document.getElementById('batchId').value = '';
    document.getElementById('selectAllChk').checked = false;
    document.getElementById('studentsList').innerHTML = '<div style="padding: 20px; text-align: center; color: #999;">Select class and filters above to view students</div>';
    document.getElementById('studentCount').textContent = '0 students';
}
</script>
