@model SchoolMS.Web.ViewModels.StudentListVM
@{ ViewData["Title"] = "Students"; }

<div class="pg-hdr">
  <div class="pg-row">
    <div><h1>👨‍🎓 Students</h1><p>@Model.Total students registered</p></div>
    <div class="df g8">
      <a href="/Student/ExportExcel?search=@Model.Search&classId=@Model.ClassFilter&sectionId=@Model.SectionFilter&batchId=@Model.BatchFilter&status=@Model.StatusFilter"
         class="btn btn-outline"><i class="fas fa-file-excel"></i> Export Excel</a>
      <a href="/Student/Create" class="btn btn-primary"><i class="fas fa-user-plus"></i> New Registration</a>
    </div>
  </div>
</div>

<form method="get" action="/Student/Index">
<div class="filter-bar">
  <i class="fas fa-filter" style="color:var(--mu);font-size:13px;"></i>
  <input type="text" name="search" value="@Model.Search" class="fc" placeholder="Search name, admission no..." style="min-width:200px;"/>
  <select name="sectionId" class="fs">
    <option value="">All Sections</option>
    @foreach(var s in Model.Sections){<option value="@s.SectionId" selected=@(Model.SectionFilter==s.SectionId?"selected":"")>@s.SectionName</option>}
  </select>
  <select name="classId" class="fs">
    <option value="">All Classes</option>
    @foreach(var c in Model.Classes){<option value="@c.ClassId" selected=@(Model.ClassFilter==c.ClassId?"selected":"")>@c.ClassName</option>}
  </select>
  <select name="batchId" class="fs">
    <option value="">All Batches</option>
    @foreach(var b in Model.Batches){<option value="@b.BatchId" selected=@(Model.BatchFilter==b.BatchId?"selected":"")>@b.BatchName</option>}
  </select>
  <select name="status" class="fs">
    <option value="">All Status</option>
    @foreach(var s in new[]{"Active","Inactive","Transferred"}){<option value="@s" selected=@(Model.StatusFilter==s?"selected":"")>@s</option>}
  </select>
  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Search</button>
  <a href="/Student/Index" class="btn btn-outline btn-sm"><i class="fas fa-times"></i></a>
</div>
</form>

<div class="card">
  <div class="tbl-wrap">
    @if (!Model.Students.Any())
    {
      <div class="empty"><div class="empty-ico">👨‍🎓</div><h3>No students found</h3><p>Try changing your search filters.</p></div>
    }
    else
    {
    <table>
      <thead>
        <tr><th>Photo</th><th>Admission No</th><th>Student Name</th><th>Class</th><th>Section</th><th>Batch</th><th>Father</th><th>Father Contact</th><th>Mother Contact</th><th>Status</th><th></th></tr>
      </thead>
      <tbody>
      @foreach (var s in Model.Students)
      {
        <tr onclick="window.location='/Student/Details/@s.StudentId'" style="cursor:pointer;">
          <td>
            @if (!string.IsNullOrEmpty(s.ProfilePicPath)){<img src="@s.ProfilePicPath" class="stu-pic"/>}
            else{<div class="stu-av" style="font-size:14px;">@(s.FullName.Length>0?s.FullName[0].ToString().ToUpper():"?")</div>}
          </td>
          <td><span class="mono text-p" style="font-size:12px;">@s.AdmissionNo</span></td>
          <td><div class="fw7">@s.FullName</div><div style="font-size:11px;" class="text-mu">Roll: @(s.RollNo??"—")</div></td>
          <td>@s.ClassName</td>
          <td><span class="badge b-purple">@s.SectionName</span></td>
          <td style="font-size:12.5px;" class="text-mu">@s.BatchName</td>
          <td style="font-size:13px;">@s.FatherName</td>
          <td style="font-size:12.5px;" class="text-mu">@s.FatherPhone</td>
          <td style="font-size:12.5px;" class="text-mu">@s.MotherPhone</td>
          <td><span class="badge @(s.Status=="Active"?"b-active":"b-inactive")">@s.Status</span></td>
          <td><a href="/Student/Edit/@s.StudentId" class="btn btn-outline btn-sm btn-icon" onclick="event.stopPropagation()"><i class="fas fa-edit"></i></a></td>
        </tr>
      }
      </tbody>
    </table>
    }
  </div>
  @if (Model.TotalPages > 1)
  {
    <div class="pagi">
      @for (int i = 1; i <= Model.TotalPages; i++)
      {<a href="/Student/Index?page=@i&search=@Model.Search&classId=@Model.ClassFilter&sectionId=@Model.SectionFilter&batchId=@Model.BatchFilter" class="pg-btn @(i==Model.Page?"active":"")">@i</a>}
    </div>
  }
</div>
