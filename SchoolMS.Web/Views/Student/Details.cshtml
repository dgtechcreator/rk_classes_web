@model SchoolMS.Domain.Student
@{
  ViewData["Title"] = "Student Profile";
  bool isNew = TempData["IsNewStudent"] as bool? ?? false;
  string studentName = TempData["StudentName"] as string ?? "";
  string fatherPhone = TempData["FatherPhone"] as string ?? "";
  string motherPhone = TempData["MotherPhone"] as string ?? "";
}

@if (isNew && !string.IsNullOrEmpty(studentName))
{
  <div id="welcomeModal" style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;z-index:9999;">
    <div style="background:#fff;padding:32px;border-radius:12px;box-shadow:0 10px 40px rgba(0,0,0,0.2);max-width:420px;width:90%;animation:popupSlide 0.3s ease;">
      <div style="text-align:center;margin-bottom:24px;">
        <div style="font-size:28px;color:#4CAF50;margin-bottom:12px;">✓</div>
        <div style="font-size:18px;font-weight:800;color:#111;margin-bottom:8px;">Welcome @studentName!</div>
        <div style="font-size:13px;color:#666;">Student admission completed successfully</div>
      </div>

      <div style="display:flex;gap:10px;">
        <button onclick="document.getElementById('welcomeModal').remove()" style="flex:1;background:#f0f0f0;color:#333;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;font-size:14px;">
          OK
        </button>
        <button onclick="showMessagePopup()" style="flex:1;background:#25D366;color:#fff;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;font-size:14px;">
          💬 Message
        </button>
      </div>
    </div>
  </div>

  <div id="messageModal" style="position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);display:none;align-items:center;justify-content:center;z-index:10000;">
    <div style="background:#fff;padding:32px;border-radius:12px;box-shadow:0 10px 40px rgba(0,0,0,0.2);max-width:480px;width:90%;animation:popupSlide 0.3s ease;max-height:80vh;overflow-y:auto;">
      <div style="font-size:14px;line-height:1.8;color:#333;margin-bottom:24px;white-space:pre-wrap;font-family:Arial,sans-serif;">*Dear Student,*

Welcome to R K CLASSES. Wishing you a great learning experience and success in your studies.

*Regards,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*

.........................................

*प्रिय विद्यार्थी,*

*R K CLASSES* में आपका स्वागत है। आपके उज्ज्वल भविष्य और सफलता की कामना करते हैं।

*सादर,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*</div>

      <div style="display:flex;gap:10px;">
        <button onclick="openFatherWhatsApp('@fatherPhone')" style="flex:1;background:#25D366;color:#fff;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;font-size:14px;">
          👨 Send to Father
        </button>
        <button onclick="openMotherWhatsApp('@motherPhone')" style="flex:1;background:#25D366;color:#fff;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;font-size:14px;">
          👩 Send to Mother
        </button>
      </div>

      <button onclick="document.getElementById('messageModal').remove();document.getElementById('welcomeModal').remove();" style="width:100%;background:#f0f0f0;color:#333;border:none;padding:12px;border-radius:6px;cursor:pointer;font-weight:600;font-size:14px;">
        Close
      </button>
    </div>
  </div>

  <style>
    @@keyframes popupSlide {
      from { transform: translateY(-50px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
  </style>

  <script>
    function showMessagePopup() {
      document.getElementById('welcomeModal').style.display = 'none';
      document.getElementById('messageModal').style.display = 'flex';
    }

    function openFatherWhatsApp(fatherPhone) {
      fatherPhone = String(fatherPhone || '').trim();

      const combinedMsg = `*Dear Student,*

Welcome to R K CLASSES. Wishing you a great learning experience and success in your studies.

*Regards,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*

.........................................

*प्रिय विद्यार्थी,*

*R K CLASSES* में आपका स्वागत है। आपके उज्ज्वल भविष्य और सफलता की कामना करते हैं।

*सादर,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*`;

      if (fatherPhone && fatherPhone !== '') {
        const fatherNum = fatherPhone.replace(/[^0-9]/g, '');
        if (fatherNum.length > 0) {
          window.open('https://wa.me/' + fatherNum + '?text=' + encodeURIComponent(combinedMsg), '_blank');
        }
      }
    }

    function openMotherWhatsApp(motherPhone) {
      motherPhone = String(motherPhone || '').trim();

      const combinedMsg = `*Dear Student,*

Welcome to R K CLASSES. Wishing you a great learning experience and success in your studies.

*Regards,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*

.........................................

*प्रिय विद्यार्थी,*

*R K CLASSES* में आपका स्वागत है। आपके उज्ज्वल भविष्य और सफलता की कामना करते हैं।

*सादर,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*`;

      if (motherPhone && motherPhone !== '') {
        const motherNum = motherPhone.replace(/[^0-9]/g, '');
        if (motherNum.length > 0) {
          window.open('https://wa.me/' + motherNum + '?text=' + encodeURIComponent(combinedMsg), '_blank');
        }
      }
    }

    function openBothWhatsApp(fatherPhone, motherPhone) {
      fatherPhone = String(fatherPhone || '').trim();
      motherPhone = String(motherPhone || '').trim();

      const combinedMsg = `*Dear Student,*

Welcome to R K CLASSES. Wishing you a great learning experience and success in your studies.

*Regards,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*

.........................................

*प्रिय विद्यार्थी,*

*R K CLASSES* में आपका स्वागत है। आपके उज्ज्वल भविष्य और सफलता की कामना करते हैं।

*सादर,*
*R K CLASSES*
*Kapil Sir*
*M.Sc.,B.ed*
*9870375795*
*8108499214*`;

      // Open Father's WhatsApp first
      if (fatherPhone && fatherPhone !== '') {
        const fatherNum = fatherPhone.replace(/[^0-9]/g, '');
        if (fatherNum.length > 0) {
          window.open('https://wa.me/' + fatherNum + '?text=' + encodeURIComponent(combinedMsg), '_blank');
        }
      }

      // Open Mother's WhatsApp after small delay
      setTimeout(() => {
        if (motherPhone && motherPhone !== '') {
          const motherNum = motherPhone.replace(/[^0-9]/g, '');
          if (motherNum.length > 0) {
            window.open('https://wa.me/' + motherNum + '?text=' + encodeURIComponent(combinedMsg), '_blank');
          }
        }
      }, 300);
    }
  </script>
}

<div class="pg-hdr">
  <div class="pg-row">
    <div>
      <div class="breadcrumb"><a href="/Student/Index">Students</a> / <span>Profile</span></div>
      <h1>Student Profile</h1>
    </div>
    <a href="/Student/Edit/@Model.StudentId" class="btn btn-primary"><i class="fas fa-edit"></i> Edit</a>
  </div>
</div>

<div class="g2" style="align-items:start;">
  <div class="card" style="text-align:center;padding:28px;">
    @if (!string.IsNullOrEmpty(Model.ProfilePicPath))
    {<img src="@Model.ProfilePicPath" style="width:100px;height:100px;border-radius:50%;object-fit:cover;border:3px solid var(--bdr2);margin-bottom:14px;"/>}
    else
    {<div style="width:100px;height:100px;border-radius:50%;background:var(--grad);display:flex;align-items:center;justify-content:center;font-size:38px;font-weight:900;color:#fff;margin:0 auto 14px;">@Model.FullName[0]</div>}
    <div style="font-size:18px;font-weight:800;color:var(--txt);">@Model.FullName</div>
    <div style="font-size:13px;" class="text-mu">@Model.AdmissionNo</div>
    <span class="badge @(Model.Status=="Active"?"b-active":"b-inactive")" style="margin-top:8px;">@Model.Status</span>
    @{
      var contacts = new List<(string Label, string Number)>();
      foreach (var (lbl, raw) in new[] { ("Father", Model.FatherPhone), ("Mother", Model.MotherPhone), ("Student", Model.Phone) })
      {
        var digits = new string((raw ?? "").Where(char.IsDigit).ToArray());
        if (digits.Length < 10) continue;
        if (digits.StartsWith("0")) digits = digits.Substring(1);
        var intl = digits.Length == 10 ? "91" + digits : digits;
        if (contacts.Any(c => c.Number == intl)) continue;
        contacts.Add((lbl, intl));
      }
    }
    <div style="margin-top:16px;text-align:left;">
      @if (!contacts.Any())
      {<div class="text-mu" style="font-size:12px;text-align:center;">No valid phone number saved.</div>}
      @foreach (var c in contacts)
      {
        <div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-top:1px solid var(--bdr);">
          <div style="flex:1;font-size:13px;"><b>@c.Label</b><div style="font-size:12px;color:var(--mu);">+@c.Number</div></div>
          <a href="tel:+@c.Number" class="btn btn-outline btn-sm" title="Call @c.Label" style="color:#2563eb;"><i class="fas fa-phone"></i> Call</a>
          <button type="button" class="btn btn-sm" title="WhatsApp @c.Label" style="background:#25d366;color:#fff;border:none;" onclick="rkWhatsapp('General','@c.Number')"><i class="fab fa-whatsapp"></i></button>
        </div>
      }
    </div>
    <div style="margin-top:18px;">
      @foreach(var (lbl,val) in new[]{("Std",Model.ClassName??"—"),("Medium/Stream",Model.SectionName??"—"),("Batch",Model.BatchName??"—"),("Roll No",Model.RollNo??"—"),("Year",Model.YearName??"—")})
      {<div class="info-row"><span class="info-lbl">@lbl</span><span class="info-val">@val</span></div>}
    </div>
  </div>
  <div style="display:flex;flex-direction:column;gap:16px;">
    <div class="card">
      <div class="card-hdr"><span class="card-ttl">Personal Details</span></div>
      @foreach(var (lbl,val) in new[]{("Date of Birth",Model.DateOfBirth?.ToString("dd MMM yyyy")??"—"),("Gender",Model.Gender??"—"),("Blood Group",Model.BloodGroup??"—"),("Phone",Model.Phone??"—"),("Email",Model.Email??"—"),("Address",Model.Address??"—")})
      {<div class="info-row"><span class="info-lbl">@lbl</span><span class="info-val">@val</span></div>}
    </div>
    <div class="card">
      <div class="card-hdr"><span class="card-ttl">Family Details</span></div>
      @foreach(var (lbl,val) in new[]{("Father's Name",Model.FatherName??"—"),("Mother's Name",Model.MotherName??"—")})
      {<div class="info-row"><span class="info-lbl">@lbl</span><span class="info-val">@val</span></div>}
    </div>
    @if (Context.Session.HasPerm("fee_collection") && ViewBag.FeeTotal != null)
    {
      decimal feeTotal = ViewBag.FeeTotal, feePaid = ViewBag.FeePaid, feeBalance = ViewBag.FeeBalance, feeDisc = ViewBag.FeeDiscount, feeExtra = ViewBag.FeeExtra;
      var feeHistory = ViewBag.FeeHistory as List<SchoolMS.Domain.FeePayment> ?? new();
      <div class="card">
        <div class="card-hdr">
          <span class="card-ttl"><i class="fas fa-rupee-sign" style="color:var(--p);margin-right:7px;"></i>Fees</span>
          <span class="badge @(feeBalance > 0 ? "b-inactive" : "b-active")">@(feeBalance > 0 ? "Due ₹" + feeBalance.ToString("N0") : "Fully paid")</span>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:6px;">
          <div style="flex:1;min-width:110px;"><div class="text-mu" style="font-size:12px;">Total</div><div style="font-size:20px;font-weight:800;">₹@feeTotal.ToString("N0")</div></div>
          <div style="flex:1;min-width:110px;"><div class="text-mu" style="font-size:12px;">Paid</div><div style="font-size:20px;font-weight:800;color:#059669;">₹@feePaid.ToString("N0")</div></div>
          <div style="flex:1;min-width:110px;"><div class="text-mu" style="font-size:12px;">Balance</div><div style="font-size:20px;font-weight:800;color:@(feeBalance > 0 ? "#dc2626" : "#059669");">₹@feeBalance.ToString("N0")</div></div>
        </div>
        @if (feeExtra > 0 || feeDisc > 0)
        {
          <div class="text-mu" style="font-size:12px;margin-bottom:8px;">
            @if (feeExtra > 0) {<span>Includes ₹@feeExtra.ToString("N0") additional charges. </span>}
            @if (feeDisc > 0) {<span>Total is after the ₹@feeDisc.ToString("N0") discount.</span>}
          </div>
        }
        @if (feeHistory.Any())
        {
          <div class="tbl-wrap">
            <table>
              <thead><tr><th>Date</th><th>Receipt</th><th>Mode</th><th style="text-align:right;">Amount</th><th></th></tr></thead>
              <tbody>
              @foreach (var p in feeHistory)
              {
                <tr>
                  <td>@p.PaymentDate.ToString("dd-MM-yyyy")</td>
                  <td>@p.ReceiptNo</td>
                  <td>@p.PaymentMode</td>
                  <td style="text-align:right;font-weight:700;">₹@p.NetAmount.ToString("N0")</td>
                  <td><a href="/Fees/Receipt/@p.PaymentId" target="_blank" class="btn btn-outline btn-sm"><i class="fas fa-receipt"></i> Receipt</a></td>
                </tr>
              }
              </tbody>
            </table>
          </div>
        }
        @if (feeBalance > 0 && contacts.Any())
        {
          <div style="margin-top:12px;">
            <div class="text-mu" style="font-size:12px;margin-bottom:6px;">Send fee reminder on WhatsApp:</div>
            <div class="df g8" style="flex-wrap:wrap;">
              @foreach (var c in contacts)
              {
                <button type="button" class="btn btn-sm" style="background:#25d366;color:#fff;border:none;"
                  onclick="rkWhatsapp('FeeReminder','@c.Number',{total:'@feeTotal.ToString("N0")',paid:'@feePaid.ToString("N0")',balance:'@feeBalance.ToString("N0")'})">
                  <i class="fab fa-whatsapp"></i> @c.Label
                </button>
              }
            </div>
          </div>
        }
      </div>
    }
    <div class="df g8">
      <a href="/Fees/Collect" class="btn btn-success" style="flex:1;justify-content:center;"><i class="fas fa-rupee-sign"></i> Collect Fee</a>
      <a href="/Attendance/Index" class="btn btn-outline" style="flex:1;justify-content:center;"><i class="fas fa-calendar-check"></i> Attendance</a>
    </div>
  </div>
</div>

<script>
  // WhatsApp text comes from Masters -> Templates (category), with a plain fallback if none is saved.
  const RK_STUDENT = { fullName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FullName ?? "")), className: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.ClassName ?? "").Trim())), medium: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.SectionName ?? "").Trim())) };
  const RK_FALLBACK = {
    General: "Dear Parent, a message regarding {student} ({class}) from {school}.",
    FeeReminder: "Dear Parent, this is a gentle reminder regarding the fees of {student} ({class}). Total fees: Rs {total}, paid: Rs {paid}, balance due: Rs {balance}. Kindly clear the balance at the earliest. - {school}"
  };
  let rkTemplates = [];
  fetch('/Masters/MessageTemplatesJson').then(r => r.json()).then(t => { rkTemplates = t || []; }).catch(() => {});
  function rkWhatsapp(category, number, extra) {
    const t = rkTemplates.find(x => (x.category || '').toLowerCase() === category.toLowerCase());
    const vars = Object.assign({
      student: RK_STUDENT.fullName, class: RK_STUDENT.className, medium: RK_STUDENT.medium,
      date: new Date().toLocaleDateString('en-GB').replace(/\//g, '-'), school: 'RK Classes'
    }, extra || {});
    const body = t ? t.body : (RK_FALLBACK[category] || '');
    const msg = body.replace(/\{(\w+)\}/g, (m, k) => (vars[k.toLowerCase()] !== undefined ? vars[k.toLowerCase()] : m));
    window.open('https://wa.me/' + number + '?text=' + encodeURIComponent(msg), '_blank');
  }
</script>
