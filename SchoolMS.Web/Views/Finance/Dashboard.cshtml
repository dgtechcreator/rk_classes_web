@{
    ViewData["Title"] = "Finance Dashboard";
}

@if (!string.IsNullOrEmpty(ViewBag.Error))
{
    <div style="background: #fee; color: #c33; padding: 20px; border-radius: 8px; margin: 20px;">
        <strong>⚠️ Error:</strong> @ViewBag.Error
    </div>
}

<div class="pg-hdr">
    <h1>💰 Finance Dashboard</h1>
    <p>Overall fees collection and financial overview for all students</p>
</div>

<div class="kpi-grid">
    <div class="kpi green">
        <div class="kpi-ico green">👥</div>
        <div class="kpi-val">@ViewBag.TotalStudents</div>
        <div class="kpi-lbl">Total Students</div>
    </div>

    <div class="kpi teal">
        <div class="kpi-ico teal">💳</div>
        <div class="kpi-val">@ViewBag.TotalFees.ToString("N0")</div>
        <div class="kpi-lbl">Total Fees</div>
    </div>

    <div class="kpi indigo">
        <div class="kpi-ico indigo">✅</div>
        <div class="kpi-val">@ViewBag.TotalCollected.ToString("N0")</div>
        <div class="kpi-lbl">Collected Fees</div>
    </div>

    <div class="kpi amber">
        <div class="kpi-ico amber">🎁</div>
        <div class="kpi-val">@ViewBag.TotalDiscount.ToString("N0")</div>
        <div class="kpi-lbl">Discount</div>
    </div>

    <div class="kpi red">
        <div class="kpi-ico red">⚠️</div>
        <div class="kpi-val">@ViewBag.TotalBalance.ToString("N0")</div>
        <div class="kpi-lbl">Balance Due</div>
    </div>

    <div class="kpi pink">
        <div class="kpi-ico pink">📊</div>
        <div class="kpi-val">@ViewBag.CollectionPercentage%</div>
        <div class="kpi-lbl">Collection Rate</div>
    </div>
</div>
