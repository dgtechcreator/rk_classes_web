@{ ViewData["Title"] = "Error"; }

<div class="pg-hdr">
  <h1>⚠️ Something went wrong</h1>
</div>

<div class="card" style="text-align:center;padding:60px 30px;max-width:500px;margin:0 auto;">
  <div style="font-size:56px;margin-bottom:16px;">⚠️</div>
  <h2 style="font-size:20px;font-weight:800;color:var(--txt);margin-bottom:8px;">An error occurred</h2>
  <p style="color:var(--mu);font-size:13.5px;margin-bottom:24px;">
    Something unexpected happened. Please try again or contact your administrator.
  </p>
  <a href="/Dashboard/Index" class="btn btn-primary"><i class="fas fa-home"></i> Back to Dashboard</a>
</div>
