@{
    ViewData["Title"] = "Payment Receipt";
}

@if (ViewBag.Payment != null)
{
    var p = ViewBag.Payment;
    <div style="max-width: 800px; margin: 20px auto; padding: 40px; background: white; border: 1px solid #e5e7eb; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">

        <!-- Header -->
        <div style="text-align: center; border-bottom: 2px solid #1e40af; padding-bottom: 20px; margin-bottom: 30px;">
            <h1 style="margin: 0; color: #1e40af; font-size: 28px;">📋 PAYMENT RECEIPT</h1>
            <p style="margin: 10px 0 0 0; color: #6b7280; font-size: 14px;">RK Classes</p>
        </div>

        <!-- Receipt Number -->
        <div style="text-align: center; background: #eff6ff; padding: 12px; border-radius: 6px; margin-bottom: 30px;">
            <p style="margin: 0; font-size: 14px; color: #374151;">
                <strong>Receipt No:</strong> <span style="font-size: 18px; color: #1e40af; font-weight: 700;">@p.ReceiptNo</span>
            </p>
            <p style="margin: 8px 0 0 0; font-size: 12px; color: #6b7280;">
                <strong>Date:</strong> @p.PaymentDate?.ToString("dd MMMM yyyy")
            </p>
        </div>

        <!-- Payment Details -->
        <div style="margin-bottom: 30px;">
            <h3 style="font-size: 14px; font-weight: 700; color: #1f2937; margin: 0 0 16px 0; text-transform: uppercase; letter-spacing: 0.5px;">Payment Details</h3>

            <table style="width: 100%; border-collapse: collapse;">
                <tbody>
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px 0; color: #6b7280; font-size: 14px;"><strong>Teacher Name:</strong></td>
                        <td style="padding: 12px 0; text-align: right; color: #1f2937; font-weight: 600; font-size: 14px;">@p.FacultyName</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px 0; color: #6b7280; font-size: 14px;"><strong>Payment Type:</strong></td>
                        <td style="padding: 12px 0; text-align: right; color: #1f2937; font-weight: 600; font-size: 14px;">@p.PaymentType</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px 0; color: #6b7280; font-size: 14px;"><strong>Rate:</strong></td>
                        <td style="padding: 12px 0; text-align: right; color: #1f2937; font-weight: 600; font-size: 14px;">₹@p.Rate.ToString("N0")</td>
                    </tr>
                    @if (p.Quantity != null && (decimal)p.Quantity > 0)
                    {
                        <tr style="border-bottom: 1px solid #e5e7eb;">
                            <td style="padding: 12px 0; color: #6b7280; font-size: 14px;"><strong>Quantity:</strong></td>
                            <td style="padding: 12px 0; text-align: right; color: #1f2937; font-weight: 600; font-size: 14px;">@((decimal)p.Quantity).ToString("N1")</td>
                        </tr>
                    }
                    <tr style="border-bottom: 1px solid #e5e7eb;">
                        <td style="padding: 12px 0; color: #6b7280; font-size: 14px;"><strong>Payment Month:</strong></td>
                        <td style="padding: 12px 0; text-align: right; color: #1f2937; font-weight: 600; font-size: 14px;">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(p.PaymentMonth) @p.PaymentYear</td>
                    </tr>
                    <tr style="border-bottom: 2px solid #1e40af;">
                        <td style="padding: 16px 0; color: #1f2937; font-size: 16px;"><strong>Payment Amount:</strong></td>
                        <td style="padding: 16px 0; text-align: right; color: #10b981; font-weight: 700; font-size: 20px;">₹@p.TotalAmount.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Payment Method -->
        @if (!string.IsNullOrEmpty(p.PaymentMode))
        {
            <div style="background: #f3f4f6; padding: 16px; border-radius: 6px; margin-bottom: 30px;">
                <p style="margin: 0 0 8px 0; font-size: 12px; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5px;"><strong>Payment Method</strong></p>
                <p style="margin: 0; font-size: 16px; color: #1f2937; font-weight: 600;">@p.PaymentMode</p>
                @if (!string.IsNullOrEmpty(p.TransactionRef))
                {
                    <p style="margin: 8px 0 0 0; font-size: 12px; color: #6b7280;">Ref: @p.TransactionRef</p>
                }
            </div>
        }

        <!-- Footer -->
        <div style="text-align: center; padding-top: 20px; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 12px;">
            <p style="margin: 0 0 10px 0;">✓ Payment Received and Confirmed</p>
            <p style="margin: 0; color: #9ca3af;">Printed on @DateTime.Now.ToString("dd MMMM yyyy HH:mm")</p>
        </div>

        <!-- Print Button -->
        <div style="text-align: center; margin-top: 30px;">
            <button onclick="window.print()" style="padding: 12px 24px; background: #3b82f6; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 14px; margin-right: 10px;">🖨️ Print Receipt</button>
            <button onclick="window.close()" style="padding: 12px 24px; background: #6b7280; color: white; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 14px;">Close</button>
        </div>
    </div>

    <style>
        @@media print {
            body { margin: 0; padding: 0; background: white; }
            div { box-shadow: none !important; border: none !important; }
            button { display: none !important; }
        }
    </style>
}
else
{
    <div style="text-align: center; padding: 40px; background: white; border-radius: 8px;">
        <p style="color: #ef4444; font-weight: 600;">Receipt not found</p>
    </div>
}
