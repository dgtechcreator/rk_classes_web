@model List<SchoolMS.Domain.AttendanceRecord>
@{
    ViewData["Title"] = "Date-wise Attendance";
    var classes   = ViewBag.Classes   as List<SchoolMS.Domain.Class>           ?? new();
    var sections  = ViewBag.Sections  as List<SchoolMS.Domain.Section>         ?? new();
    var batches   = ViewBag.Batches   as List<SchoolMS.Domain.Batch>           ?? new();
    var dates     = ViewBag.Dates     as List<DateTime>                        ?? new();
    var attData   = ViewBag.AttData   as List<SchoolMS.Domain.DateAttendanceEntry> ?? new();
    int? classId   = ViewBag.ClassId;
    int? sectionId = ViewBag.SectionId;
    int? batchId   = ViewBag.BatchId;
    DateTime fromDate = ViewBag.FromDate ?? DateTime.Today.AddDays(-6);
    DateTime toDate   = ViewBag.ToDate   ?? DateTime.Today;

    // Build lookup: [studentId][date] = status
    var attLookup = attData
        .GroupBy(a => a.StudentId)
        .ToDictionary(g => g.Key, g => g.ToDictionary(a => a.AttendanceDate.Date, a => a.Status));
}

<div class="pg-hdr">
  <div class="pg-row">
    <div><h1>📅 Date-wise Attendance</h1><p>View student attendance day by day</p></div>
    <div class="df g8">
      <a href="/Attendance/Index" class="btn btn-outline"><i class="fas fa-edit"></i> Mark Attendance</a>
      @if (Model.Any())
      {
        <button onclick="exportExcel()" class="btn btn-success"><i class="fas fa-file-excel"></i> Excel</button>
        <button onclick="exportPDF()" class="btn btn-danger"><i class="fas fa-file-pdf"></i> PDF</button>
        <button onclick="window.print()" class="btn btn-outline"><i class="fas fa-print"></i> Print</button>
      }
    </div>
  </div>
</div>

<form method="get" action="/Attendance/DateGrid">
<div class="filter-bar">
  <i class="fas fa-filter" style="color:var(--mu);font-size:13px;"></i>
  <select name="sectionId" class="fs">
    <option value="">All Medium/Stream</option>
    @foreach(var s in sections){<option value="@s.SectionId" selected=@(sectionId==s.SectionId?"selected":"")>@s.SectionName</option>}
  </select>
  <select name="classId" class="fs">
    <option value="">— Std —</option>
    @foreach(var c in classes){<option value="@c.ClassId" selected=@(classId==c.ClassId?"selected":"")>@c.ClassName</option>}
  </select>
  <select name="batchId" class="fs">
    <option value="">All Batches</option>
    @foreach(var b in batches){<option value="@b.BatchId" selected=@(batchId==b.BatchId?"selected":"")>@b.BatchName</option>}
  </select>
  <div style="display:flex;align-items:center;gap:6px;">
    <label style="font-size:12px;font-weight:700;color:var(--mu);">From</label>
    <input type="date" name="fromDate" value="@fromDate.ToString("yyyy-MM-dd")" class="fc" style="width:150px;"/>
  </div>
  <div style="display:flex;align-items:center;gap:6px;">
    <label style="font-size:12px;font-weight:700;color:var(--mu);">To</label>
    <input type="date" name="toDate" value="@toDate.ToString("yyyy-MM-dd")" class="fc" style="width:150px;"/>
  </div>
  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Load</button>
  <a href="/Attendance/DateGrid" class="btn btn-outline btn-sm"><i class="fas fa-times"></i> Clear</a>
</div>
</form>

@if (classId == null)
{
  <div class="card"><div class="empty"><div class="empty-ico">📅</div><h3>Select a Std to View</h3><p>Choose Std and date range from filters above.</p></div></div>
}
else if (!Model.Any())
{
  <div class="card"><div class="empty"><div class="empty-ico">👥</div><h3>No students found</h3></div></div>
}
else
{
  @* ── Summary stat cards ────────────────────────────────────── *@
  <div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
    <div class="card" style="padding:12px 16px;flex:1;min-width:120px;border-top:3.5px solid var(--p);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Students</div>
      <div style="font-size:22px;font-weight:800;color:var(--txt);">@Model.Count</div>
    </div>
    <div class="card" style="padding:12px 16px;flex:1;min-width:120px;border-top:3.5px solid var(--ok);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Days Shown</div>
      <div style="font-size:22px;font-weight:800;color:var(--ok);">@dates.Count</div>
    </div>
    <div class="card" style="padding:12px 16px;flex:1;min-width:120px;border-top:3.5px solid var(--err);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Total Absences</div>
      <div style="font-size:22px;font-weight:800;color:var(--err);">
        @attData.Count(a => a.Status == "Absent")
      </div>
    </div>
    <div class="card" style="padding:12px 16px;flex:1;min-width:120px;border-top:3.5px solid var(--warn);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Late Arrivals</div>
      <div style="font-size:22px;font-weight:800;color:var(--warn);">
        @attData.Count(a => a.Status == "Late")
      </div>
    </div>
  </div>

  @* ── Grid legend ──────────────────────────────────────────── *@
  <div style="display:flex;gap:12px;margin-bottom:12px;flex-wrap:wrap;">
    <span style="font-size:12px;font-weight:700;color:var(--mu);">Legend:</span>
    <span style="display:flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:#065f46;"><span style="width:22px;height:22px;background:#ecfdf5;border:1px solid #6ee7b7;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:11px;">P</span> Present</span>
    <span style="display:flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:#991b1b;"><span style="width:22px;height:22px;background:#fef2f2;border:1px solid #fca5a5;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:11px;">A</span> Absent</span>
    <span style="display:flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:#92400e;"><span style="width:22px;height:22px;background:#fffbeb;border:1px solid #fcd34d;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:11px;">L</span> Late</span>
    <span style="display:flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:var(--mu2);"><span style="width:22px;height:22px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:11px;">—</span> Not Marked</span>
  </div>

  <div class="card" style="padding:0;overflow-x:auto;">
    <table id="attTable" style="min-width:max-content;">
      <thead>
        <tr>
          <th style="position:sticky;left:0;background:#f8f6ff;z-index:2;min-width:50px;">#</th>
          <th style="position:sticky;left:50px;background:#f8f6ff;z-index:2;min-width:160px;">Student</th>
          @foreach (var d in dates)
          {
            var isWeekend = d.DayOfWeek == DayOfWeek.Sunday || d.DayOfWeek == DayOfWeek.Saturday;
            var isToday   = d.Date == DateTime.Today;
            <th style="min-width:52px;text-align:center;@(isWeekend?"background:#faf9ff;":"")@(isToday?"background:#f0fdf4;":"")">
              <div style="font-size:10px;font-weight:700;color:var(--mu);">@d.ToString("ddd")</div>
              <div style="font-size:13px;font-weight:800;color:@(isToday?"var(--ok)":"var(--txt)");">@d.Day</div>
              <div style="font-size:9px;color:var(--mu2);">@d.ToString("MMM")</div>
            </th>
          }
          <th style="min-width:60px;text-align:center;">Present</th>
          <th style="min-width:60px;text-align:center;">Absent</th>
          <th style="min-width:60px;text-align:center;">%</th>
        </tr>
      </thead>
      <tbody>
      @{ int rn = 0; }
      @foreach (var student in Model.OrderBy(s => s.RollNo).ThenBy(s => s.FullName))
      {
        rn++;
        var sAtt    = attLookup.TryGetValue(student.StudentId, out var d2) ? d2 : new();
        int present = dates.Count(d => sAtt.TryGetValue(d.Date, out var st) && st == "Present");
        int absent  = dates.Count(d => sAtt.TryGetValue(d.Date, out var st) && st == "Absent");
        int marked  = dates.Count(d => sAtt.ContainsKey(d.Date));
        decimal pct = marked > 0 ? (decimal)present * 100 / marked : 0;
        var pctClr  = pct >= 75 ? "var(--ok)" : pct >= 50 ? "var(--warn)" : "var(--err)";

        <tr>
          <td style="position:sticky;left:0;background:#fff;z-index:1;font-weight:700;color:var(--mu);text-align:center;">@rn</td>
          <td style="position:sticky;left:50px;background:#fff;z-index:1;border-right:1.5px solid var(--bdr);">
            <div class="fw7" style="font-size:13px;">@student.FullName</div>
            <div style="font-size:11px;color:var(--mu);">@student.AdmissionNo | Roll: @(student.RollNo??"—")</div>
          </td>
          @foreach (var d in dates)
          {
            var isWeekend = d.DayOfWeek == DayOfWeek.Sunday || d.DayOfWeek == DayOfWeek.Saturday;
            sAtt.TryGetValue(d.Date, out var status);
            var (cell, bg, clr) = status switch {
              "Present" => ("P", "#ecfdf5", "#065f46"),
              "Absent"  => ("A", "#fef2f2", "#991b1b"),
              "Late"    => ("L", "#fffbeb", "#92400e"),
              _         => ("—", isWeekend ? "#faf9ff" : "#fff", "#c4b5fd")
            };
            <td style="text-align:center;padding:6px 4px;background:@bg;">
              <span style="display:inline-flex;width:24px;height:24px;align-items:center;justify-content:center;border-radius:5px;font-size:11px;font-weight:800;color:@clr;">@cell</span>
            </td>
          }
          <td style="text-align:center;font-weight:800;color:var(--ok);">@present</td>
          <td style="text-align:center;font-weight:800;color:var(--err);">@absent</td>
          <td style="text-align:center;">
            <span style="font-size:12.5px;font-weight:800;color:@pctClr;">@pct.ToString("0")%</span>
          </td>
        </tr>
      }

      @* Day totals row *@
      <tr style="background:#f8f6ff;border-top:2px solid var(--bdr);">
        <td style="position:sticky;left:0;background:#f8f6ff;z-index:1;"></td>
        <td style="position:sticky;left:50px;background:#f8f6ff;z-index:1;font-size:12px;font-weight:800;color:var(--mu);border-right:1.5px solid var(--bdr);">Day Total (Present)</td>
        @foreach (var d in dates)
        {
          var dayPresent = attData.Count(a => a.AttendanceDate.Date == d.Date && a.Status == "Present");
          var dayTotal   = attData.Count(a => a.AttendanceDate.Date == d.Date);
          <td style="text-align:center;padding:6px 4px;">
            <div style="font-size:11px;font-weight:800;color:var(--ok);">@dayPresent</div>
            @if (dayTotal > 0){<div style="font-size:9px;color:var(--mu2);">/ @dayTotal</div>}
          </td>
        }
        <td colspan="3"></td>
      </tr>
      </tbody>
    </table>
  </div>
}

<style>
@@media print {
  .topbar, .sidebar, .filter-bar, .pg-hdr .df { display:none!important; }
  .main { margin:0!important; padding:10px!important; }
  table { font-size:10px; }
}
</style>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script>
// ── shared: read table into a clean 2-D array ─────────────────
function readTable() {
  var table = document.getElementById('attTable');
  if (!table) return { head: [], rows: [] };

  // Header row — collapse multi-div text into one cell per <th>
  var head = [];
  table.querySelectorAll('thead tr th').forEach(function(th) {
    head.push(th.innerText.trim().replace(/\n+/g, ' '));
  });

  // Body rows
  var rows = [];
  table.querySelectorAll('tbody tr').forEach(function(tr) {
    var row = [];
    tr.querySelectorAll('td').forEach(function(td) {
      row.push(td.innerText.trim().replace(/\n+/g, ' '));
    });
    rows.push(row);
  });

  return { head: head, rows: rows };
}

// ── get filter label for filename / title ─────────────────────
function getLabel() {
  var cls  = '@(Model.Any() ? Model.First().ClassName ?? "" : "")';
  var sec  = '@(Model.Any() && Model.First().SectionName != null ? Model.First().SectionName : "")';
  var from = '@fromDate.ToString("dd-MMM-yyyy")';
  var to   = '@toDate.ToString("dd-MMM-yyyy")';
  var parts = ['Attendance'];
  if (cls)  parts.push(cls);
  if (sec)  parts.push(sec);
  parts.push(from + ' to ' + to);
  return parts.join(' | ');
}

// ── Excel export ──────────────────────────────────────────────
function exportExcel() {
  if (typeof XLSX === 'undefined') { alert('Excel library not loaded. Check your internet connection.'); return; }
  var d = readTable();
  if (!d.head.length) { alert('No data to export.'); return; }

  var wsData = [d.head].concat(d.rows);
  var ws = XLSX.utils.aoa_to_sheet(wsData);

  ws['!cols'] = d.head.map(function(h, i) {
    return { wch: i === 1 ? 28 : Math.max(h.length, 5) };
  });

  var wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Attendance');
  XLSX.writeFile(wb, 'Attendance_@(fromDate.ToString("yyyyMMdd"))_@(toDate.ToString("yyyyMMdd")).xlsx');
}

// ── PDF export ────────────────────────────────────────────────
function exportPDF() {
  if (!window.jspdf) { alert('PDF library not loaded. Check your internet connection.'); return; }
  var d = readTable();
  if (!d.head.length) { alert('No data to export.'); return; }

  var doc = new window.jspdf.jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });

  var label = getLabel();
  var pageW = doc.internal.pageSize.getWidth();

  // Title
  doc.setFontSize(13);
  doc.setFont('helvetica', 'bold');
  doc.text('RK Classes — Date-wise Attendance', pageW / 2, 30, { align: 'center' });
  doc.setFontSize(9);
  doc.setFont('helvetica', 'normal');
  doc.text(label, pageW / 2, 44, { align: 'center' });

  // Color map for attendance cells
  var cellColors = { 'P': [236,253,245], 'A': [254,242,242], 'L': [255,251,235] };
  var textColors = { 'P': [6,95,70],     'A': [153,27,27],   'L': [146,64,14]  };

  doc.autoTable({
    startY: 56,
    head: [d.head],
    body: d.rows,
    theme: 'grid',
    styles: { fontSize: 7, cellPadding: 3, halign: 'center', overflow: 'linebreak' },
    headStyles: { fillColor: [109,40,217], textColor: 255, fontStyle: 'bold', fontSize: 7 },
    columnStyles: { 0: { cellWidth: 20 }, 1: { halign: 'left', cellWidth: 80 } },
    didParseCell: function(data) {
      if (data.section === 'body' && data.column.index > 1) {
        var v = (data.cell.raw || '').toString().trim();
        if (cellColors[v]) {
          data.cell.styles.fillColor = cellColors[v];
          data.cell.styles.textColor = textColors[v];
          data.cell.styles.fontStyle = 'bold';
        }
      }
    },
    margin: { left: 20, right: 20 }
  });

  // Page numbers
  var pageCount = doc.internal.getNumberOfPages();
  for (var i = 1; i <= pageCount; i++) {
    doc.setPage(i);
    doc.setFontSize(8);
    doc.setTextColor(150);
    doc.text('Page ' + i + ' of ' + pageCount, pageW - 20, doc.internal.pageSize.getHeight() - 10, { align: 'right' });
    doc.text('Generated: ' + new Date().toLocaleString(), 20, doc.internal.pageSize.getHeight() - 10);
  }

  doc.save('Attendance_@(fromDate.ToString("yyyyMMdd"))_@(toDate.ToString("yyyyMMdd")).pdf');
}
</script>
}
