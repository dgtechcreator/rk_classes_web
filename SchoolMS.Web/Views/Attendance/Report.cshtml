@model List<SchoolMS.Domain.AttendanceReport>
@{
    ViewData["Title"] = "Attendance Report";
    var cls       = ViewBag.Classes as List<SchoolMS.Domain.Class> ?? new();
    int curMonth  = ViewBag.Month  ?? DateTime.Today.Month;
    int curYear   = ViewBag.Year   ?? DateTime.Today.Year;
    int? curClass = ViewBag.ClassId;
    var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(curMonth);
    var hasData   = Model.Any();
}

<div class="pg-hdr">
  <div class="pg-row">
    <div>
      <h1>📊 Attendance Report</h1>
      <p>Monthly summary — @monthName @curYear</p>
    </div>
    <div class="df g8">
      <a href="/Attendance/Index" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back to Marking</a>
      @if (hasData)
      {
        <button onclick="exportExcel()" class="btn btn-success"><i class="fas fa-file-excel"></i> Excel</button>
        <button onclick="exportPDF()"   class="btn btn-danger"><i class="fas fa-file-pdf"></i> PDF</button>
        <button onclick="window.print()" class="btn btn-outline"><i class="fas fa-print"></i> Print</button>
      }
    </div>
  </div>
</div>

<form method="get" action="/Attendance/Report">
<div class="filter-bar">
  <i class="fas fa-filter" style="color:var(--mu);font-size:13px;"></i>
  <select name="classId" class="fs">
    <option value="">All Classes</option>
    @foreach (var c in cls)
    {
      if (curClass == c.ClassId) { <option value="@c.ClassId" selected>@c.ClassName</option> }
      else                       { <option value="@c.ClassId">@c.ClassName</option> }
    }
  </select>
  <select name="month" class="fs">
    @for (int m = 1; m <= 12; m++)
    {
      var mn = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
      if (curMonth == m) { <option value="@m" selected>@mn</option> }
      else               { <option value="@m">@mn</option> }
    }
  </select>
  <input type="number" name="year" value="@curYear" class="fc" style="width:90px;" placeholder="Year" min="2000" max="2100"/>
  <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Filter</button>
</div>
</form>

@if (hasData)
{
  @* ── Summary strip ────────────────────────────────────────── *@
  <div style="display:flex;gap:12px;margin-bottom:16px;flex-wrap:wrap;">
    <div class="card" style="padding:12px 16px;flex:1;min-width:110px;border-top:3.5px solid var(--p);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Students</div>
      <div style="font-size:22px;font-weight:800;color:var(--txt);">@Model.Count</div>
    </div>
    <div class="card" style="padding:12px 16px;flex:1;min-width:110px;border-top:3.5px solid var(--ok);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Avg Present</div>
      <div style="font-size:22px;font-weight:800;color:var(--ok);">@(Model.Average(r=>(double)r.PresentDays).ToString("0.0"))</div>
    </div>
    <div class="card" style="padding:12px 16px;flex:1;min-width:110px;border-top:3.5px solid var(--err);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Avg Absent</div>
      <div style="font-size:22px;font-weight:800;color:var(--err);">@(Model.Average(r=>(double)r.AbsentDays).ToString("0.0"))</div>
    </div>
    <div class="card" style="padding:12px 16px;flex:1;min-width:110px;border-top:3.5px solid var(--warn);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Below 75%</div>
      <div style="font-size:22px;font-weight:800;color:var(--warn);">@Model.Count(r => r.AttendancePct < 75)</div>
    </div>
    <div class="card" style="padding:12px 16px;flex:1;min-width:110px;border-top:3.5px solid var(--inf);">
      <div style="font-size:10px;font-weight:800;color:var(--mu);text-transform:uppercase;">Avg Attendance</div>
      <div style="font-size:22px;font-weight:800;color:var(--inf);">@(Model.Average(r=>(double)r.AttendancePct).ToString("0.0"))%</div>
    </div>
  </div>
}

<div class="card" style="padding:0;">
  <div class="tbl-wrap">
    <table id="reportTable">
      <thead>
        <tr>
          <th>#</th>
          <th>Student</th>
          <th>Class</th>
          <th style="text-align:center;">Total Days</th>
          <th style="text-align:center;">Present</th>
          <th style="text-align:center;">Absent</th>
          <th style="text-align:center;">Late</th>
          <th style="min-width:160px;">Attendance %</th>
        </tr>
      </thead>
      <tbody>
      @{ int rn = 0; }
      @foreach (var r in Model.OrderByDescending(x => x.AttendancePct))
      {
        rn++;
        var pct = (double)r.AttendancePct;
        var clr = pct >= 75 ? "var(--ok)" : pct >= 50 ? "var(--warn)" : "var(--err)";
        var barClr = pct >= 75 ? "#059669" : pct >= 50 ? "#d97706" : "#dc2626";
        <tr>
          <td class="text-mu fw7">@rn</td>
          <td>
            <div class="fw7">@r.FullName</div>
            <div style="font-size:11px;" class="text-mu">@r.AdmissionNo</div>
          </td>
          <td>@r.ClassName</td>
          <td style="text-align:center;font-weight:700;">@r.TotalDays</td>
          <td style="text-align:center;"><span class="badge b-present">@r.PresentDays</span></td>
          <td style="text-align:center;"><span class="badge b-absent">@r.AbsentDays</span></td>
          <td style="text-align:center;"><span class="badge b-late">@r.LateDays</span></td>
          <td>
            <div style="display:flex;align-items:center;gap:10px;">
              <div style="flex:1;height:7px;background:#f3f0ff;border-radius:4px;">
                <div style="height:7px;border-radius:4px;background:@barClr;width:@r.AttendancePct%;"></div>
              </div>
              <span style="font-size:13px;font-weight:800;color:@clr;min-width:42px;">@r.AttendancePct%</span>
            </div>
          </td>
        </tr>
      }
      </tbody>
    </table>
    @if (!hasData)
    {
      <div class="empty"><div class="empty-ico">📊</div><h3>No data available</h3><p>Select filters and click Filter.</p></div>
    }
  </div>
</div>

<style>
@@media print {
  .topbar, .sidebar, .filter-bar, .pg-hdr .df, .kpi-grid { display:none!important; }
  .main { margin:0!important; padding:10px!important; }
  table { font-size:10px; }
  .pg-hdr p { display:block!important; }
}
</style>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script>
// safe text helper — avoids ?. and ?? for broad browser support
function txt(el) { return el ? el.innerText.trim() : ''; }

// build row data from the table DOM
function buildRows() {
    var rows = [];
    var trs = document.querySelectorAll('#reportTable tbody tr');
    for (var i = 0; i < trs.length; i++) {
        var tds = trs[i].querySelectorAll('td');
        if (tds.length < 8) continue;
        var nameEl  = tds[1].querySelector('.fw7');
        var admEl   = tds[1].querySelector('.text-mu');
        var pctEl   = tds[7].querySelector('span');
        rows.push([
            txt(tds[0]),
            txt(nameEl),
            txt(admEl),
            txt(tds[2]),
            txt(tds[3]),
            txt(tds[4]),
            txt(tds[5]),
            txt(tds[6]),
            txt(pctEl)
        ]);
    }
    return rows;
}

// ── Excel ─────────────────────────────────────────────────────
function exportExcel() {
    if (typeof XLSX === 'undefined') { alert('Excel library not loaded. Check your internet connection.'); return; }
    var rows = buildRows();
    if (!rows.length) { alert('No data to export.'); return; }

    var header = ['#', 'Student', 'Admission No', 'Class', 'Total Days', 'Present', 'Absent', 'Late', 'Attendance %'];
    var ws = XLSX.utils.aoa_to_sheet([header].concat(rows));
    ws['!cols'] = [{wch:4},{wch:26},{wch:16},{wch:14},{wch:10},{wch:9},{wch:9},{wch:7},{wch:13}];

    var wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Attendance Report');
    XLSX.writeFile(wb, 'Attendance_Report_@(monthName)_@(curYear).xlsx');
}

// ── PDF ───────────────────────────────────────────────────────
function exportPDF() {
    if (!window.jspdf) { alert('PDF library not loaded. Check your internet connection.'); return; }
    var rows = buildRows();
    if (!rows.length) { alert('No data to export.'); return; }

    var doc = new window.jspdf.jsPDF({ orientation: 'portrait', unit: 'pt', format: 'a4' });
    var pageW = doc.internal.pageSize.getWidth();

    // header
    doc.setFontSize(13); doc.setFont('helvetica', 'bold');
    doc.text('RK Classes - Attendance Report', pageW / 2, 30, { align: 'center' });
    doc.setFontSize(9); doc.setFont('helvetica', 'normal');

    var clsSel = document.querySelector('select[name="classId"]');
    var clsName = clsSel ? clsSel.options[clsSel.selectedIndex].text : 'All Classes';
    doc.text('@monthName @(curYear)  |  ' + clsName, pageW / 2, 44, { align: 'center' });

    // body with colour coding on Att % column
    var body = rows.map(function(r) {
        return [r[0], r[1] + (r[2] ? '\n' + r[2] : ''), r[3], r[4], r[5], r[6], r[7], r[8]];
    });

    doc.autoTable({
        startY: 56,
        head: [['#', 'Student', 'Class', 'Days', 'Present', 'Absent', 'Late', 'Att %']],
        body: body,
        theme: 'grid',
        styles: { fontSize: 8, cellPadding: 3 },
        headStyles: { fillColor: [109, 40, 217], textColor: 255, fontStyle: 'bold' },
        columnStyles: {
            0: { cellWidth: 22, halign: 'center' },
            1: { cellWidth: 135 },
            2: { cellWidth: 58 },
            3: { cellWidth: 36, halign: 'center' },
            4: { cellWidth: 42, halign: 'center' },
            5: { cellWidth: 42, halign: 'center' },
            6: { cellWidth: 30, halign: 'center' },
            7: { cellWidth: 40, halign: 'center', fontStyle: 'bold' }
        },
        didParseCell: function(data) {
            if (data.section === 'body' && data.column.index === 7) {
                var pct = parseFloat(data.cell.raw);
                if (!isNaN(pct)) {
                    data.cell.styles.textColor = pct >= 75 ? [5, 150, 105] : pct >= 50 ? [217, 119, 6] : [220, 38, 38];
                }
            }
        }
    });

    // page numbers
    var total = doc.internal.getNumberOfPages();
    for (var p = 1; p <= total; p++) {
        doc.setPage(p);
        doc.setFontSize(8); doc.setTextColor(150);
        doc.text('Page ' + p + ' of ' + total, pageW - 20, doc.internal.pageSize.getHeight() - 10, { align: 'right' });
        doc.text('Generated: ' + new Date().toLocaleString(), 20, doc.internal.pageSize.getHeight() - 10);
    }

    doc.save('Attendance_Report_@(monthName)_@(curYear).pdf');
}
</script>
}
