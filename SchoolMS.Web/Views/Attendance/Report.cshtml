// Close dropdowns when clicking outside
document.addEventListener('click', () => {
  document.querySelectorAll('.contact-dropdown').forEach(el => {
    el.style.display = 'none';
  });
});

// safe text helper — avoids ?. and ?? for broad browser support
function txt(el) { return el ? el.innerText.trim() : ''; }

// build row data from the table DOM
function buildRows() {
    var rows = [];
    var trs = document.querySelectorAll('#reportTable tbody tr');
    for (var i = 0; i < trs.length; i++) {
        var tds = trs[i].querySelectorAll('td');
        if (tds.length < 8) continue;
        var nameEl  = tds[1].querySelector('.fw7');
        var admEl   = tds[1].querySelector('.text-mu');
        var pctEl   = tds[7].querySelector('span');
        rows.push([
            txt(tds[0]),
            txt(nameEl),
            txt(admEl),
            txt(tds[2]),
            txt(tds[3]),
            txt(tds[4]),
            txt(tds[5]),
            txt(tds[6]),
            txt(pctEl)
        ]);
    }
    return rows;
}

// ── Excel ─────────────────────────────────────────────────────
function exportExcel() {
    if (typeof XLSX === 'undefined') { alert('Excel library not loaded. Check your internet connection.'); return; }
    var rows = buildRows();
    if (!rows.length) { alert('No data to export.'); return; }

    var header = ['#', 'Student', 'Admission No', 'Class', 'Total Days', 'Present', 'Absent', 'Late', 'Attendance %'];
    var ws = XLSX.utils.aoa_to_sheet([header].concat(rows));
    ws['!cols'] = [{wch:4},{wch:26},{wch:16},{wch:14},{wch:10},{wch:9},{wch:9},{wch:7},{wch:13}];

    var wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Attendance Report');
    XLSX.writeFile(wb, 'Attendance_Report_@(monthName)_@(curYear).xlsx');
}

// ── PDF ───────────────────────────────────────────────────────
function exportPDF() {
    if (!window.jspdf) { alert('PDF library not loaded. Check your internet connection.'); return; }
    var rows = buildRows();
    if (!rows.length) { alert('No data to export.'); return; }

    var doc = new window.jspdf.jsPDF({ orientation: 'portrait', unit: 'pt', format: 'a4' });
    var pageW = doc.internal.pageSize.getWidth();

    // header
    doc.setFontSize(13); doc.setFont('helvetica', 'bold');
    doc.text('RK Classes - Attendance Report', pageW / 2, 30, { align: 'center' });
    doc.setFontSize(9); doc.setFont('helvetica', 'normal');

    var clsSel = document.querySelector('select[name="classId"]');
    var clsName = clsSel ? clsSel.options[clsSel.selectedIndex].text : 'All Std';
    doc.text('@monthName @(curYear)  |  ' + clsName, pageW / 2, 44, { align: 'center' });

    // body with colour coding on Att % column
    var body = rows.map(function(r) {
        return [r[0], r[1] + (r[2] ? '\n' + r[2] : ''), r[3], r[4], r[5], r[6], r[7], r[8]];
    });

    doc.autoTable({
        startY: 56,
        head: [['#', 'Student', 'Class', 'Days', 'Present', 'Absent', 'Late', 'Att %']],
        body: body,
        theme: 'grid',
        styles: { fontSize: 8, cellPadding: 3 },
        headStyles: { fillColor: [109, 40, 217], textColor: 255, fontStyle: 'bold' },
        columnStyles: {
            0: { cellWidth: 22, halign: 'center' },
            1: { cellWidth: 135 },
            2: { cellWidth: 58 },
            3: { cellWidth: 36, halign: 'center' },
            4: { cellWidth: 42, halign: 'center' },
            5: { cellWidth: 42, halign: 'center' },
            6: { cellWidth: 30, halign: 'center' },
            7: { cellWidth: 40, halign: 'center', fontStyle: 'bold' }
        },
        didParseCell: function(data) {
            if (data.section === 'body' && data.column.index === 7) {
                var pct = parseFloat(data.cell.raw);
                if (!isNaN(pct)) {
                    data.cell.styles.textColor = pct >= 75 ? [5, 150, 105] : pct >= 50 ? [217, 119, 6] : [220, 38, 38];
                }
            }
        }
    });

    // page numbers
    var total = doc.internal.getNumberOfPages();
    for (var p = 1; p <= total; p++) {
        doc.setPage(p);
        doc.setFontSize(8); doc.setTextColor(150);
        doc.text('Page ' + p + ' of ' + total, pageW - 20, doc.internal.pageSize.getHeight() - 10, { align: 'right' });
        doc.text('Generated: ' + new Date().toLocaleString(), 20, doc.internal.pageSize.getHeight() - 10);
    }

    doc.save('Attendance_Report_@(monthName)_@(curYear).pdf');
}
