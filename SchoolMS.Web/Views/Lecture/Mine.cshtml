@{
    ViewData["Title"] = "My Lectures";
    var linked = (bool)(ViewBag.Linked ?? false);
}

<style>
    .ml-kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-bottom:16px; }
    .ml-kpi { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:12px 14px; }
    .ml-kpi .v { font-size:22px; font-weight:800; }
    .ml-kpi .l { font-size:11px; text-transform:uppercase; letter-spacing:.5px; color:#6b7280; font-weight:700; }
    .ml-day { font-size:13px; font-weight:800; color:#1f2937; padding:10px 14px; background:#f3f4f6; border-top:1px solid #e5e7eb; }
    .ml-row { display:flex; gap:14px; align-items:center; padding:12px 14px; border-top:1px solid #f1f1f4; flex-wrap:wrap; }
    .ml-time { font-weight:800; color:#1e40af; min-width:110px; }
    .ml-badge { display:inline-block; padding:3px 10px; border-radius:12px; font-size:11px; font-weight:800; }
    .ml-badge.Scheduled { background:#dbeafe; color:#1e40af; } .ml-badge.Completed { background:#dcfce7; color:#166534; } .ml-badge.Cancelled { background:#fee2e2; color:#991b1b; }
    .ml-badge.NeedsUpdate { background:#fef3c7; color:#92400e; }
    .ml-month { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:16px; }
    .ml-pill { display:inline-block; background:#eef2ff; color:#3730a3; border-radius:14px; padding:3px 10px; font-size:12px; font-weight:700; margin:3px 6px 3px 0; }
</style>

<div class="pg-hdr">
    <div class="pg-row">
        <div><h1>🧑‍🏫 My Lectures</h1><p>Your upcoming lectures and how many you have taken</p></div>
    </div>
</div>

@if (!linked)
{
    <div class="card"><div class="empty"><div class="empty-ico">🔗</div><h3>Your login is not linked to a faculty profile yet</h3><p>Please ask the admin to link your account.</p></div></div>
}
else
{
    <div class="ml-kpis" id="months"></div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:10px;">
        <strong>Show lectures:</strong>
        <input type="date" id="fFrom" class="fc" style="width:160px;" /> <span>to</span> <input type="date" id="fTo" class="fc" style="width:160px;" />
        <button class="btn btn-primary btn-sm" onclick="load()">Show</button>
    </div>
    <div class="card" style="padding:0;overflow:hidden;" id="list"><div class="empty"><h3>Loading…</h3></div></div>
}

@section Scripts {
@if (linked)
{
<script>
const $ = id => document.getElementById(id);
const esc = t => String(t == null ? '' : t).replace(/[&<>"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));
const iso = d => d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
function fmtDate(s) { const [y,m,d] = s.split('-').map(Number); return new Date(y, m-1, d).toLocaleDateString('en-GB', { weekday:'long', day:'2-digit', month:'short', year:'numeric' }); }

function monthCard(m) {
  const t = m.totals;
  const groups = m.byGroup.filter(g => g.held + g.scheduled + g.cancelled > 0).map(g => `<span class="ml-pill">${esc(g.label)}: ${g.held}</span>`).join('');
  return `<div class="ml-month" style="grid-column:span 2;">
    <div style="font-weight:800;margin-bottom:8px;">${esc(m.label)}</div>
    <div style="display:flex;gap:18px;flex-wrap:wrap;">
      <div><div style="font-size:24px;font-weight:800;color:#16a34a;">${t.held}</div><div style="font-size:11px;color:#6b7280;font-weight:700;">HELD</div></div>
      <div><div style="font-size:24px;font-weight:800;color:#1e40af;">${t.scheduled}</div><div style="font-size:11px;color:#6b7280;font-weight:700;">SCHEDULED</div></div>
      <div><div style="font-size:24px;font-weight:800;color:#dc2626;">${t.cancelled}</div><div style="font-size:11px;color:#6b7280;font-weight:700;">CANCELLED</div></div>
      <div><div style="font-size:24px;font-weight:800;color:#7c3aed;">${t.hoursHeld}</div><div style="font-size:11px;color:#6b7280;font-weight:700;">HOURS</div></div>
    </div>
    ${groups ? `<div style="margin-top:10px;font-size:12px;color:#6b7280;font-weight:700;">Held per class</div><div>${groups}</div>` : ''}
  </div>`;
}

async function post(url, body) {
  const res = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
  try { return await res.json(); } catch { return { success:false, message:'Request failed.' }; }
}
async function setStatus(id, status) {
  const r = await post('/Lecture/SetStatus', { id, status });
  if (!r.success) alert(r.message); load();
}

async function load() {
  const p = new URLSearchParams(); if ($('fFrom').value) p.set('from', $('fFrom').value); if ($('fTo').value) p.set('to', $('fTo').value);
  const res = await fetch('/Lecture/MineJson?' + p.toString());
  const d = await res.json();
  if (!d.linked) { $('list').innerHTML = '<div class="empty"><h3>Not linked</h3></div>'; return; }
  $('fFrom').value = d.from; $('fTo').value = d.to;
  $('months').innerHTML = monthCard(d.thisMonth) + monthCard(d.lastMonth);
  if (!d.lectures.length) { $('list').innerHTML = '<div class="empty"><div class="empty-ico">📚</div><h3>No lectures in this period</h3></div>'; return; }
  let html = '', cur = '';
  d.lectures.forEach(l => {
    if (l.date !== cur) { cur = l.date; html += `<div class="ml-day">${fmtDate(l.date)}</div>`; }
    const badge = l.needsUpdate ? '<span class="ml-badge NeedsUpdate">Not updated</span>' : `<span class="ml-badge ${l.status}">${l.status}</span>`;
    const canMark = l.status === 'Scheduled' && l.date <= iso(new Date());
    html += `<div class="ml-row"><div class="ml-time">${l.startTime} – ${l.endTime}</div>
      <div style="flex:1;min-width:180px;"><strong>${esc(l.subject)}</strong> <span style="color:#6b7280;">· ${esc(l.groupLabel)}</span>${l.topic ? `<div style="font-size:11px;color:#6b7280;">${esc(l.topic)}</div>` : ''}</div>
      <div>${badge}</div>
      ${canMark ? `<button class="btn btn-success btn-sm" onclick="setStatus(${l.lectureId},'Completed')">✓ Mark done</button>` : ''}
      ${l.status === 'Completed' ? `<button class="btn btn-outline btn-sm" onclick="setStatus(${l.lectureId},'Scheduled')">Undo</button>` : ''}</div>`;
  });
  $('list').innerHTML = html;
}
load();
</script>
}
}
