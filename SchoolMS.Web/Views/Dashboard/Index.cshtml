@model SchoolMS.Domain.DashboardStats
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        padding-bottom: 80px;
    }

    .contact-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #f3f4f6;
        border-top: 1px solid #e5e7eb;
        padding: 9px 20px;
        box-shadow: none;
        z-index: 50;
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 11.5px;
        font-weight: 500;
        color: #555;
    }

        .contact-item i {
            color: #2563eb;
            font-size: 14px;
        }

    .contact-divider {
        color: #ddd;
        font-weight: 300;
    }

    @@media (max-width: 768px) {
        .pg-row {
            flex-direction: column !important;
            gap: 12px !important;
        }

            .pg-row > div:first-child {
                width: 100% !important;
            }

            .pg-row .df {
                width: 100% !important;
                flex-direction: column !important;
            }

                .pg-row .df .btn {
                    width: 100% !important;
                    padding: 10px 14px !important;
                }

        .kpi-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 12px !important;
        }

        .g2 {
            grid-template-columns: 1fr !important;
        }

        .contact-footer {
            padding: 8px 10px !important;
            gap: 10px !important;
        }

        .contact-item {
            font-size: 10px !important;
        }
    }

    @@media (max-width: 480px) {
        body {
            padding-bottom: 100px !important;
        }

        .kpi-grid {
            grid-template-columns: 1fr !important;
            gap: 10px !important;
        }

        .kpi-val {
            font-size: 20px !important;
        }

        .kpi-lbl {
            font-size: 10px !important;
        }

        .contact-footer {
            flex-direction: column !important;
            gap: 6px !important;
            padding: 6px 8px !important;
        }

        .contact-divider {
            display: none !important;
        }
    }
</style>

<div class="pg-hdr">
    <div class="pg-row">
        <div>
            <h1>📊 Dashboard</h1>
            <p>Good day, @Context.Session.GetString("FullName") — RK Classes — Academic Year @ViewBag.CurrentYearName</p>
        </div>
        <div class="df g8">
            <a href="/Student/Create" class="btn btn-primary"><i class="fas fa-user-plus"></i> New Student</a>
            <a href="/Fees/Collect" class="btn btn-outline"><i class="fas fa-rupee-sign"></i> Collect Fee</a>
        </div>
    </div>
</div>

@{
    var overallFees = (SchoolMS.Domain.OverallFeesSummary?)ViewBag.OverallFeesSummary ??
        new SchoolMS.Domain.OverallFeesSummary { TotalFeesOwed = 0, TotalCollected = 0, TotalDiscount = 0, Balance = 0 };
}
<div class="kpi-grid">
    <div class="kpi purple" onclick="location.href='/Student/Index'" style="cursor:pointer;">
        <div class="kpi-ico purple"><i class="fas fa-users"></i></div>
